<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="lore-design-docs" type="device" pages="11">
<diagram id="lore-v3-p1" name="1 · System Context"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1440" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1Sysc1" value="Lore — decision-provenance engine · SYSTEM CONTEXT" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="1Sysc2" value="Source of truth: docs/v3 (README, 01-overview, 02-architecture). Lore answers &lt;i&gt;why a decision was made&lt;/i&gt; and &lt;i&gt;what happened next&lt;/i&gt; from the decision trail across GitHub / Notion / Jira, with code as one optional anchor. Every answer is citation-grounded; sources are read-only; the index is derived, rebuildable data." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1220" height="52" as="geometry"/></mxCell><mxCell id="1Sysc3" value="CONSUMERS" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="300" height="760" as="geometry"/></mxCell><mxCell id="1Sysc4" value="DEVELOPER WORKSTATION — trust boundary (all state local)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="130" width="880" height="1250" as="geometry"/></mxCell><mxCell id="1Sysc5" value="EXTERNAL SYSTEMS — network egress, read-only" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1290" y="130" width="470" height="1000" as="geometry"/></mxCell><mxCell id="1Sysc6" value="&lt;b&gt;MCP host (AI harness)&lt;/b&gt;&lt;br&gt;Claude Code · Cursor · any MCP client&lt;br&gt;&lt;i&gt;client HAS a brain&lt;/i&gt;&lt;br&gt;• calls tools/call over stdio or Streamable HTTP&lt;br&gt;• receives &lt;b&gt;EvidenceBundle&lt;/b&gt; JSON, synthesizes itself&lt;br&gt;• default &lt;b&gt;synthesize=false&lt;/b&gt; (D1)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="260" height="140" as="geometry"/></mxCell><mxCell id="1Sysc7" value="&lt;b&gt;Human operator (terminal)&lt;/b&gt;&lt;br&gt;&lt;i&gt;client has NO brain&lt;/i&gt;&lt;br&gt;• lore init / source add / sync / status&lt;br&gt;• lore ask · why · trace · impact · history&lt;br&gt;• default &lt;b&gt;synthesize=true&lt;/b&gt; for ask/--explain&lt;br&gt;• --raw prints the bundle (JSON / pretty tree)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="260" height="140" as="geometry"/></mxCell><mxCell id="1Sysc8" value="&lt;b&gt;gRPC client · future web UI&lt;/b&gt;&lt;br&gt;&lt;i&gt;client has NO brain&lt;/i&gt;&lt;br&gt;• lore.v1 QueryService + SyncService&lt;br&gt;• mTLS (RequireAndVerifyClientCert)&lt;br&gt;• bundle &lt;b&gt;and&lt;/b&gt; optional synthesis text&lt;br&gt;• SyncService.Watch = streamed progress" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="260" height="140" as="geometry"/></mxCell><mxCell id="1Sysc9" value="&lt;b&gt;Layering rule (02)&lt;/b&gt;&lt;br&gt;No consumer and no transport ever touches&lt;br&gt;the store or a connector directly — every&lt;br&gt;call goes through the service layer,&lt;br&gt;including the MCP path." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="260" height="110" as="geometry"/></mxCell><mxCell id="1Sysc10" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color='#6c8ebf'&gt;▮&lt;/font&gt; transport / client surface&lt;br&gt;&lt;font color='#82b366'&gt;▮&lt;/font&gt; service (business logic)&lt;br&gt;&lt;font color='#d6b656'&gt;▮&lt;/font&gt; repository / storage&lt;br&gt;&lt;font color='#d79b00'&gt;▮&lt;/font&gt; connector (I/O adapter)&lt;br&gt;&lt;font color='#9673a6'&gt;▮&lt;/font&gt; external system&lt;br&gt;&lt;font color='#b85450'&gt;▮&lt;/font&gt; security / privacy note&lt;br&gt;dashed box = boundary, not a process" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="260" height="160" as="geometry"/></mxCell><mxCell id="1Sysc11" value="&lt;b&gt;Single Go binary  ·  &lt;font face='Courier New'&gt;lore&lt;/font&gt;  ·  pure-Go build (ncruces WASM SQLite, no cgo)  ·  Uber FX dependency injection&lt;/b&gt;&lt;br&gt;Subcommand selects the transport: &lt;font face='Courier New'&gt;lore mcp&lt;/font&gt; = MCP stdio · &lt;font face='Courier New'&gt;lore serve&lt;/font&gt; = MCP Streamable HTTP + gRPC · anything else = CLI" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="395" y="180" width="830" height="640" as="geometry"/></mxCell><mxCell id="1Sysc12" value="&lt;b&gt;MCP stdio&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore mcp&lt;/font&gt;&lt;br&gt;official Go MCP SDK&lt;br&gt;7 tools · readOnlyHint&lt;br&gt;except sync_now" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="415" y="250" width="190" height="120" as="geometry"/></mxCell><mxCell id="1Sysc13" value="&lt;b&gt;MCP Streamable HTTP&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore serve --http=:8080&lt;/font&gt;&lt;br&gt;endpoint &lt;font face='Courier New'&gt;/mcp&lt;/font&gt;&lt;br&gt;AI side, despite 'HTTP'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="615" y="250" width="200" height="120" as="geometry"/></mxCell><mxCell id="1Sysc14" value="&lt;b&gt;gRPC (+mTLS)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore serve --grpc=:9090&lt;/font&gt;&lt;br&gt;programmatic API, NOT&lt;br&gt;an MCP transport (D5)&lt;br&gt;non-loopback ⇒ TLS required" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="825" y="250" width="190" height="120" as="geometry"/></mxCell><mxCell id="1Sysc15" value="&lt;b&gt;CLI&lt;/b&gt;&lt;br&gt;cobra-style subcommands&lt;br&gt;pretty tree / timeline&lt;br&gt;exit codes + stderr" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1025" y="250" width="180" height="120" as="geometry"/></mxCell><mxCell id="1Sysc16" value="&lt;b&gt;QueryService&lt;/b&gt;&lt;br&gt;resolve anchor → seed → walk →&lt;br&gt;retrieve → rank → EvidenceBundle&lt;br&gt;4 seed modes, 5 verbs (D3)&lt;br&gt;all limits capped server-side" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="415" y="420" width="200" height="130" as="geometry"/></mxCell><mxCell id="1Sysc17" value="&lt;b&gt;SyncOrchestrator&lt;/b&gt;&lt;br&gt;scheduler tick + manual trigger&lt;br&gt;lease lock (heartbeat 15s, TTL 60s)&lt;br&gt;commit batch → persist cursor (D8)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="625" y="420" width="200" height="130" as="geometry"/></mxCell><mxCell id="1Sysc18" value="&lt;b&gt;LinkResolver&lt;/b&gt;&lt;br&gt;RawRef → typed Edge&lt;br&gt;confidence 1.0 … 0.7&lt;br&gt;pending_refs retried each round" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="835" y="420" width="180" height="130" as="geometry"/></mxCell><mxCell id="1Sysc19" value="&lt;b&gt;SynthesisService&lt;/b&gt;&lt;br&gt;non-AI surfaces only&lt;br&gt;evidence-grounded prompt&lt;br&gt;prose + [n] citations&lt;br&gt;optional — never for MCP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1025" y="420" width="180" height="130" as="geometry"/></mxCell><mxCell id="1Sysc20" value="&lt;b&gt;IndexStore (repository)&lt;/b&gt;&lt;br&gt;one interface, SQLite v1 impl · no SQL types leak out&lt;br&gt;batch upserts atomic internally · fusion happens in Go, not SQL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="415" y="600" width="390" height="100" as="geometry"/></mxCell><mxCell id="1Sysc21" value="&lt;b&gt;Connectors (adapters)&lt;/b&gt;&lt;br&gt;GitHub · Notion · Jira · GitRepo&lt;br&gt;Embedder · LLM — all optional per workspace" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="815" y="600" width="390" height="100" as="geometry"/></mxCell><mxCell id="1Sysc22" value="&lt;b&gt;&lt;font face='Courier New'&gt;~/.lore/&amp;lt;workspace&amp;gt;.db&lt;/font&gt;  (single SQLite file)&lt;/b&gt;&lt;br&gt;documents · chunks · chunks_fts (FTS5/BM25)&lt;br&gt;chunk_vectors (sqlite-vec) · edges · pending_refs&lt;br&gt;cursors · sync_lock · meta (schema ver + embedder identity)&lt;br&gt;offline-queryable after sync · portable · rebuildable cache" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="415" y="860" width="390" height="150" as="geometry"/></mxCell><mxCell id="1Sysc23" value="&lt;b&gt;Registered local git clones — OPTIONAL&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;repos:&lt;/font&gt; in lore.yaml · zero repos = ask-only workspace&lt;br&gt;&lt;font face='Courier New'&gt;git blame --porcelain&lt;/font&gt; → line attribution&lt;br&gt;&lt;font face='Courier New'&gt;git log --follow&lt;/font&gt; → rename-aware history&lt;br&gt;ground truth for &lt;font face='Courier New'&gt;why&lt;/font&gt; / &lt;font face='Courier New'&gt;history_of&lt;/font&gt;; absent ⇒ precondition error" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="815" y="860" width="390" height="150" as="geometry"/></mxCell><mxCell id="1Sysc24" value="&lt;b&gt;Secrets — env vars only (never in lore.yaml, index, or logs)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;LORE_GITHUB_TOKEN&lt;/font&gt; · &lt;font face='Courier New'&gt;LORE_NOTION_TOKEN&lt;/font&gt; · &lt;font face='Courier New'&gt;LORE_JIRA_EMAIL&lt;/font&gt; + &lt;font face='Courier New'&gt;LORE_JIRA_TOKEN&lt;/font&gt; · &lt;font face='Courier New'&gt;LORE_LLM_KEY&lt;/font&gt;&lt;br&gt;config stores env-var &lt;i&gt;names&lt;/i&gt;; load-time validation asserts each named var exists · least-privilege read scopes documented per source" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="415" y="1050" width="790" height="90" as="geometry"/></mxCell><mxCell id="1Sysc25" value="&lt;b&gt;&lt;font face='Courier New'&gt;lore.yaml&lt;/font&gt; — three independent axes (Δ9 + Δ19)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;plugins:&lt;/font&gt; external plugin binaries by coordinate, pinned in &lt;font face='Courier New'&gt;lore.lock&lt;/font&gt; (OPTIONAL)&lt;br&gt;&lt;font face='Courier New'&gt;sources:&lt;/font&gt; a list of instances, each &lt;font face='Courier New'&gt;id&lt;/font&gt; / &lt;font face='Courier New'&gt;use&lt;/font&gt; / &lt;font face='Courier New'&gt;with&lt;/font&gt;, so two Jira sites are expressible · what to INGEST, no clone needed&lt;br&gt;&lt;font face='Courier New'&gt;repos:&lt;/font&gt; local clones for blame/log ONLY · at least one of the two non-empty · unknown keys rejected" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="415" y="1160" width="790" height="90" as="geometry"/></mxCell><mxCell id="1Sysc26" value="&lt;b&gt;GitHub API&lt;/b&gt;&lt;br&gt;auth: fine-grained PAT (read)&lt;br&gt;GraphQL for backfill (fewer round-trips), REST where simpler&lt;br&gt;ingests: commits · PRs · pr_reviews · review_comments · issues · issue_comments&lt;br&gt;cursor: per-repo &lt;font face='Courier New'&gt;updated_at&lt;/font&gt; watermark · respects Retry-After + secondary limits" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1310" y="175" width="430" height="150" as="geometry"/></mxCell><mxCell id="1Sysc27" value="&lt;b&gt;Notion API&lt;/b&gt;&lt;br&gt;auth: integration token, scoped to &lt;font face='Courier New'&gt;root_pages&lt;/font&gt; subtrees&lt;br&gt;ingests: pages + blocks flattened to markdown-ish text&lt;br&gt;CreatedAt = &lt;font face='Courier New'&gt;created_time&lt;/font&gt; · cursor = &lt;font face='Courier New'&gt;last_edited_time&lt;/font&gt; search watermark" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1310" y="345" width="430" height="130" as="geometry"/></mxCell><mxCell id="1Sysc28" value="&lt;b&gt;Jira Cloud API&lt;/b&gt;&lt;br&gt;auth: email + API token (basic) · &lt;font face='Courier New'&gt;base_url&lt;/font&gt; per site&lt;br&gt;endpoint: &lt;b&gt;new&lt;/b&gt; &lt;font face='Courier New'&gt;/rest/api/3/search/jql&lt;/font&gt; + &lt;font face='Courier New'&gt;nextPageToken&lt;/font&gt; (legacy /search deprecated)&lt;br&gt;cursor: JQL &lt;font face='Courier New'&gt;updated &amp;gt;= watermark ORDER BY updated ASC&lt;/font&gt;&lt;br&gt;ingests: issues → ticket · comments → ticket_comment · ADF → plain text" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1310" y="495" width="430" height="150" as="geometry"/></mxCell><mxCell id="1Sysc29" value="&lt;b&gt;Embedder provider&lt;/b&gt;&lt;br&gt;default &lt;b&gt;OpenAI&lt;/b&gt; &lt;font face='Courier New'&gt;text-embedding-3-small&lt;/font&gt; (1536d, from the&lt;br&gt;driver's own &lt;font face='Courier New'&gt;modelDims&lt;/font&gt;) or &lt;b&gt;Ollama&lt;/b&gt; → fully local pipeline,&lt;br&gt;where &lt;font face='Courier New'&gt;embedder.dimensions&lt;/font&gt; is required because the model&lt;br&gt;implies no width. The plugin reports &lt;font face='Courier New'&gt;Dimensions()&lt;/font&gt;; the host&lt;br&gt;composes &lt;font face='Courier New'&gt;provider/model/dims&lt;/font&gt; (NewVectorSpace) and pins it in&lt;br&gt;&lt;font face='Courier New'&gt;meta&lt;/font&gt;. A mismatch fails the sync round with an explicit&lt;br&gt;&lt;font face='Courier New'&gt;lore sync --reembed&lt;/font&gt; error (reconcileIdentity)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1310" y="665" width="430" height="140" as="geometry"/></mxCell><mxCell id="1Sysc30" value="&lt;b&gt;LLM provider (OPTIONAL)&lt;/b&gt;&lt;br&gt;OpenAI · Anthropic · Z.AI · Ollama&lt;br&gt;used ONLY by SynthesisService for CLI/gRPC&lt;br&gt;MCP needs &lt;b&gt;zero&lt;/b&gt; LLM key on the server (D1)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1310" y="825" width="430" height="120" as="geometry"/></mxCell><mxCell id="1Sysc31" value="&lt;b&gt;Privacy / posture&lt;/b&gt;&lt;br&gt;• Lore is &lt;b&gt;read-only&lt;/b&gt; toward every source — it never writes to GitHub, Notion, or Jira&lt;br&gt;• Private text leaves the machine only toward the configured embedder / LLM — documented loudly&lt;br&gt;• Ollama for both ⇒ nothing leaves the machine" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1310" y="965" width="430" height="140" as="geometry"/></mxCell><mxCell id="1Sysc81" value="&lt;b&gt;Call semantics (edge labels omitted for clarity)&lt;/b&gt;&lt;br&gt;• every transport → service call is the same request type; the only difference is the &lt;font face='Courier New'&gt;synthesize&lt;/font&gt; flag (D2): MCP false, CLI/gRPC true&lt;br&gt;• sync verbs: &lt;font face='Courier New'&gt;lore sync&lt;/font&gt; (CLI) · &lt;font face='Courier New'&gt;sync_now&lt;/font&gt; / &lt;font face='Courier New'&gt;sync_status&lt;/font&gt; (MCP) · &lt;font face='Courier New'&gt;SyncService.Trigger&lt;/font&gt; / &lt;font face='Courier New'&gt;Status&lt;/font&gt; / &lt;font face='Courier New'&gt;Watch&lt;/font&gt; (gRPC) — all land on SyncOrchestrator&lt;br&gt;• dashed = optional path (sync, synthesis, network egress) · solid = the always-on query path" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="415" y="1270" width="790" height="100" as="geometry"/></mxCell><mxCell id="1Syse82" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc6" target="1Sysc12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse83" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc7" target="1Sysc15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="400"/><mxPoint x="1250" y="310"/></Array></mxGeometry></mxCell><mxCell id="1Syse84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc8" target="1Sysc14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="560"/><mxPoint x="380" y="235"/><mxPoint x="880" y="235"/></Array></mxGeometry></mxCell><mxCell id="1Syse85" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc12" target="1Sysc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc13" target="1Sysc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse87" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc14" target="1Sysc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc15" target="1Sysc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc12" target="1Sysc17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc15" target="1Sysc17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse91" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc15" target="1Sysc19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse92" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc14" target="1Sysc19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse93" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc16" target="1Sysc20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse94" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.08;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc16" target="1Sysc21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse95" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc17" target="1Sysc20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse96" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc17" target="1Sysc21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse97" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc18" target="1Sysc20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse98" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc19" target="1Sysc21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse99" value="SQL · FTS5 · vec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc20" target="1Sysc22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse100" value="git shell-out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc21" target="1Sysc23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse101" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=1;exitY=0.12;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc21" target="1Sysc26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse102" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=1;exitY=0.28;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc21" target="1Sysc27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse103" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=1;exitY=0.44;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc21" target="1Sysc28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse104" value="embed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=1;exitY=0.66;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc21" target="1Sysc29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse105" value="chat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=1;exitY=0.86;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc21" target="1Sysc30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p2" name="2 · Problem &amp; Personas"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2260" pageHeight="1340" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2Proc1" value="PROBLEM, CONCEPT &amp; PERSONAS — what Lore is for, and why the shape follows" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="36" as="geometry"/></mxCell><mxCell id="2Proc2" value="docs/v3/01-overview.md. Codebase RAG tools answer &lt;i&gt;what&lt;/i&gt; code is. Lore answers &lt;i&gt;why decisions were made and what happened next&lt;/i&gt; — whether or not the question touches code at all." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1700" height="40" as="geometry"/></mxCell><mxCell id="2Proc3" value="&lt;b&gt;The problem — teams lose their &lt;i&gt;why&lt;/i&gt;&lt;/b&gt;&lt;br&gt;Decisions are made in incident channels, Jira tickets, Notion pages, PR&lt;br&gt;reviews. Then people rotate, context scatters, and six months later nobody&lt;br&gt;can answer:&lt;br&gt;&lt;br&gt;• Why did we choose option B instead of A when incident X happened?&lt;br&gt;• At the moment of X, why did we do A — and what impact did we get?&lt;br&gt;• Why does this function have a weird retry with a 250ms sleep?&lt;br&gt;• Who added this check, what bug forced it, and is it still needed?&lt;br&gt;• Which repos and services were affected by decision X?&lt;br&gt;&lt;br&gt;The answers exist — scattered across tickets, design docs, postmortems, PR&lt;br&gt;descriptions, review threads, commit messages. Nobody reads that trail&lt;br&gt;manually. &lt;b&gt;No single source is sufficient&lt;/b&gt;: a commit that says only&lt;br&gt;&lt;font face='Courier New'&gt;JIRA-4521&lt;/font&gt; carries no reasoning; the reasoning lives in the ticket; the&lt;br&gt;&lt;i&gt;consequences&lt;/i&gt; live in documents written weeks later." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="660" height="280" as="geometry"/></mxCell><mxCell id="2Proc4" value="&lt;b&gt;1 · Ingest&lt;/b&gt;&lt;br&gt;documents from configured sources (GitHub, Notion, Jira in v1) into a&lt;br&gt;normalized store. Sources are independent; &lt;b&gt;any subset works&lt;/b&gt;, including&lt;br&gt;workspaces with no repository at all." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="660" height="90" as="geometry"/></mxCell><mxCell id="2Proc5" value="&lt;b&gt;2 · Resolve&lt;/b&gt;&lt;br&gt;cross-source references (ticket keys, URLs, SHAs, file paths) into a typed&lt;br&gt;&lt;b&gt;edge graph&lt;/b&gt;: ticket → design doc → PR → review thread → commit, in any&lt;br&gt;direction the links actually exist." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="660" height="90" as="geometry"/></mxCell><mxCell id="2Proc6" value="&lt;b&gt;3 · Answer&lt;/b&gt;&lt;br&gt;provenance questions through &lt;b&gt;one query pipeline&lt;/b&gt; that combines graph walks&lt;br&gt;with hybrid semantic retrieval (BM25 + vectors) and time anchoring ('when&lt;br&gt;incident X happened'), returning an &lt;b&gt;EvidenceBundle&lt;/b&gt; where every claim&lt;br&gt;carries a source URL." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="660" height="100" as="geometry"/></mxCell><mxCell id="2Proe7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="2Proc4" target="2Proc5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Proe8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="2Proc5" target="2Proc6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Proc9" value="&lt;b&gt;Honesty is a feature&lt;/b&gt;&lt;br&gt;When the trail ends, Lore says so — 'trail ends at PROJ-4521; no linked follow-up' — instead of fabricating. Every tool reports &lt;font face='Courier New'&gt;Gaps&lt;/font&gt;." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="660" height="80" as="geometry"/></mxCell><mxCell id="2Proc10" value="&lt;b&gt;Name&lt;/b&gt;&lt;br&gt;Working name &lt;font face='Courier New'&gt;lore&lt;/font&gt; — short, meaningful ('accumulated tribal knowledge'), good CLI ergonomics (&lt;font face='Courier New'&gt;lore ask&lt;/font&gt;, &lt;font face='Courier New'&gt;lore why&lt;/font&gt;, &lt;font face='Courier New'&gt;lore impact&lt;/font&gt;).&lt;br&gt;Check GitHub + package registries for collisions before first public release." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="866" width="660" height="90" as="geometry"/></mxCell><mxCell id="2Proc11" value="TWO PERSONAS, ONE ENGINE" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="760" y="112" width="700" height="26" as="geometry"/></mxCell><mxCell id="2Proc12" value="Ask-only workspace (no repos)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="760" y="146" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc13" value="Code-anchored workspace" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1130" y="146" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc14" value="sources: Jira + Notion (± GitHub issues/PRs)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="760" y="186" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc15" value="the same, plus local clones registered" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1130" y="186" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc16" value="'Why B over A during incident X?' → &lt;font face='Courier New'&gt;find_decision&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="760" y="226" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc17" value="'Why does auth.go:40-55 exist?' → &lt;font face='Courier New'&gt;why&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1130" y="226" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc18" value="'What impact did decision A have?' → &lt;font face='Courier New'&gt;impact_of&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="760" y="266" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc19" value="'How did this file evolve?' → &lt;font face='Courier New'&gt;history_of&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1130" y="266" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc20" value="anchors: query, document, time window" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="760" y="306" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc21" value="additional anchor: code span (blame)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1130" y="306" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc22" value="&lt;b&gt;Nothing in the first column is degraded&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;find_decision&lt;/font&gt;, &lt;font face='Courier New'&gt;trace&lt;/font&gt;, and &lt;font face='Courier New'&gt;impact_of&lt;/font&gt; run the full walk with chains and gaps.&lt;br&gt;The second column is the first column &lt;b&gt;plus one extra anchor type&lt;/b&gt; (Δ1–Δ3)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="760" y="356" width="740" height="80" as="geometry"/></mxCell><mxCell id="2Proc23" value="ANCHOR UNION — &lt;font face='Courier New'&gt;EvidenceBundle.Anchor&lt;/font&gt; (Δ7)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="760" y="456" width="700" height="26" as="geometry"/></mxCell><mxCell id="2Proc24" value="&lt;b&gt;query&lt;/b&gt;&lt;br&gt;free-text question&lt;br&gt;&lt;font face='Courier New'&gt;find_decision&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="492" width="170" height="70" as="geometry"/></mxCell><mxCell id="2Proc25" value="&lt;b&gt;document&lt;/b&gt;&lt;br&gt;resolved ref&lt;br&gt;&lt;font face='Courier New'&gt;trace&lt;/font&gt; · &lt;font face='Courier New'&gt;impact_of&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="950" y="492" width="170" height="70" as="geometry"/></mxCell><mxCell id="2Proc26" value="&lt;b&gt;time_window&lt;/b&gt;&lt;br&gt;event resolution&lt;br&gt;combines with query/doc" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1140" y="492" width="180" height="70" as="geometry"/></mxCell><mxCell id="2Proc27" value="&lt;b&gt;code_span&lt;/b&gt;&lt;br&gt;blame — OPTIONAL&lt;br&gt;&lt;font face='Courier New'&gt;why&lt;/font&gt; · &lt;font face='Courier New'&gt;history_of&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1340" y="492" width="160" height="70" as="geometry"/></mxCell><mxCell id="2Proc28" value="&lt;b&gt;one typed union, not a code-shaped struct&lt;/b&gt;&lt;br&gt;generalizing later would have broken the bundle contract on every surface" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="590" width="740" height="60" as="geometry"/></mxCell><mxCell id="2Proe29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Proc24" target="2Proc28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Proe30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Proc25" target="2Proc28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Proe31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Proc26" target="2Proc28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Proe32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Proc27" target="2Proc28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Proc33" value="GOALS" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="760" y="680" width="700" height="26" as="geometry"/></mxCell><mxCell id="2Proc34" value="• answer 'why was this decided' and 'what impact did it have' with cited, verifiable evidence — with or without a codebase&lt;br&gt;• treat every source as an optional connector; Jira-only, Notion-only, GitHub-only, and any combination fully supported&lt;br&gt;• keep code provenance excellent: &lt;font face='Courier New'&gt;git blame&lt;/font&gt; anchoring, rename-aware history, commit → PR → review → issue chains&lt;br&gt;• be useful from an AI agent (MCP), a terminal (CLI), and programmatically (gRPC, future web UI)&lt;br&gt;• local-first: index in a single SQLite file; private credentials never leave the machine; fully-local mode via Ollama&lt;br&gt;• ship as a single &lt;b&gt;pure-Go&lt;/b&gt; binary (no cgo in the default build)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="714" width="740" height="170" as="geometry"/></mxCell><mxCell id="2Proc35" value="DIFFERENTIATORS" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1540" y="112" width="660" height="26" as="geometry"/></mxCell><mxCell id="2Proc36" value="Typical codebase RAG" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1540" y="146" width="320" height="26" as="geometry"/></mxCell><mxCell id="2Proc37" value="Lore" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1860" y="146" width="340" height="26" as="geometry"/></mxCell><mxCell id="2Proc38" value="indexes code (the &lt;i&gt;what&lt;/i&gt;)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1540" y="172" width="320" height="46" as="geometry"/></mxCell><mxCell id="2Proc39" value="indexes decisions (the &lt;i&gt;why&lt;/i&gt; and the &lt;i&gt;what happened next&lt;/i&gt;)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1860" y="172" width="340" height="46" as="geometry"/></mxCell><mxCell id="2Proc40" value="requires a repository" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1540" y="218" width="320" height="46" as="geometry"/></mxCell><mxCell id="2Proc41" value="repository optional; Jira/Notion-only workspaces are first-class" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1860" y="218" width="340" height="46" as="geometry"/></mxCell><mxCell id="2Proc42" value="single repo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1540" y="264" width="320" height="32" as="geometry"/></mxCell><mxCell id="2Proc43" value="multi-repo, multi-source workspace; cross-source edges" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1860" y="264" width="340" height="32" as="geometry"/></mxCell><mxCell id="2Proc44" value="returns similar chunks" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1540" y="296" width="320" height="52" as="geometry"/></mxCell><mxCell id="2Proc45" value="returns a cited provenance &lt;i&gt;chain&lt;/i&gt; (graph walk + retrieval + time anchor)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1860" y="296" width="340" height="52" as="geometry"/></mxCell><mxCell id="2Proc46" value="no temporal reasoning" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1540" y="348" width="320" height="52" as="geometry"/></mxCell><mxCell id="2Proc47" value="event resolution ('when incident X happened') and forward-in-time impact tracing" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1860" y="348" width="340" height="52" as="geometry"/></mxCell><mxCell id="2Proc48" value="server synthesizes prose with its own LLM" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1540" y="400" width="320" height="60" as="geometry"/></mxCell><mxCell id="2Proc49" value="MCP returns structured evidence; the calling agent synthesizes. No LLM key needed on the server" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1860" y="400" width="340" height="60" as="geometry"/></mxCell><mxCell id="2Proc50" value="&lt;b&gt;Landscape — why this niche is open&lt;/b&gt;&lt;br&gt;Saturated: 'index codebase → vector DB → semantic search' MCP servers —&lt;br&gt;project-rag · code-graph-rag · claude-context · codebase-memory-mcp.&lt;br&gt;All index the &lt;i&gt;what&lt;/i&gt;; all require code.&lt;br&gt;&lt;b&gt;Not covered by any of them&lt;/b&gt;: cross-source decision provenance with&lt;br&gt;citation-grounded evidence, temporal anchoring, and impact tracing." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1540" y="470" width="660" height="130" as="geometry"/></mxCell><mxCell id="2Proc51" value="&lt;b&gt;Locked decisions (README)&lt;/b&gt;&lt;br&gt;• Go, layered architecture, Uber FX for DI&lt;br&gt;• single SQLite file per workspace (FTS5 + sqlite-vec, RRF in Go); default build pure Go via ncruces WASM bindings&lt;br&gt;• transports: MCP stdio, MCP Streamable HTTP, gRPC + mTLS, CLI — gRPC is the programmatic API, not an MCP transport&lt;br&gt;• one pipeline, four seed modes; every tool returns the same EvidenceBundle with Chains and Gaps&lt;br&gt;• v1 connectors GitHub + Notion + Jira; contract keeps GitLab / Confluence / ClickUp / Slack drop-in; every connector and the repo list itself optional&lt;br&gt;• embeddings pluggable, cloud default (OpenAI), Ollama for fully-local&lt;br&gt;• LLM synthesis pluggable and optional — MCP never requires an LLM key on the server&lt;br&gt;• sync: background scheduler + manual trigger sharing a lease lock; checkpointable batches resume mid-source&lt;br&gt;• five narrow MCP verbs over one stable bundle; tools deprecate in place, the bundle changes additively&lt;br&gt;• plugin ecosystem deferred; the connector seam stays plugin-ready via three disciplines" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1540" y="620" width="660" height="264" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p3" name="3 · Layered Architecture"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2Layc1" value="LAYERED ARCHITECTURE — transport → service → repository/connector (strictly one-directional, wired with Uber FX)" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="36" as="geometry"/></mxCell><mxCell id="2Layc2" value="docs/v3/02-architecture.md. Dependency arrows point downward only. Nothing in a lower band knows the band above it; the EvidenceBundle is the single artifact that crosses layers outward." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1500" height="40" as="geometry"/></mxCell><mxCell id="2Layc3" value="TRANSPORT LAYER — protocol parsing, schema validation, error mapping. No store access, no connector access, no business logic." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1560" height="300" as="geometry"/></mxCell><mxCell id="2Layc4" value="SERVICE LAYER — all business logic, orchestration, validation, classification of errors." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1560" height="380" as="geometry"/></mxCell><mxCell id="2Layc5" value="REPOSITORY / CONNECTOR LAYER — pure I/O adapters. Repository talks only to the DB; connectors talk only to their API. Zero business logic." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1560" height="360" as="geometry"/></mxCell><mxCell id="2Layc6" value="&lt;b&gt;mcp — stdio&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore mcp&lt;/font&gt; · official Go MCP SDK&lt;br&gt;registers 7 tools with JSON schemas +&lt;br&gt;routing hints in descriptions&lt;br&gt;returns &lt;b&gt;EvidenceBundle JSON&lt;/b&gt;, never prose&lt;br&gt;error ⇒ MCP tool error result&lt;br&gt;deprecation in place: old tool keeps its&lt;br&gt;registration with 'deprecated — use X'&lt;br&gt;for one release (D9)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="360" height="210" as="geometry"/></mxCell><mxCell id="2Layc7" value="&lt;b&gt;mcp — Streamable HTTP&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore serve --http=:8080&lt;/font&gt; → &lt;font face='Courier New'&gt;/mcp&lt;/font&gt;&lt;br&gt;same tool set, same handlers as stdio&lt;br&gt;AI-side surface despite the word HTTP&lt;br&gt;off-loopback bind without TLS is rejected&lt;br&gt;at startup" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="190" width="360" height="210" as="geometry"/></mxCell><mxCell id="2Layc8" value="&lt;b&gt;grpc — controllers + mTLS&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore serve --grpc=:9090 [--mtls]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore.v1.QueryService&lt;/font&gt; (5 unary RPCs)&lt;br&gt;&lt;font face='Courier New'&gt;lore.v1.SyncService&lt;/font&gt; Trigger/Status/Watch&lt;br&gt;&lt;font face='Courier New'&gt;Watch&lt;/font&gt; = server-streaming SyncEvent&lt;br&gt;error ⇒ gRPC status code&lt;br&gt;TLS RequireAndVerifyClientCert vs client CA" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="190" width="360" height="210" as="geometry"/></mxCell><mxCell id="2Layc9" value="&lt;b&gt;cli — commands&lt;/b&gt;&lt;br&gt;flag parsing, workspace resolution&lt;br&gt;pretty-printers: provenance tree, impact&lt;br&gt;timeline, sync status table&lt;br&gt;&lt;font face='Courier New'&gt;--raw&lt;/font&gt; ⇒ bundle as JSON (scripting)&lt;br&gt;error ⇒ exit code + stderr" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1200" y="190" width="380" height="210" as="geometry"/></mxCell><mxCell id="2Layc10" value="&lt;b&gt;QueryService&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;FindDecision(q, around?, filters?)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Why(repo, file, l1, l2, q?)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Trace(ref, dir?, depth?)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;ImpactOf(refOrQuery, q?)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;HistoryOf(path, repo?, limit, before)&lt;/font&gt;&lt;br&gt;one pipeline · four seed modes · every verb&lt;br&gt;fills Chains + Gaps&lt;br&gt;validates: workspace initialized, repo required&lt;br&gt;only for why/history_of, ref resolves to exactly&lt;br&gt;one doc, all limits capped" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="360" height="300" as="geometry"/></mxCell><mxCell id="2Layc11" value="&lt;b&gt;SyncOrchestrator&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;RunRound(ctx, source?)&lt;/font&gt; · scheduler goroutine&lt;br&gt;ticks every &lt;font face='Courier New'&gt;scheduler.interval&lt;/font&gt; (30m)&lt;br&gt;manual trigger acquires the lease or errors&lt;br&gt;verbosely; scheduler &lt;b&gt;skips&lt;/b&gt; its round when&lt;br&gt;the lease is held&lt;br&gt;per connector: cursor → stream batches →&lt;br&gt;upsert → chunk → embed → refs → commit →&lt;br&gt;&lt;b&gt;persist batch.Cursor&lt;/b&gt; (D8)&lt;br&gt;then one LinkResolver pass" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="510" width="360" height="300" as="geometry"/></mxCell><mxCell id="2Layc12" value="&lt;b&gt;LinkResolver&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;ResolvePass(ctx)&lt;/font&gt;&lt;br&gt;reads &lt;font face='Courier New'&gt;pending_refs&lt;/font&gt; + refs from this round&lt;br&gt;matches by URL / ticket key / SHA prefix /&lt;br&gt;file path via indexed columns (no scans)&lt;br&gt;writes typed edges, INSERT OR IGNORE&lt;br&gt;Src = body that contains the ref,&lt;br&gt;Dst = referenced doc — direction is known,&lt;br&gt;never guessed" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="820" y="510" width="360" height="300" as="geometry"/></mxCell><mxCell id="2Layc13" value="&lt;b&gt;SynthesisService&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Synthesize(bundle, question) (string, error)&lt;/font&gt;&lt;br&gt;system prompt: answer ONLY from evidence,&lt;br&gt;cite node URL per claim, state gaps, respect&lt;br&gt;timeline ordering for impact answers&lt;br&gt;output: markdown + inline [n] citations +&lt;br&gt;source list&lt;br&gt;missing llm config ⇒ clear error naming the&lt;br&gt;remedy; MCP unaffected (never calls it)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1200" y="510" width="380" height="300" as="geometry"/></mxCell><mxCell id="2Layc14" value="&lt;b&gt;IndexStore (repository interface)&lt;/b&gt;&lt;br&gt;UpsertDocuments · ReplaceChunks&lt;br&gt;SearchLexical · SearchVector  (two ranked lists;&lt;br&gt;  RRF fusion stays in the service layer)&lt;br&gt;ResolveRef → []DocumentMeta (all candidates)&lt;br&gt;UpsertEdges · Neighbors(ids, kinds, dir)&lt;br&gt;Cursor / SetCursor · PendingRefs&lt;br&gt;TryAcquireLease · HeartbeatLease · ReleaseLease&lt;br&gt;Meta / SetMeta&lt;br&gt;impl: SQLite via ncruces/go-sqlite3 (WASM) +&lt;br&gt;sqlite-vec ncruces bindings — cgo pairing is a&lt;br&gt;drop-in alternative behind the same interface" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="920" width="400" height="280" as="geometry"/></mxCell><mxCell id="2Layc15" value="&lt;b&gt;Connector (one interface, one instance per source)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Name() string&lt;/font&gt;  // the instance id&lt;br&gt;&lt;font face='Courier New'&gt;Changes(ctx, Cursor) iter.Seq2[Batch, error]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Batch{ Docs []Document; Cursor Cursor }&lt;/font&gt;&lt;br&gt;official source plugins: &lt;b&gt;github&lt;/b&gt; · &lt;b&gt;gitlab&lt;/b&gt; · &lt;b&gt;jira&lt;/b&gt; · &lt;b&gt;notion&lt;/b&gt;&lt;br&gt;future: confluence · clickup · slack, or a third-party binary&lt;br&gt;rules: read-only · no business logic ·&lt;br&gt;imports sdk, a sibling plugin and stdlib only (depguard) ·&lt;br&gt;both timestamps set · resumable + idempotent by DocID ·&lt;br&gt;an error ends the stream · &lt;font face='Courier New'&gt;sdk/conform&lt;/font&gt; tested" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480" y="920" width="380" height="280" as="geometry"/></mxCell><mxCell id="2Layc16" value="&lt;b&gt;GitRepo (not a Connector)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Blame(ctx, path, l1, l2) []BlameSpan&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Log(ctx, path) []CommitRef&lt;/font&gt;&lt;br&gt;shells out to &lt;font face='Courier New'&gt;git&lt;/font&gt; (blame --porcelain,&lt;br&gt;log --follow) — zero deps&lt;br&gt;constructed only when &lt;font face='Courier New'&gt;repos:&lt;/font&gt; is non-empty" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="880" y="920" width="340" height="280" as="geometry"/></mxCell><mxCell id="2Layc17" value="&lt;b&gt;Embedder / Completer (&lt;font face='Courier New'&gt;KindProvider&lt;/font&gt;)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Embed(ctx, texts) [][]float32&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Dimensions() int&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Complete(ctx, system, user) string&lt;/font&gt;&lt;br&gt;provider plugins: openai · anthropic · ollama ·&lt;br&gt;openai-compatible (preset rows for Z.AI, OpenRouter, …)&lt;br&gt;&lt;font face='Courier New'&gt;embedder:&lt;/font&gt; and &lt;font face='Courier New'&gt;llm:&lt;/font&gt; are role bindings naming a&lt;br&gt;provider instance and a model. The host composes the&lt;br&gt;identity &lt;font face='Courier New'&gt;&amp;lt;plugin&amp;gt;/&amp;lt;model&amp;gt;/&amp;lt;dims&amp;gt;&lt;/font&gt; (NewVectorSpace)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1240" y="920" width="340" height="280" as="geometry"/></mxCell><mxCell id="2Layc18" value="&lt;b&gt;EvidenceBundle — THE stability boundary (D9)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Question · Anchor · Nodes[] · Chains[][] · Gaps[]&lt;/font&gt;&lt;br&gt;consumed by every surface ⇒ changes are additive only.&lt;br&gt;Produced by QueryService · returned as-is on MCP · the input SynthesisService turns into cited prose. Tools are disposable verbs over it." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="510" width="540" height="130" as="geometry"/></mxCell><mxCell id="2Layc19" value="&lt;b&gt;Layering rules — no exceptions&lt;/b&gt;&lt;br&gt;1. Transport calls &lt;b&gt;only&lt;/b&gt; services. The MCP path is not special: the harness AI drives the tool loop, every tool call still goes through a service.&lt;br&gt;2. Services orchestrate repositories + connectors and own all logic and validation.&lt;br&gt;3. IndexStore talks only to SQLite, plugins only to their external API or local clone. Neither classifies errors.&lt;br&gt;4. &lt;b&gt;Plugins never reach upward.&lt;/b&gt; A plugin is given configuration, secrets and a small host and returns data. &lt;font face='Courier New'&gt;plugins/**&lt;/font&gt; imports &lt;font face='Courier New'&gt;sdk/**&lt;/font&gt;, a sibling plugin and stdlib only, and &lt;font face='Courier New'&gt;internal/**&lt;/font&gt; never imports &lt;font face='Courier New'&gt;plugins/**&lt;/font&gt; (depguard)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1620" y="120" width="540" height="260" as="geometry"/></mxCell><mxCell id="2Layc20" value="&lt;b&gt;Error handling — &lt;font face='Courier New'&gt;internalerror&lt;/font&gt; package&lt;/b&gt;&lt;br&gt;constructors: NewBadRequestError · NewNotFoundError · NewPreconditionError · NewInternalError · …&lt;br&gt;• connectors / repository: raw errors with context wrapping, no classification&lt;br&gt;• services: classify. Notable preconditions —&lt;br&gt;   'no repositories registered — code anchoring disabled for this workspace' (why / history_of)&lt;br&gt;   'embedder identity mismatch — run lore sync --reembed'&lt;br&gt;   'sync lease held by &amp;lt;holder&amp;gt;' (manual trigger)&lt;br&gt;   'ambiguous ref — candidates: …' (trace / impact_of)&lt;br&gt;• transports: map to protocol-native form (MCP tool error · gRPC status · CLI exit code + stderr)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1620" y="660" width="540" height="210" as="geometry"/></mxCell><mxCell id="2Layc21" value="&lt;b&gt;Testing strategy (per layer)&lt;/b&gt;&lt;br&gt;services — gomock for IndexStore + every connector; table-driven tests for graph walk, event resolution, impact windowing, ranking (pure functions where possible)&lt;br&gt;repository — integration tests against a temp SQLite file&lt;br&gt;connectors — httptest servers replaying recorded GitHub/Notion/Jira fixtures; retry, pagination, batch-checkpoint covered explicitly; plus the shared conformance suite&lt;br&gt;transports — mocked services; assert request parsing + error mapping&lt;br&gt;e2e ask-only — fixture Jira + Notion servers, zero repos: sync → find_decision / impact_of; assert citation chain + chronological timeline&lt;br&gt;e2e code-anchored — fixture git repo + fixture API server: sync → why; assert the blame-seeded chain" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1620" y="890" width="540" height="260" as="geometry"/></mxCell><mxCell id="2Layc22" value="&lt;b&gt;Project structure (docs/v3/02-architecture.md)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;cmd/lore/              composition root: names the plugins this binary ships&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;app/                   composable wiring (FX + cobra), takes []lore.Plugin&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;sdk/                   package lore, the public plugin contract, stdlib only&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;├── httpx/             retrying HTTP client&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;├── refs/              reference scanning helpers&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;├── wire/              the NDJSON frame types host and plugin share&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;├── stdio/             Serve, the plugin's side of the protocol&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;└── conform/           conformance / certification suite&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;plugins/               official plugins, no privilege a third party lacks&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;├── sources/{github,gitlab,notion,jira}/&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;├── providers/{openai,anthropic,ollama,compat}/&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;└── code/git/          local-clone blame/log&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;internal/&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;├── transport/{mcp,grpc,cli}/&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;├── services/          Query, Synthesis, SyncOrchestrator, LinkResolver&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;├── repositories/      IndexStore (SQLite via ncruces/go-sqlite3)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;├── registry/          registration, manifest validation, instances&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;├── plugexec/          out-of-process plugin host (09)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;├── plugindist/        fetch, verify and cache external binaries (10)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;├── plugbuild/         `lore build`, a binary with plugins compiled in&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;├── di/                Uber FX modules&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;├── entities/          Edge, Anchor, EvidenceBundle, IndexStats, SyncEvent&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;├── errors/internalerror/&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;├── fsx/   urlx/   mocks/&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;└── config/            lore.yaml loading + validation&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;api/proto/lore/v1/     gRPC contract&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;test/e2e/              composes the real binary, so it sits outside internal/&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;docs/                  these documents&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1620" y="1170" width="540" height="400" as="geometry"/></mxCell><mxCell id="2Layc44" value="&lt;b&gt;Uber FX wiring&lt;/b&gt;&lt;br&gt;each layer is an FX module, and the chain follows the dependency rather than the order the vars are declared: config → plugins → repository → services, composed in exactly that order by &lt;font face='Courier New'&gt;Workspace&lt;/font&gt; (internal/di/modules.go), then &lt;font face='Courier New'&gt;SchedulerModule&lt;/font&gt;, which only &lt;font face='Courier New'&gt;lore serve&lt;/font&gt; adds, and the transport the subcommand selects.&lt;br&gt;&lt;b&gt;Plugins come before the store&lt;/b&gt;, not after: &lt;font face='Courier New'&gt;RepositoryModule&lt;/font&gt;'s only provider is &lt;font face='Courier New'&gt;newIndexStore(lc, cfg, embedding)&lt;/font&gt;, and that &lt;font face='Courier New'&gt;embedding&lt;/font&gt; is built by &lt;font face='Courier New'&gt;newEmbedding&lt;/font&gt; inside &lt;font face='Courier New'&gt;PluginModule&lt;/font&gt;. The index's vector column is sized from &lt;font face='Courier New'&gt;Dimensions()&lt;/font&gt; and fixed at creation, so the store cannot open before a provider reports a width.&lt;br&gt;Adding a source = one plugin plus its manifest, registered in the composition root, or an external binary declared under &lt;font face='Courier New'&gt;plugins:&lt;/font&gt; and never compiled at all. The store stays behind that one provider but is deliberately not a plugin: one implementation, and an alternative would have to reproduce lease semantics and that same fixed vector width (03, 08)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1240" width="1520" height="150" as="geometry"/></mxCell><mxCell id="2Laye62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc6" target="2Layc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc7" target="2Layc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc8" target="2Layc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc9" target="2Layc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc6" target="2Layc11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc8" target="2Layc11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc9" target="2Layc11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc8" target="2Layc13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc9" target="2Layc13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc10" target="2Layc14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc10" target="2Layc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc10" target="2Layc17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc11" target="2Layc15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc11" target="2Layc14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc11" target="2Layc17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye77" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc12" target="2Layc14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc13" target="2Layc17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p4" name="4 · Query Engine"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2360" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3Quec1" value="QUERY ENGINE — one pipeline, four seed modes, five verbs, one result shape" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="36" as="geometry"/></mxCell><mxCell id="3Quec2" value="docs/v3/05-query-engine.md + 02 (D2, D3). Only the seed step differs per verb; walk, expansion, ranking, chain assembly, and gap reporting are shared. Every verb fills Chains and Gaps — the ask-only path gets the full engine, not a stripped retrieval endpoint." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1600" height="40" as="geometry"/></mxCell><mxCell id="3Quec3" value="SEED MODES — the only per-verb difference" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="112" width="600" height="26" as="geometry"/></mxCell><mxCell id="3Quec4" value="&lt;b&gt;find_decision (primary)&lt;/b&gt;&lt;br&gt;&lt;b&gt;anchor&lt;/b&gt;: free-text query ± time window&lt;br&gt;&lt;b&gt;seed&lt;/b&gt;: hybrid retrieval (BM25 + vectors + RRF)&lt;br&gt;of the question, filters applied, top-k chunks&lt;br&gt;lifted to their parent documents&lt;br&gt;&lt;b&gt;walk&lt;/b&gt;: both directions, depth ≤ 3&lt;br&gt;&lt;b&gt;expansion&lt;/b&gt;: none — seeding &lt;i&gt;is&lt;/i&gt; retrieval&lt;br&gt;&lt;b&gt;repos required&lt;/b&gt;: no, ever&lt;br&gt;gaps: 'PROJ-4521 stands alone; no linked&lt;br&gt;discussion' · unresolved event candidates" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="420" height="250" as="geometry"/></mxCell><mxCell id="3Quec5" value="&lt;b&gt;why (code-anchored)&lt;/b&gt;&lt;br&gt;&lt;b&gt;anchor&lt;/b&gt;: code span (repo, file, L1–L2)&lt;br&gt;&lt;b&gt;seed&lt;/b&gt;: &lt;font face='Courier New'&gt;git blame --porcelain&lt;/font&gt; on the local clone&lt;br&gt;→ contributing commit SHAs per line&lt;br&gt;&lt;b&gt;walk&lt;/b&gt;: both — commit → PR → review threads →&lt;br&gt;linked tickets/issues → linked pages&lt;br&gt;&lt;b&gt;expansion&lt;/b&gt;: embed question (optional) + blamed&lt;br&gt;code span + commit subjects; drop nodes the walk&lt;br&gt;already found; keep top-k as semantic_match&lt;br&gt;&lt;b&gt;repos required&lt;/b&gt;: yes — else precondition error" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="500" y="150" width="420" height="250" as="geometry"/></mxCell><mxCell id="3Quec6" value="&lt;b&gt;trace (drill-down)&lt;/b&gt;&lt;br&gt;&lt;b&gt;anchor&lt;/b&gt;: one document&lt;br&gt;&lt;b&gt;seed&lt;/b&gt;: &lt;font face='Courier New'&gt;ResolveRef&lt;/font&gt;(SHA / PR# / ticket key /&lt;br&gt;URL / DocID) → exactly one doc&lt;br&gt;(ambiguous ⇒ error listing candidates)&lt;br&gt;&lt;b&gt;walk&lt;/b&gt;: &lt;font face='Courier New'&gt;direction&lt;/font&gt; param (out|in|both, default both),&lt;br&gt;depth ≤ 2&lt;br&gt;&lt;b&gt;expansion&lt;/b&gt;: none (mechanical neighborhood)&lt;br&gt;returns the &lt;b&gt;full body&lt;/b&gt;, nodes chronological&lt;br&gt;&lt;b&gt;repos required&lt;/b&gt;: no" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="940" y="150" width="420" height="250" as="geometry"/></mxCell><mxCell id="3Quec7" value="&lt;b&gt;impact_of (consequences)&lt;/b&gt;&lt;br&gt;&lt;b&gt;anchor&lt;/b&gt;: document + its CreatedAt = T&lt;br&gt;(ref via ResolveRef, or free text → top doc,&lt;br&gt;interpretation recorded in Anchor.Doc)&lt;br&gt;&lt;b&gt;seed&lt;/b&gt;: the resolved document&lt;br&gt;&lt;b&gt;walk&lt;/b&gt;: edges traversed both ways mechanically,&lt;br&gt;keep only nodes with &lt;font face='Courier New'&gt;CreatedAt &amp;gt; T&lt;/font&gt; — in practice&lt;br&gt;incoming references_doc / mentions_commit +&lt;br&gt;supersedes chains. depth ≤ 3&lt;br&gt;&lt;b&gt;expansion&lt;/b&gt;: retrieval hard-filtered created_at &amp;gt; T&lt;br&gt;&lt;b&gt;output&lt;/b&gt;: chronological timeline, not a rank list" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1380" y="150" width="420" height="250" as="geometry"/></mxCell><mxCell id="3Quec8" value="&lt;b&gt;history_of (file evolution)&lt;/b&gt;&lt;br&gt;&lt;b&gt;anchor&lt;/b&gt;: file path (+ repo)&lt;br&gt;&lt;b&gt;seed&lt;/b&gt;: &lt;font face='Courier New'&gt;git log --follow&lt;/font&gt; commit sequence&lt;br&gt;(rename-aware)&lt;br&gt;&lt;b&gt;walk&lt;/b&gt;: both, 1 hop per commit — attaches each&lt;br&gt;commit's PR / ticket / doc layer via edges&lt;br&gt;&lt;b&gt;expansion&lt;/b&gt;: none&lt;br&gt;&lt;b&gt;output&lt;/b&gt;: chronological timeline, windowed by&lt;br&gt;&lt;font face='Courier New'&gt;limit&lt;/font&gt; + &lt;font face='Courier New'&gt;before&lt;/font&gt; cursor pagination&lt;br&gt;&lt;b&gt;repos required&lt;/b&gt;: yes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1820" y="150" width="420" height="250" as="geometry"/></mxCell><mxCell id="3Quec9" value="SHARED PIPELINE — identical for all five verbs (D2/D3): resolve anchor → seed → graph walk → semantic expansion → rank → EvidenceBundle" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="2260" height="250" as="geometry"/></mxCell><mxCell id="3Quec10" value="&lt;b&gt;1 · Resolve anchor&lt;/b&gt;&lt;br&gt;typed union (Δ7): query | code_span |&lt;br&gt;document | time_window — combinable&lt;br&gt;(Code+Window, Doc+Window).&lt;br&gt;Event resolution runs here when&lt;br&gt;&lt;font face='Courier New'&gt;around&lt;/font&gt; is supplied." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="350" height="190" as="geometry"/></mxCell><mxCell id="3Quec11" value="&lt;b&gt;2 · Seed documents&lt;/b&gt;&lt;br&gt;retrieval hits → parent docs, or&lt;br&gt;blamed commits, or the resolved doc,&lt;br&gt;or the git-log sequence.&lt;br&gt;Chunk hits are always lifted to their&lt;br&gt;parent document before the walk." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="470" width="350" height="190" as="geometry"/></mxCell><mxCell id="3Quec12" value="&lt;b&gt;3 · Graph walk&lt;/b&gt;&lt;br&gt;breadth-first over &lt;font face='Courier New'&gt;edges&lt;/font&gt;,&lt;br&gt;depth ≤ 3 (config-capped, server-capped),&lt;br&gt;cycle-guarded, direction-aware.&lt;br&gt;confidence &lt;b&gt;multiplies&lt;/b&gt; along the path;&lt;br&gt;tails below floor 0.3 are pruned." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="470" width="350" height="190" as="geometry"/></mxCell><mxCell id="3Quec13" value="&lt;b&gt;4 · Semantic expansion&lt;/b&gt;&lt;br&gt;only where the table says so&lt;br&gt;(why, impact_of).&lt;br&gt;hybrid retrieval over decision-type docs,&lt;br&gt;drop nodes already reached by the walk,&lt;br&gt;keep top-k as &lt;font face='Courier New'&gt;semantic_match&lt;/font&gt; —&lt;br&gt;catches never-linked discussions." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1170" y="470" width="350" height="190" as="geometry"/></mxCell><mxCell id="3Quec14" value="&lt;b&gt;5 · Rank + assemble&lt;/b&gt;&lt;br&gt;score = graph proximity × path confidence&lt;br&gt;× retrieval relevance × time prior.&lt;br&gt;Chains from walk paths; Gaps from dead-end&lt;br&gt;seeds, unresolved events, empty windows.&lt;br&gt;impact_of / history_of re-order chronologically." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1540" y="470" width="350" height="190" as="geometry"/></mxCell><mxCell id="3Quec15" value="&lt;b&gt;6 · EvidenceBundle out&lt;/b&gt;&lt;br&gt;MCP: returned as-is.&lt;br&gt;CLI/gRPC: optionally handed to&lt;br&gt;SynthesisService for cited prose.&lt;br&gt;Every node carries a real URL,&lt;br&gt;or it is not returned." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1910" y="470" width="350" height="190" as="geometry"/></mxCell><mxCell id="3Quee16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec10" target="3Quec11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3Quee17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec11" target="3Quec12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3Quee18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec12" target="3Quec13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3Quee19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec13" target="3Quec14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3Quee20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec14" target="3Quec15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3Quec26" value="EVENT RESOLUTION — &lt;font face='Courier New'&gt;around&lt;/font&gt; → TimeWindow (Δ4)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="500" height="26" as="geometry"/></mxCell><mxCell id="3Quec27" value="&lt;b&gt;input: &lt;font face='Courier New'&gt;around&lt;/font&gt;&lt;/b&gt;&lt;br&gt;free text ('incident X', 'the March outage')&lt;br&gt;or an ISO date" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="736" width="400" height="70" as="geometry"/></mxCell><mxCell id="3Quec28" value="&lt;b&gt;A · date given&lt;/b&gt;&lt;br&gt;window = date ± &lt;font face='Courier New'&gt;event_window&lt;/font&gt; (default 30d, configurable)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="826" width="400" height="60" as="geometry"/></mxCell><mxCell id="3Quec29" value="&lt;b&gt;B · free text, hits agree&lt;/b&gt;&lt;br&gt;hybrid retrieval of the event text → take top hits' &lt;font face='Courier New'&gt;CreatedAt&lt;/font&gt;.&lt;br&gt;If they agree (span ≤ 2 × event_window): anchor time = earliest&lt;br&gt;agreeing hit, window = anchor ± event_window." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="896" width="400" height="90" as="geometry"/></mxCell><mxCell id="3Quec30" value="&lt;b&gt;C · ambiguous (hits scattered in time)&lt;/b&gt;&lt;br&gt;no window — proceed unwindowed and record a Gap:&lt;br&gt;&quot;could not resolve event 'X' to a time — candidates: &amp;lt;top 3 with&lt;br&gt;dates and URLs&amp;gt;&quot;. The agent retries with a date or better phrase." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="996" width="400" height="90" as="geometry"/></mxCell><mxCell id="3Quec31" value="&lt;b&gt;effect of a resolved window&lt;/b&gt;&lt;br&gt;• applied as a &lt;font face='Courier New'&gt;created_at&lt;/font&gt; range filter on seed retrieval&lt;br&gt;• flips the ranking time prior: unanchored = mild recency boost →&lt;br&gt;  anchored = &lt;b&gt;proximity to the window&lt;/b&gt; (recency would be actively&lt;br&gt;  wrong for 'at the moment of X' questions)&lt;br&gt;• returned in &lt;font face='Courier New'&gt;Anchor.Window&lt;/font&gt; with its derivation, so answers are&lt;br&gt;  auditable: &quot;interpreted 'incident X' as 2025-03-12 via INC-201&quot;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="1096" width="400" height="140" as="geometry"/></mxCell><mxCell id="3Quee32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3Quec27" target="3Quec28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3Quee35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec28" target="3Quec31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3Quee36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec29" target="3Quec31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3Quec37" value="RANKING &amp; WALK PARAMETERS" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="500" y="700" width="400" height="26" as="geometry"/></mxCell><mxCell id="3Quec38" value="&lt;b&gt;score(node)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;graph proximity&lt;/font&gt;   fewer hops ⇒ higher&lt;br&gt;&lt;font face='Courier New'&gt;× path confidence&lt;/font&gt; product of edge confidences&lt;br&gt;&lt;font face='Courier New'&gt;× retrieval relevance&lt;/font&gt; when a question exists&lt;br&gt;&lt;font face='Courier New'&gt;× time prior&lt;/font&gt;       recency &lt;i&gt;or&lt;/i&gt; window proximity" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="736" width="420" height="110" as="geometry"/></mxCell><mxCell id="3Quec39" value="&lt;b&gt;Hybrid retrieval (03)&lt;/b&gt;&lt;br&gt;1 · BM25 over &lt;font face='Courier New'&gt;chunks_fts&lt;/font&gt; — exact identifiers, ticket&lt;br&gt;keys, error strings score well lexically&lt;br&gt;2 · vector KNN over &lt;font face='Courier New'&gt;chunk_vectors&lt;/font&gt; — paraphrase&lt;br&gt;('why Postgres' ↔ 'database selection rationale')&lt;br&gt;3 · &lt;b&gt;RRF in Go&lt;/b&gt;: score(d) = Σ 1/(k + rank_i(d)), k = 60&lt;br&gt;4 · metadata filters pushed into SQL: source, repo_ref,&lt;br&gt;doc_type, created_at range" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="856" width="420" height="150" as="geometry"/></mxCell><mxCell id="3Quec40" value="&lt;b&gt;Caps &amp; knobs (&lt;font face='Courier New'&gt;query:&lt;/font&gt; in lore.yaml, server-capped)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;event_window: 30d&lt;/font&gt; · &lt;font face='Courier New'&gt;walk_depth: 3&lt;/font&gt; · &lt;font face='Courier New'&gt;top_k: 12&lt;/font&gt;&lt;br&gt;confidence floor 0.3 · RRF k = 60 · trace depth ≤ 2&lt;br&gt;excerpt size + timeline window capped — MCP clients&lt;br&gt;cannot request unbounded output&lt;br&gt;(scoring constants are open question #2 in 07)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="500" y="1016" width="420" height="120" as="geometry"/></mxCell><mxCell id="3Quec41" value="&lt;b&gt;Gaps — honesty is a feature&lt;/b&gt;&lt;br&gt;dead-end seed · unresolved event · empty impact window&lt;br&gt;('no follow-up evidence after 2025-03-12' is itself an answer)&lt;br&gt;never papered over, never fabricated" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="1146" width="420" height="90" as="geometry"/></mxCell><mxCell id="3Quec42" value="QUERY-TIME VALIDATION (service layer)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="960" y="700" width="500" height="26" as="geometry"/></mxCell><mxCell id="3Quec43" value="Check" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="960" y="736" width="190" height="26" as="geometry"/></mxCell><mxCell id="3Quec44" value="Failure mode" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1150" y="736" width="330" height="26" as="geometry"/></mxCell><mxCell id="3Quec45" value="workspace exists + initialized" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="960" y="762" width="190" height="30" as="geometry"/></mxCell><mxCell id="3Quec46" value="precondition error" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1150" y="762" width="330" height="30" as="geometry"/></mxCell><mxCell id="3Quec47" value="embedder identity in &lt;font face='Courier New'&gt;meta&lt;/font&gt; == config" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="960" y="792" width="190" height="34" as="geometry"/></mxCell><mxCell id="3Quec48" value="explicit re-embed error (&lt;font face='Courier New'&gt;lore sync --reembed&lt;/font&gt;)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1150" y="792" width="330" height="34" as="geometry"/></mxCell><mxCell id="3Quec49" value="find_decision / trace / impact_of" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="960" y="826" width="190" height="30" as="geometry"/></mxCell><mxCell id="3Quec50" value="no repo required, ever" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1150" y="826" width="330" height="30" as="geometry"/></mxCell><mxCell id="3Quec51" value="why / history_of: ≥ 1 repo registered" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="960" y="856" width="190" height="46" as="geometry"/></mxCell><mxCell id="3Quec52" value="'no repositories registered — code anchoring disabled for this workspace'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1150" y="856" width="330" height="46" as="geometry"/></mxCell><mxCell id="3Quec53" value="why: file exists at HEAD, span valid" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="960" y="902" width="190" height="30" as="geometry"/></mxCell><mxCell id="3Quec54" value="bad-request error" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1150" y="902" width="330" height="30" as="geometry"/></mxCell><mxCell id="3Quec55" value="trace / impact_of ref → exactly 1 doc" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="960" y="932" width="190" height="34" as="geometry"/></mxCell><mxCell id="3Quec56" value="error listing candidate documents" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1150" y="932" width="330" height="34" as="geometry"/></mxCell><mxCell id="3Quec57" value="all limits (depth, top-k, excerpt, window)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="960" y="966" width="190" height="34" as="geometry"/></mxCell><mxCell id="3Quec58" value="clamped server-side, silently capped" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1150" y="966" width="330" height="34" as="geometry"/></mxCell><mxCell id="3Quec59" value="SYNTHESIS (non-AI surfaces only)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="960" y="1010" width="500" height="26" as="geometry"/></mxCell><mxCell id="3Quec60" value="&lt;b&gt;SynthesisService&lt;/b&gt;&lt;br&gt;input: EvidenceBundle + original question&lt;br&gt;system prompt: &lt;i&gt;answer ONLY from the provided evidence; cite the&lt;br&gt;node URL for every claim; state gaps explicitly; respect timeline&lt;br&gt;ordering for impact questions&lt;/i&gt;&lt;br&gt;output: markdown prose, inline [n] citations mapped to node URLs,&lt;br&gt;closing source list&lt;br&gt;provider: user-configured LLMConnector (openai | anthropic | zai |&lt;br&gt;ollama). Missing config ⇒ clear error naming the remedy.&lt;br&gt;MCP surfaces are unaffected — they never call synthesis (D1)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="960" y="1046" width="500" height="190" as="geometry"/></mxCell><mxCell id="3Quec61" value="THE ONE RESULT SHAPE" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1500" y="700" width="500" height="26" as="geometry"/></mxCell><mxCell id="3Quec62" value="&lt;b&gt;&lt;font face='Courier New'&gt;type EvidenceBundle struct {&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Question string   // normalized restatement&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Anchor   Anchor   // how it was grounded&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Nodes    []EvidenceNode // by relevance;&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;                   // impact_of: chronological&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Chains   [][]DocID // [ticket, page, pr, commit]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Gaps     []string  // 'trail ends at PROJ-4521;&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;                     //  no linked follow-up'&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1500" y="736" width="800" height="150" as="geometry"/></mxCell><mxCell id="3Quec63" value="&lt;b&gt;&lt;font face='Courier New'&gt;type Anchor struct {&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Kind   AnchorKind  // query | code_span | document | time_window&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Query  string      // find_decision: question as used for retrieval&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Code   *CodeAnchor // why/history_of: repo, file, span, blamed SHAs&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Doc    *DocRef     // trace/impact_of: resolved anchor document&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Window *TimeWindow // event resolution: from, to, how derived&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}   // combinable: Code+Window, Doc+Window&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1500" y="900" width="800" height="125" as="geometry"/></mxCell><mxCell id="3Quec64" value="&lt;b&gt;&lt;font face='Courier New'&gt;type EvidenceNode struct {&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Doc     DocumentMeta // id, source, type, title, author, url, created_at, updated_at&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Excerpt string       // the relevant span, not the whole body&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Role    string       // seed | blamed_commit | review_thread | linked_ticket |&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;                       // linked_change | design_doc | follow_up | semantic_match&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Score   float32&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Via     []Edge       // how it was reached; empty for pure retrieval hits&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1500" y="1040" width="800" height="135" as="geometry"/></mxCell><mxCell id="3Quec65" value="&lt;b&gt;Invariants&lt;/b&gt;&lt;br&gt;• every node carries a real URL — no URL ⇒ not evidence ⇒ not returned&lt;br&gt;• gaps are explicit; a dead-end trail is reported&lt;br&gt;• every verb fills Chains and Gaps — the ask-only path is not second-class&lt;br&gt;• excerpts are extracted spans; full bodies come from &lt;font face='Courier New'&gt;trace&lt;/font&gt; on the node ID, keeping default MCP responses token-cheap&lt;br&gt;• the bundle is additive-only (D9/Δ16); verbs may be added or retired around it" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1500" y="1190" width="800" height="110" as="geometry"/></mxCell><mxCell id="3Quec66" value="↓  all five seed modes feed step 2 — everything from step 2 onward is identical  ↓" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="404" width="2200" height="22" as="geometry"/></mxCell><mxCell id="3Quee67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.03;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec27" target="3Quec29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="46" y="818"/><mxPoint x="46" y="932"/></Array></mxGeometry></mxCell><mxCell id="3Quee68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.06;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec27" target="3Quec30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="34" y="818"/><mxPoint x="34" y="1032"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p5" name="5 · Data Model &amp; Storage"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2260" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="4Datc1" value="DATA MODEL &amp; STORAGE — one Document shape, one typed Edge graph, one SQLite file per workspace" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="36" as="geometry"/></mxCell><mxCell id="4Datc2" value="docs/v3/03-data-model.md. Everything any connector produces normalizes to Document + RawRef; the LinkResolver turns RawRefs into typed Edges. RepoRef is a metadata dimension, not a partition — one index holds many repos and repo-less documents side by side, so cross-repo / cross-source questions work for free." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1700" height="40" as="geometry"/></mxCell><mxCell id="4Datc3" value="ENTITIES — versioned, additive-only" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="112" width="520" height="26" as="geometry"/></mxCell><mxCell id="4Datc4" value="&lt;b&gt;&lt;font face='Courier New'&gt;type Document struct {&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  ID        DocID     // &quot;&amp;lt;source&amp;gt;:&amp;lt;type&amp;gt;:&amp;lt;external_id&amp;gt;&quot;, globally unique&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Source    string    // github | notion | jira | (later gitlab, slack…)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Type      DocType   // open set, see below&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  RepoRef   string    // &quot;github:owner/repo&quot; — EMPTY for non-repo docs&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Title     string&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Body      string    // normalized plain text / markdown&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Author    string&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  URL       string    // canonical web URL — THE citation target&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  CreatedAt time.Time // when the thing happened (event time)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  UpdatedAt time.Time // last edit (freshness / sync watermark)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Refs      []RawRef  // unresolved references found in the body&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="148" width="540" height="215" as="geometry"/></mxCell><mxCell id="4Datc5" value="&lt;b&gt;&lt;font face='Courier New'&gt;type RawRef struct {&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Kind  RefKind // url | ticket_key | commit_sha | file_path | pr_number&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Value string  // &quot;https://notion.so/…&quot;, &quot;PROJ-123&quot;, &quot;abc123&quot;,&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;                //  &quot;internal/auth/auth.go&quot;&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="375" width="540" height="95" as="geometry"/></mxCell><mxCell id="4Datc6" value="&lt;b&gt;&lt;font face='Courier New'&gt;type Edge struct {&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Src        DocID    // the doc whose body contains the reference&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Dst        DocID    // the referenced doc&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Kind       EdgeKind // commit_in_pr | pr_closes_issue | references_doc |&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;                      // mentions_commit | mentions_path | supersedes&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Confidence float32  // 1.0 explicit API link … 0.5 fuzzy text match&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="482" width="540" height="120" as="geometry"/></mxCell><mxCell id="4Datc7" value="&lt;b&gt;Direction is the whole trick (Δ5 / Δ12)&lt;/b&gt;&lt;br&gt;Edges are directional and traversal direction is a &lt;b&gt;query-time&lt;/b&gt; parameter&lt;br&gt;(&lt;font face='Courier New'&gt;Neighbors(..., dir)&lt;/font&gt;). &lt;b&gt;Incoming&lt;/b&gt; edges to a decision document, filtered&lt;br&gt;by time, are how &lt;font face='Courier New'&gt;impact_of&lt;/font&gt; finds consequences — no special 'impact'&lt;br&gt;edge kind exists. &lt;font face='Courier New'&gt;authored_follow_up&lt;/font&gt; from v1 was deleted (produced by&lt;br&gt;nothing); &lt;font face='Courier New'&gt;supersedes&lt;/font&gt; was added for ADR-style 'supersedes / replaced by'." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="614" width="540" height="120" as="geometry"/></mxCell><mxCell id="4Datc8" value="&lt;b&gt;CreatedAt vs UpdatedAt (Δ8) — not interchangeable&lt;/b&gt;&lt;br&gt;A postmortem edited yesterday still &lt;i&gt;belongs to&lt;/i&gt; last year's incident.&lt;br&gt;• &lt;b&gt;CreatedAt&lt;/b&gt; drives: event resolution, impact filtering (&lt;font face='Courier New'&gt;&amp;gt; T&lt;/font&gt;), timeline order&lt;br&gt;• &lt;b&gt;UpdatedAt&lt;/b&gt; drives: sync watermarks, freshness only&lt;br&gt;Sources without a true creation time set &lt;font face='Courier New'&gt;CreatedAt = UpdatedAt&lt;/font&gt; and the&lt;br&gt;connector's package doc says so." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="746" width="540" height="120" as="geometry"/></mxCell><mxCell id="4Datc9" value="&lt;b&gt;DocType — open set&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;commit · pr · pr_review · review_comment · issue · issue_comment&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;page · ticket · ticket_comment&lt;/font&gt;&lt;br&gt;A new connector MAY introduce a type; unknown types get the default&lt;br&gt;chunking strategy and rank as ordinary evidence (no core change)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="878" width="540" height="100" as="geometry"/></mxCell><mxCell id="4Datc10" value="CHUNKING — type-aware, with a defined default" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="995" width="540" height="26" as="geometry"/></mxCell><mxCell id="4Datc11" value="DocType" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="60" y="1026" width="190" height="26" as="geometry"/></mxCell><mxCell id="4Datc12" value="Strategy" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="250" y="1026" width="350" height="26" as="geometry"/></mxCell><mxCell id="4Datc13" value="commit" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1052" width="190" height="32" as="geometry"/></mxCell><mxCell id="4Datc14" value="whole message = one chunk (subject weighted into the title field)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="250" y="1052" width="350" height="32" as="geometry"/></mxCell><mxCell id="4Datc15" value="pr / issue / ticket / page" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1084" width="190" height="46" as="geometry"/></mxCell><mxCell id="4Datc16" value="split on markdown headings / paragraph groups, target ~300–500 tokens, small overlap" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="250" y="1084" width="350" height="46" as="geometry"/></mxCell><mxCell id="4Datc17" value="review_comment / issue_comment / ticket_comment" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1130" width="190" height="58" as="geometry"/></mxCell><mxCell id="4Datc18" value="one comment = one chunk; thread id kept in metadata so retrieval can rehydrate the thread" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="250" y="1130" width="350" height="58" as="geometry"/></mxCell><mxCell id="4Datc19" value="any other / future type" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1188" width="190" height="46" as="geometry"/></mxCell><mxCell id="4Datc20" value="default: heading + paragraph split, ~300–500 tokens, small overlap" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="250" y="1188" width="350" height="46" as="geometry"/></mxCell><mxCell id="4Datc21" value="&lt;b&gt;Every chunk carries filterable metadata&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;doc_id · source · repo_ref · doc_type · author · created_at · updated_at&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="1264" width="540" height="50" as="geometry"/></mxCell><mxCell id="4Datc22" value="SQLITE SCHEMA — &lt;font face='Courier New'&gt;~/.lore/&amp;lt;workspace&amp;gt;.db&lt;/font&gt; (path configurable)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="640" y="112" width="760" height="26" as="geometry"/></mxCell><mxCell id="4Datc23" value="&lt;b&gt;documents&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;doc_id PK · source · doc_type · repo_ref&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;title · body (full, for excerpts) · author&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;url (indexed) · created_at · updated_at&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;external_key (indexed) — ticket keys, PR #&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;sha_prefix (indexed) — commit SHA lookup&lt;/font&gt;&lt;br&gt;full body retained: excerpts are extracted,&lt;br&gt;and &lt;font face='Courier New'&gt;trace&lt;/font&gt; returns whole bodies on demand" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="148" width="360" height="160" as="geometry"/></mxCell><mxCell id="4Datc24" value="&lt;b&gt;chunks&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;chunk_id PK (rowid) · doc_id FK → documents&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;ord · text · token_est&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;source · repo_ref · doc_type · author&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;created_at · updated_at (denormalized&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  for filter push-down)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;thread_id (comments)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1040" y="148" width="360" height="160" as="geometry"/></mxCell><mxCell id="4Datc25" value="&lt;b&gt;chunks_fts  — FTS5 virtual table&lt;/b&gt;&lt;br&gt;BM25 over chunk text · lexical arm of hybrid retrieval&lt;br&gt;wins on exact identifiers, ticket keys, error strings" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="360" height="90" as="geometry"/></mxCell><mxCell id="4Datc26" value="&lt;b&gt;chunk_vectors — sqlite-vec virtual table&lt;/b&gt;&lt;br&gt;rowid-aligned with &lt;font face='Courier New'&gt;chunks&lt;/font&gt; · vector KNN arm&lt;br&gt;dimension fixed by the embedder identity in &lt;font face='Courier New'&gt;meta&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1040" y="330" width="360" height="90" as="geometry"/></mxCell><mxCell id="4Datc27" value="&lt;b&gt;edges&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;src FK · dst FK · kind · confidence&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;UNIQUE(src, dst, kind)&lt;/font&gt; — INSERT OR IGNORE&lt;br&gt;indexed on &lt;b&gt;both&lt;/b&gt; src and dst → direction-aware&lt;br&gt;walks (DirOut / DirIn / DirBoth) with no scans" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="442" width="360" height="110" as="geometry"/></mxCell><mxCell id="4Datc28" value="&lt;b&gt;pending_refs&lt;/b&gt;&lt;br&gt;RawRefs whose target is not ingested yet&lt;br&gt;&lt;font face='Courier New'&gt;src_doc_id · kind · value · first_seen · attempts&lt;/font&gt;&lt;br&gt;retried every sync round; a Notion page linked&lt;br&gt;from a PR may arrive after the PR" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1040" y="442" width="360" height="110" as="geometry"/></mxCell><mxCell id="4Datc29" value="&lt;b&gt;cursors&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;connector PK · cursor_blob · updated_at&lt;/font&gt;&lt;br&gt;per-connector incremental sync position;&lt;br&gt;written only &lt;b&gt;after&lt;/b&gt; its batch is durable" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="574" width="360" height="90" as="geometry"/></mxCell><mxCell id="4Datc30" value="&lt;b&gt;sync_lock  — single-row lease&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;holder · acquired_at · heartbeat_at&lt;/font&gt;&lt;br&gt;heartbeat older than TTL (60s) ⇒ dead, may be&lt;br&gt;taken over: a crashed sync never wedges the&lt;br&gt;scheduler; also guards multi-process access" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1040" y="574" width="360" height="110" as="geometry"/></mxCell><mxCell id="4Datc31" value="&lt;b&gt;meta&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;schema_version&lt;/font&gt; · &lt;font face='Courier New'&gt;embedder_identity&lt;/font&gt; (provider+model+dims)&lt;br&gt;changing the embedder invalidates every vector ⇒ detected at&lt;br&gt;startup, surfaced as an explicit error with the &lt;font face='Courier New'&gt;lore sync --reembed&lt;/font&gt;&lt;br&gt;remedy. Never silent, never a quiet quality regression." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="640" y="700" width="760" height="110" as="geometry"/></mxCell><mxCell id="4Datc37" value="HYBRID RETRIEVAL — fusion happens in Go, never in SQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="640" y="830" width="760" height="26" as="geometry"/></mxCell><mxCell id="4Datc38" value="&lt;b&gt;query text&lt;/b&gt;&lt;br&gt;+ filters: source, repo_ref, doc_type,&lt;br&gt;created_at range (event window)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="640" y="866" width="220" height="80" as="geometry"/></mxCell><mxCell id="4Datc39" value="&lt;b&gt;Embed(query)&lt;/b&gt;&lt;br&gt;embedder connector" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="900" y="866" width="200" height="80" as="geometry"/></mxCell><mxCell id="4Datc40" value="&lt;b&gt;SearchLexical&lt;/b&gt;&lt;br&gt;BM25 / FTS5 → ranked list A" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="976" width="340" height="70" as="geometry"/></mxCell><mxCell id="4Datc41" value="&lt;b&gt;SearchVector&lt;/b&gt;&lt;br&gt;sqlite-vec KNN → ranked list B" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1020" y="976" width="380" height="70" as="geometry"/></mxCell><mxCell id="4Datc42" value="&lt;b&gt;RRF fusion (service layer)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;score(d) = Σ 1/(k + rank_i(d)) , k = 60&lt;/font&gt;&lt;br&gt;any backend that can rank lexically and by vector distance qualifies" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="1076" width="760" height="80" as="geometry"/></mxCell><mxCell id="4Datc43" value="&lt;b&gt;lift chunks → parent documents&lt;/b&gt;&lt;br&gt;seeds for the shared walk / rank machinery (05)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="1186" width="760" height="60" as="geometry"/></mxCell><mxCell id="4Datc50" value="STORE CONTRACT &amp; PORTABILITY" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1440" y="112" width="700" height="26" as="geometry"/></mxCell><mxCell id="4Datc51" value="&lt;b&gt;&lt;font face='Courier New'&gt;type IndexStore interface {&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // documents &amp;amp; chunks — batch upserts atomic internally;&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // no transaction type ever leaks out of the store&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  UpsertDocuments(ctx, docs []Document) error&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  ReplaceChunks(ctx, docID DocID, chunks []Chunk) error&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // retrieval — two independently ranked lists&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  SearchLexical(ctx, query string, f Filters, k int) ([]ChunkHit, error)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  SearchVector(ctx, emb []float32, f Filters, k int) ([]ChunkHit, error)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // ref resolution — URL, ticket key, SHA prefix, PR/issue #, DocID&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  ResolveRef(ctx, ref string) ([]DocumentMeta, error)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // graph — direction-aware traversal&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  UpsertEdges(ctx, edges []Edge) error&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Neighbors(ctx, ids []DocID, kinds []EdgeKind, dir Direction) ([]Edge, error)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // sync bookkeeping&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Cursor(ctx, connector string) (Cursor, error)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  SetCursor(ctx, connector string, c Cursor) error&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  PendingRefs(ctx) ([]PendingRef, error)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // lease lock — SQLite: lease row; Postgres: advisory lock. Same semantics.&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  TryAcquireLease(ctx, holder string) (bool, error)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  HeartbeatLease(ctx, holder string) error&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  ReleaseLease(ctx, holder string) error&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Meta(ctx, key string) (string, error)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  SetMeta(ctx, key, value string) error&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;type Direction int // DirOut (src→dst) | DirIn (dst→src) | DirBoth&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1440" y="148" width="700" height="470" as="geometry"/></mxCell><mxCell id="4Datc52" value="&lt;b&gt;Portability rules baked into the design&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Fusion in Go, not SQL.&lt;/b&gt; The store returns ranked lists; RRF lives in the service layer. FTS5+sqlite-vec, tsvector+pgvector, Elastic — all qualify.&lt;br&gt;• &lt;b&gt;The index is derived data.&lt;/b&gt; Sources are ground truth; the index is a rebuildable cache. Switching backends = re-sync + re-embed against a fresh store — no data-migration tooling, ever.&lt;br&gt;• &lt;b&gt;No leaked SQL types.&lt;/b&gt; Callers never see transactions, rowids, or virtual-table details.&lt;br&gt;• Config gains a &lt;font face='Courier New'&gt;store:&lt;/font&gt; key (&lt;font face='Courier New'&gt;sqlite&lt;/font&gt; default) only when a second backend lands — not before (YAGNI).&lt;br&gt;• Honest cost of a new backend: schema + interface impl + integration tests + vector-dimension handling. Bounded to one package, not free." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1440" y="638" width="700" height="210" as="geometry"/></mxCell><mxCell id="4Datc53" value="&lt;b&gt;Driver choice (D6 / Δ13)&lt;/b&gt;&lt;br&gt;&lt;b&gt;default: ncruces/go-sqlite3 (WASM)&lt;/b&gt; with sqlite-vec embedded via the official&lt;br&gt;sqlite-vec-go-bindings &lt;font face='Courier New'&gt;ncruces&lt;/font&gt; package → pure Go, no cgo, clean cross-compilation.&lt;br&gt;&lt;b&gt;alternative:&lt;/b&gt; mattn/go-sqlite3 + sqlite-vec cgo bindings, drop-in behind IndexStore.&lt;br&gt;M1 benchmarks on a realistic corpus decide whether the cgo pairing is ever needed&lt;br&gt;(named risk: 'WASM SQLite slower than cgo' → query latency)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1440" y="868" width="700" height="130" as="geometry"/></mxCell><mxCell id="4Datc54" value="&lt;b&gt;Why one SQLite file per workspace&lt;/b&gt;&lt;br&gt;• zero external infra — nothing to run, nothing to operate&lt;br&gt;• single-file portability and trivial backup&lt;br&gt;• offline queries after sync&lt;br&gt;• trivial integration tests (temp file per test)&lt;br&gt;• &lt;font face='Courier New'&gt;RepoRef&lt;/font&gt; is metadata, not a partition ⇒ 'which repos were affected by decision X'&lt;br&gt;  is an ordinary query over one index that also holds repo-less documents" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1440" y="1018" width="700" height="150" as="geometry"/></mxCell><mxCell id="4Datc55" value="&lt;b&gt;Ref-lookup indexes (no table scans)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;documents.url&lt;/font&gt; · &lt;font face='Courier New'&gt;documents.external_key&lt;/font&gt; (ticket keys, PR/issue numbers) ·&lt;br&gt;&lt;font face='Courier New'&gt;documents.sha_prefix&lt;/font&gt; — all populated at ingest. Both &lt;font face='Courier New'&gt;ResolveRef&lt;/font&gt; and the&lt;br&gt;LinkResolver use them, which is what makes ticket-key and SHA-prefix&lt;br&gt;resolution cheap enough to run on every sync round." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1440" y="1188" width="700" height="120" as="geometry"/></mxCell><mxCell id="4Date56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc23" target="4Datc24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc24" target="4Datc25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc24" target="4Datc26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc28" target="4Datc27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc38" target="4Datc39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc38" target="4Datc40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc39" target="4Datc41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc40" target="4Datc42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc41" target="4Datc42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc42" target="4Datc43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Datc67" value="&lt;b&gt;What the arrows mean (labels omitted so they never sit on a column list)&lt;/b&gt;&lt;br&gt;• &lt;font face='Courier New'&gt;documents&lt;/font&gt; 1 : N &lt;font face='Courier New'&gt;chunks&lt;/font&gt; — &lt;font face='Courier New'&gt;ReplaceChunks(docID, chunks)&lt;/font&gt; rewrites a document's chunk set atomically&lt;br&gt;• &lt;font face='Courier New'&gt;chunks&lt;/font&gt; → &lt;font face='Courier New'&gt;chunks_fts&lt;/font&gt; — chunk text mirrored into the FTS5 virtual table (lexical arm)&lt;br&gt;• &lt;font face='Courier New'&gt;chunks&lt;/font&gt; → &lt;font face='Courier New'&gt;chunk_vectors&lt;/font&gt; — embeddings written rowid-aligned with the chunk rows (vector arm)&lt;br&gt;• &lt;font face='Courier New'&gt;documents&lt;/font&gt; ← &lt;font face='Courier New'&gt;edges&lt;/font&gt; — &lt;font face='Courier New'&gt;src&lt;/font&gt; and &lt;font face='Courier New'&gt;dst&lt;/font&gt; both FK into documents; indexed on both for direction-aware walks&lt;br&gt;• &lt;font face='Courier New'&gt;pending_refs&lt;/font&gt; → &lt;font face='Courier New'&gt;edges&lt;/font&gt; — a pending ref is promoted to a typed edge once both sides exist (idempotent)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="640" y="1260" width="760" height="120" as="geometry"/></mxCell><mxCell id="4Date68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;exitX=0.02;exitY=1;exitDx=0;exitDy=0;entryX=0.02;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc23" target="4Datc27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="622" y="320"/><mxPoint x="622" y="430"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p6" name="6 · Connectors &amp; Sync"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="1620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="5Conc1" value="CONNECTORS &amp; SYNC — one contract, optional sources, batch-checkpointed streams, lease-locked rounds" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="36" as="geometry"/></mxCell><mxCell id="5Conc2" value="docs/v3/04-connectors-and-sync.md. Every source is a plugin implementing one interface plus a manifest, registered by name (internal/registry, Register and RegisterExternal). The orchestrator iterates only the source instances lore.yaml configures (internal/di/modules.go, sourceInstances), so any subset of sources is supported, and two instances of one plugin are as well." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1700" height="56" as="geometry"/></mxCell><mxCell id="5Conc3" value="&lt;b&gt;&lt;font face='Courier New'&gt;type Connector interface {&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Name() string // &quot;github&quot;, &quot;notion&quot;, &quot;jira&quot;, …&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // Changes streams batches of documents modified since cursor,&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // oldest-first. Each Batch carries the cursor that becomes&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // durable once the batch is committed — the checkpoint unit&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // IS the batch. Must be resumable and idempotent.&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Changes(ctx context.Context, cursor Cursor) iter.Seq2[Batch, error]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;type Batch struct {&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Docs   []Document&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Cursor Cursor // persist AFTER Docs are durably committed&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="600" height="230" as="geometry"/></mxCell><mxCell id="5Conc4" value="&lt;b&gt;Why this signature (D8 / Δ10)&lt;/b&gt;&lt;br&gt;The v1 signature returned one final cursor &lt;i&gt;before&lt;/i&gt; the stream was consumed, which made&lt;br&gt;the documented crash-safe resume unimplementable. Now: &lt;b&gt;commit batch → persist that&lt;br&gt;batch's cursor → next batch&lt;/b&gt;. Interrupted backfills resume mid-source with no re-work&lt;br&gt;and no duplicate writes (upserts are idempotent by DocID)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="392" width="600" height="105" as="geometry"/></mxCell><mxCell id="5Conc5" value="&lt;b&gt;Contract rules&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Optional by construction&lt;/b&gt; — lore.yaml declares which sources exist; absent source = not synced, not required.&lt;br&gt;• &lt;b&gt;No business logic&lt;/b&gt; — connectors fetch, paginate, retry, normalize to Document + RawRefs. Ref &lt;i&gt;resolution&lt;/i&gt; is the LinkResolver's job.&lt;br&gt;• &lt;b&gt;Read-only&lt;/b&gt; — no connector ever writes to its source.&lt;br&gt;• Credentials come from env vars &lt;i&gt;named&lt;/i&gt; in config — never stored in lore.yaml or the index.&lt;br&gt;• Both timestamps populated; a source without a true creation time sets CreatedAt = UpdatedAt and says so in its package doc.&lt;br&gt;• &lt;b&gt;Conformance-tested&lt;/b&gt;: &lt;font face='Courier New'&gt;sdk/conform&lt;/font&gt; checks cursors, timestamps, identity, idempotency, mid-stream resume, a stream that reaches completion, and an error that ends the stream.&lt;br&gt;• &lt;b&gt;Import boundary&lt;/b&gt;: &lt;font face='Courier New'&gt;sdk/**&lt;/font&gt; imports stdlib and its own subpackages only, &lt;font face='Courier New'&gt;plugins/**&lt;/font&gt; imports &lt;font face='Courier New'&gt;sdk/**&lt;/font&gt; and siblings, &lt;font face='Courier New'&gt;internal/**&lt;/font&gt; never imports &lt;font face='Courier New'&gt;plugins/**&lt;/font&gt;. depguard enforces it." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="498" width="600" height="201" as="geometry"/></mxCell><mxCell id="5Conc6" value="&lt;b&gt;GitHubConnector (v1)&lt;/b&gt;&lt;br&gt;&lt;b&gt;auth&lt;/b&gt;: PAT &lt;font face='Courier New'&gt;LORE_GITHUB_TOKEN&lt;/font&gt; — public + private&lt;br&gt;&lt;b&gt;scope&lt;/b&gt;: the instance's required &lt;font face='Courier New'&gt;with.repos&lt;/font&gt; list, independent of&lt;br&gt;local clones: a workspace can index PRs/issues with no repo on disk&lt;br&gt;&lt;b&gt;ingests&lt;/b&gt;: commits (message + metadata) · PRs (body) · PR reviews ·&lt;br&gt;review comments · issues · issue comments&lt;br&gt;&lt;b&gt;API&lt;/b&gt;: GraphQL for backfill (batches related objects, fewer&lt;br&gt;round-trips under rate limits)&lt;br&gt;&lt;b&gt;cursor&lt;/b&gt;: per-repo &lt;font face='Courier New'&gt;updated_at&lt;/font&gt; watermarks&lt;br&gt;&lt;b&gt;RawRefs&lt;/b&gt;: ticket keys in commit/branch/PR text · URLs in bodies&lt;br&gt;(Notion + Jira links!) · &lt;font face='Courier New'&gt;#123&lt;/font&gt; issue/PR refs · commit SHAs ·&lt;br&gt;file paths from the touched-file lists&lt;br&gt;&lt;b&gt;explicit API relations&lt;/b&gt; (PR ↔ closing issue, PR ↔ commits) are&lt;br&gt;emitted as ready-made high-confidence refs" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="700" y="150" width="520" height="250" as="geometry"/></mxCell><mxCell id="5Conc7" value="&lt;b&gt;NotionConnector (v1)&lt;/b&gt;&lt;br&gt;&lt;b&gt;auth&lt;/b&gt;: integration token &lt;font face='Courier New'&gt;LORE_NOTION_TOKEN&lt;/font&gt;&lt;br&gt;&lt;b&gt;scope&lt;/b&gt;: the optional &lt;font face='Courier New'&gt;with.root_pages&lt;/font&gt; list, page ids or exact&lt;br&gt;titles, and their descendants. An empty list syncs every page&lt;br&gt;shared with the integration&lt;br&gt;&lt;b&gt;ingests&lt;/b&gt;: pages + block content flattened to markdown-ish text&lt;br&gt;&lt;b&gt;timestamps&lt;/b&gt;: CreatedAt = &lt;font face='Courier New'&gt;created_time&lt;/font&gt;&lt;br&gt;&lt;b&gt;cursor&lt;/b&gt;: &lt;font face='Courier New'&gt;last_edited_time&lt;/font&gt; search watermark&lt;br&gt;&lt;b&gt;RawRefs&lt;/b&gt;: URLs to GitHub PRs/commits/issues and Jira tickets ·&lt;br&gt;repo file paths mentioned in text · ticket keys&lt;br&gt;&lt;b&gt;doc types&lt;/b&gt;: &lt;font face='Courier New'&gt;page&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1240" y="150" width="520" height="250" as="geometry"/></mxCell><mxCell id="5Conc8" value="&lt;b&gt;JiraConnector (v1) — Δ6&lt;/b&gt;&lt;br&gt;&lt;b&gt;target&lt;/b&gt;: Jira &lt;b&gt;Cloud&lt;/b&gt; (Data Center post-v1: same package, 2nd auth mode)&lt;br&gt;&lt;b&gt;auth&lt;/b&gt;: email + API token (basic) &lt;font face='Courier New'&gt;LORE_JIRA_EMAIL&lt;/font&gt; /&lt;br&gt;&lt;font face='Courier New'&gt;LORE_JIRA_TOKEN&lt;/font&gt; · &lt;font face='Courier New'&gt;with.base_url: https://&amp;lt;org&amp;gt;.atlassian.net&lt;/font&gt;&lt;br&gt;&lt;b&gt;endpoint&lt;/b&gt;: the &lt;b&gt;new&lt;/b&gt; &lt;font face='Courier New'&gt;/rest/api/3/search/jql&lt;/font&gt; with&lt;br&gt;&lt;font face='Courier New'&gt;nextPageToken&lt;/font&gt; pagination (legacy &lt;font face='Courier New'&gt;/rest/api/3/search&lt;/font&gt; is deprecated)&lt;br&gt;&lt;b&gt;cursor&lt;/b&gt;: JQL watermark — &lt;font face='Courier New'&gt;project IN (…) AND updated &amp;gt;=&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;&quot;&amp;lt;watermark&amp;gt;&quot; ORDER BY updated ASC&lt;/font&gt;. Comment edits bump the&lt;br&gt;issue's &lt;font face='Courier New'&gt;updated&lt;/font&gt;, so comment changes re-enter the stream&lt;br&gt;automatically; re-ingest is idempotent by DocID.&lt;br&gt;&lt;b&gt;ingests&lt;/b&gt;: issues → &lt;font face='Courier New'&gt;ticket&lt;/font&gt; (summary + description),&lt;br&gt;comments → &lt;font face='Courier New'&gt;ticket_comment&lt;/font&gt;; ADF flattened to plain text&lt;br&gt;&lt;b&gt;why it matters&lt;/b&gt;: this connector is what makes ticket-key refs from&lt;br&gt;commits / PRs / Notion actually &lt;i&gt;resolve&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1780" y="150" width="520" height="250" as="geometry"/></mxCell><mxCell id="5Conc9" value="&lt;b&gt;Git code plugin — local clones, kind &lt;font face='Courier New'&gt;KindCode&lt;/font&gt;, not a &lt;font face='Courier New'&gt;Connector&lt;/font&gt;&lt;/b&gt;&lt;br&gt;a third plugin kind behind the same registry and manifest, entirely optional. Absent &lt;font face='Courier New'&gt;repos:&lt;/font&gt; ⇒ never&lt;br&gt;constructed, and &lt;font face='Courier New'&gt;why&lt;/font&gt; / &lt;font face='Courier New'&gt;history_of&lt;/font&gt; return a precondition error.&lt;br&gt;&lt;font face='Courier New'&gt;Blame(ctx, path, startLine, endLine) ([]BlameSpan, error)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Log(ctx, path) ([]CommitRef, error)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;HasFileAtHEAD(ctx, path) (bool, error)&lt;/font&gt;&lt;br&gt;impl: shell out to &lt;font face='Courier New'&gt;git&lt;/font&gt; (&lt;font face='Courier New'&gt;blame --porcelain&lt;/font&gt;, &lt;font face='Courier New'&gt;log --follow&lt;/font&gt;) —&lt;br&gt;robust, zero-dependency, already installed everywhere Lore runs.&lt;br&gt;Local git is ground truth for line attribution; the GitHub/GitLab&lt;br&gt;connectors &lt;i&gt;enrich&lt;/i&gt; those commits with PR/review/issue layers,&lt;br&gt;matched via the &lt;font face='Courier New'&gt;remote:&lt;/font&gt; mapping in config." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="700" y="430" width="520" height="210" as="geometry"/></mxCell><mxCell id="5Conc10" value="&lt;b&gt;Model providers — one kind, two optional capabilities&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;type Embedder interface {&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Embed(ctx, texts []string) ([][]float32, error)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Dimensions() int&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;type Completer interface { // ONLY SynthesisService (non-AI surfaces)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Complete(ctx, system, user string) (string, error)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;&lt;br&gt;embedder default OpenAI, Ollama for fully-local. Vendors speaking the&lt;br&gt;OpenAI protocol are preset rows of one driver, not packages.&lt;br&gt;The host composes the vector-space identity &lt;font face='Courier New'&gt;&amp;lt;plugin&amp;gt;/&amp;lt;model&amp;gt;/&amp;lt;dims&amp;gt;&lt;/font&gt;&lt;br&gt;(internal/services/vectorspace.go, NewVectorSpace), writes it to &lt;font face='Courier New'&gt;meta&lt;/font&gt;,&lt;br&gt;and checks it each round, so no plugin can claim another's identity." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1240" y="430" width="520" height="210" as="geometry"/></mxCell><mxCell id="5Conc11" value="&lt;b&gt;Future sources (same contract)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Confluence&lt;/b&gt; · &lt;b&gt;ClickUp&lt;/b&gt;&lt;br&gt;&lt;b&gt;Slack&lt;/b&gt; — decision threads, new &lt;font face='Courier New'&gt;message&lt;/font&gt; DocType&lt;br&gt;Each is a new plugin plus one instance under &lt;font face='Courier New'&gt;sources:&lt;/font&gt;, compiled&lt;br&gt;into a binary or installed as an external one. Nothing requires it&lt;br&gt;to live in this repository.&lt;br&gt;&lt;b&gt;Core does not change.&lt;/b&gt; Unknown DocTypes already degrade&lt;br&gt;gracefully to the default chunking strategy." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1780" y="430" width="520" height="210" as="geometry"/></mxCell><mxCell id="5Conc12" value="SYNC ROUND — per configured connector, then one resolver pass" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="900" height="26" as="geometry"/></mxCell><mxCell id="5Conc13" value="&lt;b&gt;1 · load cursor&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;cursors[connector]&lt;/font&gt;&lt;br&gt;empty ⇒ full backfill" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="736" width="200" height="80" as="geometry"/></mxCell><mxCell id="5Conc14" value="&lt;b&gt;2 · stream Changes(cursor)&lt;/b&gt;&lt;br&gt;oldest-first batches&lt;br&gt;pagination + retry inside&lt;br&gt;the connector" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="280" y="736" width="220" height="80" as="geometry"/></mxCell><mxCell id="5Conc15" value="&lt;b&gt;3a · upsert documents&lt;/b&gt;&lt;br&gt;idempotent by DocID" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="736" width="200" height="80" as="geometry"/></mxCell><mxCell id="5Conc16" value="&lt;b&gt;3b · chunk + embed&lt;/b&gt;&lt;br&gt;type-aware chunking;&lt;br&gt;embed new/changed chunks in&lt;br&gt;batches; update FTS + vectors" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="740" y="736" width="220" height="80" as="geometry"/></mxCell><mxCell id="5Conc17" value="&lt;b&gt;3c · store RawRefs&lt;/b&gt;&lt;br&gt;into &lt;font face='Courier New'&gt;pending_refs&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="846" width="200" height="70" as="geometry"/></mxCell><mxCell id="5Conc18" value="&lt;b&gt;3d · commit durably&lt;/b&gt;&lt;br&gt;documents + chunks + vectors&lt;br&gt;+ refs as one atomic unit" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="280" y="846" width="220" height="70" as="geometry"/></mxCell><mxCell id="5Conc19" value="&lt;b&gt;3e · persist batch.Cursor&lt;/b&gt;&lt;br&gt;&lt;b&gt;after&lt;/b&gt; the commit, never before&lt;br&gt;⇒ crash-safe resume at batch&lt;br&gt;granularity" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="520" y="846" width="200" height="70" as="geometry"/></mxCell><mxCell id="5Conc20" value="&lt;b&gt;4 · LinkResolver pass&lt;/b&gt;&lt;br&gt;after ALL connectors finish —&lt;br&gt;cross-source edges need both&lt;br&gt;sides ingested" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="740" y="846" width="220" height="70" as="geometry"/></mxCell><mxCell id="5Cone21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="5Conc13" target="5Conc14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone22" value="per Batch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="5Conc14" target="5Conc15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="5Conc15" target="5Conc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5Conc16" target="5Conc17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="5Conc17" target="5Conc18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="5Conc18" target="5Conc19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="5Conc19" target="5Conc20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone28" value="next batch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="5Conc19" target="5Conc14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="950"/><mxPoint x="390" y="950"/></Array></mxGeometry></mxCell><mxCell id="5Conc29" value="LEASE LOCK — manual trigger wins, scheduler skips its round" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1000" y="700" width="800" height="26" as="geometry"/></mxCell><mxCell id="5Conc30" value="&lt;b&gt;Manual trigger&lt;/b&gt;&lt;br&gt;CLI &lt;font face='Courier New'&gt;lore sync&lt;/font&gt; · MCP &lt;font face='Courier New'&gt;sync_now&lt;/font&gt; ·&lt;br&gt;gRPC &lt;font face='Courier New'&gt;SyncService.Trigger&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1000" y="736" width="280" height="70" as="geometry"/></mxCell><mxCell id="5Conc31" value="&lt;b&gt;Scheduler tick&lt;/b&gt;&lt;br&gt;every &lt;font face='Courier New'&gt;scheduler.interval&lt;/font&gt; (default 30m)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1000" y="826" width="280" height="60" as="geometry"/></mxCell><mxCell id="5Conc32" value="&lt;b&gt;Acquire lease&lt;/b&gt;&lt;br&gt;blocks or errors verbosely:&lt;br&gt;'lease held by &amp;lt;holder&amp;gt;'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1320" y="736" width="220" height="70" as="geometry"/></mxCell><mxCell id="5Conc33" value="&lt;b&gt;TryAcquireLease&lt;/b&gt;&lt;br&gt;held? → yes: &lt;b&gt;skip round&lt;/b&gt;, log the skip&lt;br&gt;no (or heartbeat &amp;gt; TTL 60s ⇒ dead&lt;br&gt;holder): take over" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1320" y="826" width="260" height="80" as="geometry"/></mxCell><mxCell id="5Conc34" value="&lt;b&gt;RUN SYNC ROUND&lt;/b&gt;&lt;br&gt;single writer per workspace file" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1620" y="736" width="240" height="70" as="geometry"/></mxCell><mxCell id="5Conc35" value="&lt;b&gt;Heartbeat every 15s&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;heartbeat_at = now()&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1620" y="826" width="240" height="60" as="geometry"/></mxCell><mxCell id="5Conc36" value="&lt;b&gt;Release on finish&lt;/b&gt;&lt;br&gt;deferred; crash ⇒ TTL takeover" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1620" y="906" width="240" height="60" as="geometry"/></mxCell><mxCell id="5Cone37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="5Conc30" target="5Conc32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="5Conc31" target="5Conc33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Conc43" value="&lt;b&gt;The same lock covers&lt;/b&gt;&lt;br&gt;• scheduler vs scheduler (a long round overlapping the next tick)&lt;br&gt;• manual vs scheduled (manual wins; the tick logs a skip)&lt;br&gt;• multiple processes sharing one workspace file — e.g. a &lt;font face='Courier New'&gt;lore serve&lt;/font&gt;&lt;br&gt;  daemon plus an ad-hoc CLI run&lt;br&gt;A crashed sync never wedges the scheduler: the heartbeat goes stale,&lt;br&gt;the lease expires, the next tick takes it over." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1900" y="736" width="400" height="230" as="geometry"/></mxCell><mxCell id="5Conc44" value="LINK RESOLVER — RawRefs → typed edges (second pass)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="990" width="900" height="26" as="geometry"/></mxCell><mxCell id="5Conc45" value="RawRef" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="60" y="1026" width="300" height="26" as="geometry"/></mxCell><mxCell id="5Conc46" value="Resolution" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="360" y="1026" width="300" height="26" as="geometry"/></mxCell><mxCell id="5Conc47" value="Edge kind" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="660" y="1026" width="200" height="26" as="geometry"/></mxCell><mxCell id="5Conc48" value="Confidence" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="860" y="1026" width="100" height="26" as="geometry"/></mxCell><mxCell id="5Conc49" value="explicit API relation (GitHub)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1052" width="300" height="32" as="geometry"/></mxCell><mxCell id="5Conc50" value="direct — no matching needed" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1052" width="300" height="32" as="geometry"/></mxCell><mxCell id="5Conc51" value="&lt;font face='Courier New'&gt;commit_in_pr&lt;/font&gt;, &lt;font face='Courier New'&gt;pr_closes_issue&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="660" y="1052" width="200" height="32" as="geometry"/></mxCell><mxCell id="5Conc52" value="1.0" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="860" y="1052" width="100" height="32" as="geometry"/></mxCell><mxCell id="5Conc53" value="URL to a known document" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1084" width="300" height="28" as="geometry"/></mxCell><mxCell id="5Conc54" value="exact URL match (indexed)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1084" width="300" height="28" as="geometry"/></mxCell><mxCell id="5Conc55" value="&lt;font face='Courier New'&gt;references_doc&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="660" y="1084" width="200" height="28" as="geometry"/></mxCell><mxCell id="5Conc56" value="1.0" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="860" y="1084" width="100" height="28" as="geometry"/></mxCell><mxCell id="5Conc57" value="commit SHA in text" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1112" width="300" height="28" as="geometry"/></mxCell><mxCell id="5Conc58" value="prefix match vs ingested commits" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1112" width="300" height="28" as="geometry"/></mxCell><mxCell id="5Conc59" value="&lt;font face='Courier New'&gt;mentions_commit&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="660" y="1112" width="200" height="28" as="geometry"/></mxCell><mxCell id="5Conc60" value="0.9" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="860" y="1112" width="100" height="28" as="geometry"/></mxCell><mxCell id="5Conc61" value="ticket key &lt;font face='Courier New'&gt;PROJ-123&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1140" width="300" height="28" as="geometry"/></mxCell><mxCell id="5Conc62" value="key match vs ingested tickets/issues" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1140" width="300" height="28" as="geometry"/></mxCell><mxCell id="5Conc63" value="&lt;font face='Courier New'&gt;references_doc&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="660" y="1140" width="200" height="28" as="geometry"/></mxCell><mxCell id="5Conc64" value="0.9" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="860" y="1140" width="100" height="28" as="geometry"/></mxCell><mxCell id="5Conc65" value="'supersedes' / 'replaced by' phrase + resolved ref (ADR-style text)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1168" width="300" height="40" as="geometry"/></mxCell><mxCell id="5Conc66" value="pattern + ref resolution" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1168" width="300" height="40" as="geometry"/></mxCell><mxCell id="5Conc67" value="&lt;font face='Courier New'&gt;supersedes&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="660" y="1168" width="200" height="40" as="geometry"/></mxCell><mxCell id="5Conc68" value="0.8" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="860" y="1168" width="100" height="40" as="geometry"/></mxCell><mxCell id="5Conc69" value="file path in text" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1208" width="300" height="28" as="geometry"/></mxCell><mxCell id="5Conc70" value="path match vs workspace repos" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1208" width="300" height="28" as="geometry"/></mxCell><mxCell id="5Conc71" value="&lt;font face='Courier New'&gt;mentions_path&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="660" y="1208" width="200" height="28" as="geometry"/></mxCell><mxCell id="5Conc72" value="0.7" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="860" y="1208" width="100" height="28" as="geometry"/></mxCell><mxCell id="5Conc73" value="&lt;b&gt;Resolver invariants&lt;/b&gt;&lt;br&gt;• Unresolved refs stay in &lt;font face='Courier New'&gt;pending_refs&lt;/font&gt; and are retried every round — a Notion page linked from a PR may be ingested &lt;i&gt;after&lt;/i&gt; the PR; the edge appears once both sides exist.&lt;br&gt;• Resolution is idempotent (&lt;font face='Courier New'&gt;INSERT OR IGNORE&lt;/font&gt; semantics) — re-running a round never duplicates edges.&lt;br&gt;• Direction is never guessed: &lt;font face='Courier New'&gt;Src&lt;/font&gt; = the document whose body contained the ref, &lt;font face='Courier New'&gt;Dst&lt;/font&gt; = the referenced document. The resolver always knows which body it came from.&lt;br&gt;• Confidence &lt;b&gt;multiplies&lt;/b&gt; along a walked path, so a 0.7 path-mention two hops out prunes itself below the 0.3 floor." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="1270" width="900" height="140" as="geometry"/></mxCell><mxCell id="5Conc74" value="&lt;b&gt;Rate limits &amp; backfill — the stress case is the first sync&lt;/b&gt;&lt;br&gt;• GraphQL batching (GitHub) — fewer round-trips per object graph&lt;br&gt;• batch-level cursor checkpoints ⇒ interruptible and resumable everywhere&lt;br&gt;• respect &lt;font face='Courier New'&gt;Retry-After&lt;/font&gt; and secondary-limit headers with exponential backoff&lt;br&gt;• per-connector concurrency of 1 in v1 (simple, sufficient)&lt;br&gt;• Jira / Notion pagination is slow ⇒ project + subtree scoping keeps backfill bounded" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1000" y="990" width="660" height="150" as="geometry"/></mxCell><mxCell id="5Conc75" value="&lt;b&gt;Plugin tier, shipped (D10, Δ18 to Δ24)&lt;/b&gt;&lt;br&gt;Sources, model providers and code access are three plugin kinds over one registry, one manifest contract and one configuration format (docs/v3/08-extensibility.md).&lt;br&gt;&lt;b&gt;Compiled&lt;/b&gt;: registered in the composition root &lt;font face='Courier New'&gt;cmd/lore/main.go&lt;/font&gt;, which passes &lt;font face='Courier New'&gt;plugins.Official()&lt;/font&gt;, the nine official plugins. &lt;font face='Courier New'&gt;lore build --with&lt;/font&gt; generates a root of the same shape (internal/plugbuild).&lt;br&gt;&lt;b&gt;External&lt;/b&gt;: a separate binary speaking one JSON object per line over stdio (docs/v3/09-plugin-protocol.md), declared under &lt;font face='Courier New'&gt;plugins:&lt;/font&gt; and resolved by coordinate (internal/plugindist). Any language, no rebuild.&lt;br&gt;Both arrive as &lt;font face='Courier New'&gt;lore.Connector&lt;/font&gt; / &lt;font face='Courier New'&gt;lore.Provider&lt;/font&gt; / &lt;font face='Courier New'&gt;lore.CodeRepo&lt;/font&gt; values, so the services layer never learns which mode a plugin came from (internal/di/external.go, newWorkspaceRegistry).&lt;br&gt;One process per operation: &lt;font face='Courier New'&gt;Changes&lt;/font&gt; dials, streams, and shuts the process down on &lt;font face='Courier New'&gt;done&lt;/font&gt;, or terminates it when the host abandons the stream (internal/plugexec/connector.go).&lt;br&gt;Sync is I/O bound, so the subprocess boundary costs nothing measurable against network round-trips." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="1160" width="660" height="300" as="geometry"/></mxCell><mxCell id="5Conc76" value="&lt;b&gt;Plugin trust model (docs/v3/10-plugin-distribution.md)&lt;/b&gt;&lt;br&gt;An external plugin is a subprocess with the user's privileges, holding its source's token, so invariant 5, read-only, is a promise by its author and not an engine guarantee.&lt;br&gt;Three mitigations exist in the code:&lt;br&gt;• &lt;b&gt;per-instance secrets&lt;/b&gt;: resolveSecrets (internal/registry/secrets.go) passes only the secrets the manifest declared, each read from the variable the operator's &lt;font face='Courier New'&gt;with:&lt;/font&gt; entry names. A plugin registered through RegisterExternal cannot fall back to a &lt;font face='Courier New'&gt;DefaultEnv&lt;/font&gt; of its own, which a compiled one can, and minimalEnv (internal/plugexec/env.go) gives the subprocess an empty environment, on Windows only the variables the loader and runtime need.&lt;br&gt;• &lt;b&gt;digest pinning&lt;/b&gt;: Install (internal/plugindist/install.go) refuses an artifact whose digest differs from the &lt;font face='Courier New'&gt;lore.lock&lt;/font&gt; entry, and Store.Binary (internal/plugindist/store.go) re-hashes the binary on disk before launch. A local &lt;font face='Courier New'&gt;from:&lt;/font&gt; is unpinned by construction and warns at startup.&lt;br&gt;• &lt;b&gt;signature verification&lt;/b&gt;: for a remote coordinate declaring &lt;font face='Courier New'&gt;pubkey:&lt;/font&gt;, Installer.expected verifies the signature before any digest is compared. On a local &lt;font face='Courier New'&gt;from:&lt;/font&gt; it is never consulted.&lt;br&gt;&lt;b&gt;Nothing confines the process.&lt;/b&gt; spawn (internal/plugexec/session.go) is exec.Command on the plugin binary. A WebAssembly runtime is an idea and not a tier of this system." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1700" y="990" width="600" height="240" as="geometry"/></mxCell><mxCell id="5Conc77" value="&lt;b&gt;Sync observability&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;sync_status&lt;/font&gt; (MCP) / &lt;font face='Courier New'&gt;lore status&lt;/font&gt; (CLI) / &lt;font face='Courier New'&gt;SyncService.Status&lt;/font&gt; (gRPC) report:&lt;br&gt;last run per connector · cursor ages · document + edge counts · lock state.&lt;br&gt;&lt;font face='Courier New'&gt;SyncService.Watch&lt;/font&gt; streams live per-connector phase, counts, and errors —&lt;br&gt;the progress feed a future web UI renders." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1700" y="1250" width="600" height="250" as="geometry"/></mxCell><mxCell id="5Cone78" value="acquired" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="5Conc32" target="5Conc34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="5Conc33" target="5Conc34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1600" y="851"/><mxPoint x="1600" y="792"/></Array></mxGeometry></mxCell><mxCell id="5Cone80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5Conc34" target="5Conc35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5Conc35" target="5Conc36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p7" name="7 · Request Flows"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3160" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7Reqc1" value="REQUEST FLOWS — four end-to-end walkthroughs, step by step" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="36" as="geometry"/></mxCell><mxCell id="7Reqc2" value="docs/v3/02 (request flows) + 05 (tool algorithms). Colour = the layer that owns the step: blue transport · green service · yellow repository/storage · orange connector · red precondition or honesty step." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1700" height="40" as="geometry"/></mxCell><mxCell id="7Reqc3" value="A · MCP · ask-only workspace (Jira + Notion, ZERO repos)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="700" height="26" as="geometry"/></mxCell><mxCell id="7Reqc4" value="&lt;font face='Courier New'&gt;find_decision(&quot;why did we choose option B instead of A?&quot;, around=&quot;incident X&quot;)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="138" width="700" height="40" as="geometry"/></mxCell><mxCell id="7Reqc5" value="&lt;b&gt;1 · AI host → MCP stdio&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;tools/call find_decision{question, around}&lt;/font&gt;&lt;br&gt;client HAS a brain ⇒ it wants evidence, not prose" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="184" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqc6" value="&lt;b&gt;2 · MCP transport → service&lt;/b&gt;&lt;br&gt;parse + JSON-schema validate, map nothing else;&lt;br&gt;&lt;font face='Courier New'&gt;QueryService.FindDecision(req)&lt;/font&gt; with synthesize=false" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="264" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc5" target="7Reqc6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc8" value="&lt;b&gt;3 · Service validation&lt;/b&gt;&lt;br&gt;workspace initialized · embedder identity in &lt;font face='Courier New'&gt;meta&lt;/font&gt; == config&lt;br&gt;no repo requirement on this path, ever (D4)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="344" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc6" target="7Reqc8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc10" value="&lt;b&gt;4 · Event resolution of 'incident X'&lt;/b&gt;&lt;br&gt;hybrid retrieval of the event text → top hits' CreatedAt agree&lt;br&gt;⇒ anchor 2025-03-12 via INC-201, window = anchor ± 30d" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="424" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc8" target="7Reqc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc12" value="&lt;b&gt;5 · Embedder.Embed(question)&lt;/b&gt;&lt;br&gt;one call; OpenAI default, or local Ollama" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="504" width="700" height="50" as="geometry"/></mxCell><mxCell id="7Reqe13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc10" target="7Reqc12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc14" value="&lt;b&gt;6 · Two ranked lists from the store&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;SearchLexical&lt;/font&gt; (BM25/FTS5) + &lt;font face='Courier New'&gt;SearchVector&lt;/font&gt; (sqlite-vec KNN)&lt;br&gt;filters pushed into SQL: created_at ∈ window, source, doc_type" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="568" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc12" target="7Reqc14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc16" value="&lt;b&gt;7 · RRF fusion in Go, then lift&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;score = Σ 1/(60 + rank_i)&lt;/font&gt;&lt;br&gt;top-k chunks → parent documents = the seed set" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="648" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc14" target="7Reqc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc18" value="&lt;b&gt;8 · Graph walk&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Neighbors(seeds, kinds, DirBoth)&lt;/font&gt;, BFS depth ≤ 3, cycle-guarded&lt;br&gt;confidence multiplied along paths, tails below 0.3 pruned" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="728" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc16" target="7Reqc18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc20" value="&lt;b&gt;9 · Rank&lt;/b&gt;&lt;br&gt;proximity × path confidence × question relevance ×&lt;br&gt;&lt;b&gt;window proximity&lt;/b&gt; (not recency — the query is time-anchored)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="808" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc18" target="7Reqc20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc22" value="&lt;b&gt;10 · Assemble bundle&lt;/b&gt;&lt;br&gt;Chains: INC-201 → decision page → PR #482 → commit a1b2c3&lt;br&gt;Nodes: roles seed / linked_ticket / design_doc / linked_change&lt;br&gt;Gaps: 'PROJ-4521 stands alone; no linked discussion'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="888" width="700" height="82" as="geometry"/></mxCell><mxCell id="7Reqe23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc20" target="7Reqc22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc24" value="&lt;b&gt;11 · Return EvidenceBundle as-is&lt;/b&gt;&lt;br&gt;structured JSON; every node carries a real URL&lt;br&gt;zero LLM key needed on the server (D1)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="984" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc22" target="7Reqc24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc26" value="&lt;b&gt;12 · AI synthesizes in its own context&lt;/b&gt;&lt;br&gt;may immediately chain &lt;font face='Courier New'&gt;impact_of(decision page)&lt;/font&gt; or &lt;font face='Courier New'&gt;trace(PR #482)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="1064" width="700" height="50" as="geometry"/></mxCell><mxCell id="7Reqe27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc24" target="7Reqc26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc28" value="&lt;b&gt;Why retrieval seeding matters here&lt;/b&gt;&lt;br&gt;The walk alone would never surface documents that discuss the &lt;b&gt;rejected&lt;/b&gt;&lt;br&gt;alternative A — nothing links to a road not taken. Lexical + semantic&lt;br&gt;seeding does, which is exactly what pure graph tools miss." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="1138" width="700" height="90" as="geometry"/></mxCell><mxCell id="7Reqc29" value="B · MCP · code-anchored workspace" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="700" height="26" as="geometry"/></mxCell><mxCell id="7Reqc30" value="&lt;font face='Courier New'&gt;why(repo=&quot;acme/myproject&quot;, file=&quot;internal/auth/auth.go&quot;, line_start=40, line_end=55)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="820" y="138" width="700" height="40" as="geometry"/></mxCell><mxCell id="7Reqc31" value="&lt;b&gt;1 · AI host → MCP&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;tools/call why{repo, file, line_start, line_end, question?}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="184" width="700" height="50" as="geometry"/></mxCell><mxCell id="7Reqc32" value="&lt;b&gt;2 · Precondition gate&lt;/b&gt;&lt;br&gt;≥ 1 repo registered — else precondition error 'no repositories&lt;br&gt;registered — code anchoring disabled for this workspace' (Δ2).&lt;br&gt;Then: file exists at HEAD, line span valid." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="820" y="248" width="700" height="82" as="geometry"/></mxCell><mxCell id="7Reqe33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc31" target="7Reqc32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc34" value="&lt;b&gt;3 · GitRepo.Blame(path, 40, 55)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;git blame --porcelain&lt;/font&gt; on the &lt;b&gt;local clone&lt;/b&gt; — ground truth for&lt;br&gt;line attribution → contributing commit SHAs per line" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="820" y="344" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc32" target="7Reqc34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc36" value="&lt;b&gt;4 · Blamed SHAs → seed documents&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;ResolveRef(sha)&lt;/font&gt; via the indexed &lt;font face='Courier New'&gt;sha_prefix&lt;/font&gt; column&lt;br&gt;unmatched SHA (commit not ingested) ⇒ recorded as a Gap" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="424" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc34" target="7Reqc36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc38" value="&lt;b&gt;5 · Walk the enrichment layers&lt;/b&gt;&lt;br&gt;commit —&lt;font face='Courier New'&gt;commit_in_pr&lt;/font&gt;→ PR —review→ review threads&lt;br&gt;PR —&lt;font face='Courier New'&gt;pr_closes_issue&lt;/font&gt;→ issue/ticket —&lt;font face='Courier New'&gt;references_doc&lt;/font&gt;→ Notion page" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="504" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc36" target="7Reqc38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc40" value="&lt;b&gt;6 · Semantic expansion&lt;/b&gt;&lt;br&gt;embed(question + blamed code span + commit subjects) → hybrid&lt;br&gt;retrieval over decision-type docs; drop nodes the walk already&lt;br&gt;found; keep top-k as &lt;font face='Courier New'&gt;semantic_match&lt;/font&gt; (never-linked discussions)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="820" y="584" width="700" height="82" as="geometry"/></mxCell><mxCell id="7Reqe41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc38" target="7Reqc40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc42" value="&lt;b&gt;7 · Rank + Chains + Gaps&lt;/b&gt;&lt;br&gt;identical shared machinery; roles: &lt;font face='Courier New'&gt;blamed_commit&lt;/font&gt;,&lt;br&gt;&lt;font face='Courier New'&gt;review_thread&lt;/font&gt;, &lt;font face='Courier New'&gt;linked_ticket&lt;/font&gt;, &lt;font face='Courier New'&gt;design_doc&lt;/font&gt;, &lt;font face='Courier New'&gt;semantic_match&lt;/font&gt;&lt;br&gt;typical gap: 'commit a1b2c3 has no PR — direct push'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="820" y="680" width="700" height="82" as="geometry"/></mxCell><mxCell id="7Reqe43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc40" target="7Reqc42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc44" value="&lt;b&gt;8 · EvidenceBundle back to the AI&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Anchor.Kind = code_span&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Anchor.Code = {repo, file, 40–55, blamed SHAs}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="776" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc42" target="7Reqc44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc46" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• &lt;font face='Courier New'&gt;question&lt;/font&gt; is optional: blame + walk need only the line span. Absent ⇒&lt;br&gt;  defaults to 'why does &amp;lt;file&amp;gt;:&amp;lt;L1&amp;gt;-&amp;lt;L2&amp;gt; exist in its current form'.&lt;br&gt;• &lt;font face='Courier New'&gt;history_of(path)&lt;/font&gt; is the same shape with &lt;font face='Courier New'&gt;git log --follow&lt;/font&gt; as the seed&lt;br&gt;  (rename-aware), 1 hop per commit, chronological output, windowed by&lt;br&gt;  &lt;font face='Courier New'&gt;limit&lt;/font&gt; + &lt;font face='Courier New'&gt;before&lt;/font&gt;.&lt;br&gt;• GitHub enrichment is matched to the clone through &lt;font face='Courier New'&gt;repos[].remote&lt;/font&gt;; a clone&lt;br&gt;  with no matching source still blames, but chains stop at the commit layer&lt;br&gt;  (startup warning, not an error)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="820" y="866" width="700" height="150" as="geometry"/></mxCell><mxCell id="7Reqc47" value="C · Non-AI path · CLI / gRPC with synthesis" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1580" y="110" width="700" height="26" as="geometry"/></mxCell><mxCell id="7Reqc48" value="&lt;font face='Courier New'&gt;lore ask &quot;why B over A?&quot; --around &quot;incident X&quot; --explain&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1580" y="138" width="700" height="40" as="geometry"/></mxCell><mxCell id="7Reqc49" value="&lt;b&gt;1 · Human → CLI&lt;/b&gt;&lt;br&gt;client has NO brain ⇒ it wants prose with citations&lt;br&gt;&lt;font face='Courier New'&gt;lore ask&lt;/font&gt; maps to &lt;font face='Courier New'&gt;find_decision&lt;/font&gt; (Δ15)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1580" y="184" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqc50" value="&lt;b&gt;2 · CLI → QueryService&lt;/b&gt;&lt;br&gt;same request type, &lt;b&gt;synthesize=true&lt;/b&gt; — a toggle, not a fork (D2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1580" y="264" width="700" height="50" as="geometry"/></mxCell><mxCell id="7Reqe51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc49" target="7Reqc50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc52" value="&lt;b&gt;3 · Identical pipeline as flow A&lt;/b&gt;&lt;br&gt;resolve anchor → seed → walk → expand → rank → EvidenceBundle&lt;br&gt;not one line of the engine differs between AI and non-AI surfaces" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1580" y="328" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc50" target="7Reqc52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc54" value="&lt;b&gt;4 · SynthesisService.Synthesize(bundle, question)&lt;/b&gt;&lt;br&gt;system prompt: answer ONLY from the evidence, cite the node URL&lt;br&gt;for every claim, state gaps explicitly, respect timeline ordering" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1580" y="408" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc52" target="7Reqc54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc56" value="&lt;b&gt;5 · LLMConnector.Complete(system, user)&lt;/b&gt;&lt;br&gt;provider from &lt;font face='Courier New'&gt;llm:&lt;/font&gt; config — openai | anthropic | zai | ollama&lt;br&gt;missing config ⇒ clear error naming the remedy (MCP unaffected)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1580" y="488" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc54" target="7Reqc56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc58" value="&lt;b&gt;6 · Render&lt;/b&gt;&lt;br&gt;CLI: markdown prose + inline [n] citations + source list&lt;br&gt;&lt;font face='Courier New'&gt;--raw&lt;/font&gt; ⇒ the bundle instead (pretty tree, or JSON for scripting)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1580" y="568" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc56" target="7Reqc58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc60" value="&lt;b&gt;7 · gRPC variant&lt;/b&gt;&lt;br&gt;the response carries the raw bundle &lt;b&gt;and&lt;/b&gt; the optional synthesis:&lt;br&gt;the future web UI renders the provenance graph from Nodes + Chains&lt;br&gt;and the prose from synthesis — no core change needed (D5)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1580" y="648" width="700" height="82" as="geometry"/></mxCell><mxCell id="7Reqe61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc58" target="7Reqc60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc62" value="&lt;b&gt;Synthesize defaults per surface (D2)&lt;/b&gt;&lt;br&gt;MCP stdio / Streamable HTTP → &lt;font face='Courier New'&gt;false&lt;/font&gt; (the host model synthesizes; no override)&lt;br&gt;CLI → &lt;font face='Courier New'&gt;true&lt;/font&gt; for &lt;font face='Courier New'&gt;lore ask&lt;/font&gt; and &lt;font face='Courier New'&gt;--explain&lt;/font&gt;; raw pretty-print otherwise; &lt;font face='Courier New'&gt;--raw&lt;/font&gt; forces raw&lt;br&gt;gRPC → &lt;font face='Courier New'&gt;true&lt;/font&gt;; &lt;font face='Courier New'&gt;FindDecision{synthesize:false}&lt;/font&gt; for e.g. UI graph rendering&lt;br&gt;&lt;br&gt;Careful with the word 'HTTP': MCP-over-Streamable-HTTP is on the &lt;b&gt;AI&lt;/b&gt; side;&lt;br&gt;gRPC and the future web UI are on the &lt;b&gt;non-AI&lt;/b&gt; side." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1580" y="754" width="700" height="130" as="geometry"/></mxCell><mxCell id="7Reqc63" value="D · &lt;font face='Courier New'&gt;impact_of&lt;/font&gt; — consequences, forward in time (Δ5)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="2340" y="110" width="700" height="26" as="geometry"/></mxCell><mxCell id="7Reqc64" value="&lt;font face='Courier New'&gt;impact_of(&quot;PROJ-4521&quot;)&lt;/font&gt; or &lt;font face='Courier New'&gt;impact_of(&quot;the retry backoff decision&quot;)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="2340" y="138" width="700" height="40" as="geometry"/></mxCell><mxCell id="7Reqc65" value="&lt;b&gt;1 · Resolve the anchor&lt;/b&gt;&lt;br&gt;a ref → &lt;font face='Courier New'&gt;ResolveRef&lt;/font&gt; (ambiguous ⇒ error listing candidates);&lt;br&gt;free text → retrieval, top document, interpretation recorded in&lt;br&gt;&lt;font face='Courier New'&gt;Anchor.Doc&lt;/font&gt;. Anchor time &lt;b&gt;T = Doc.CreatedAt&lt;/b&gt; (event time)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2340" y="184" width="700" height="82" as="geometry"/></mxCell><mxCell id="7Reqc66" value="&lt;b&gt;2 · Forward walk&lt;/b&gt;&lt;br&gt;traverse edges from the anchor both ways &lt;i&gt;mechanically&lt;/i&gt;, keep only&lt;br&gt;nodes with &lt;font face='Courier New'&gt;CreatedAt &amp;gt; T&lt;/font&gt;; depth ≤ 3&lt;br&gt;dominated by &lt;b&gt;incoming&lt;/b&gt; &lt;font face='Courier New'&gt;references_doc&lt;/font&gt; / &lt;font face='Courier New'&gt;mentions_commit&lt;/font&gt; edges&lt;br&gt;(later documents citing the decision) and &lt;font face='Courier New'&gt;supersedes&lt;/font&gt; chains" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2340" y="280" width="700" height="98" as="geometry"/></mxCell><mxCell id="7Reqe67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc65" target="7Reqc66"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc68" value="&lt;b&gt;3 · Semantic expansion, hard time filter&lt;/b&gt;&lt;br&gt;retrieval of the question (default: 'consequences, follow-ups,&lt;br&gt;incidents related to &amp;lt;anchor title&amp;gt;') + anchor excerpt, filtered&lt;br&gt;&lt;font face='Courier New'&gt;created_at &amp;gt; T&lt;/font&gt;; drop already-found nodes → &lt;font face='Courier New'&gt;semantic_match&lt;/font&gt;&lt;br&gt;catches the postmortem that never linked back" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2340" y="392" width="700" height="98" as="geometry"/></mxCell><mxCell id="7Reqe69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc66" target="7Reqc68"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc70" value="&lt;b&gt;4 · Return chronologically&lt;/b&gt;&lt;br&gt;a timeline, not a relevance list&lt;br&gt;Chains = anchor → follow-up paths" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2340" y="504" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc68" target="7Reqc70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc72" value="&lt;b&gt;5 · Gaps as a real answer&lt;/b&gt;&lt;br&gt;'no follow-up evidence after 2025-03-12' — itself useful output,&lt;br&gt;and honest instead of invented" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="2340" y="584" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc70" target="7Reqc72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc74" value="&lt;b&gt;Why no 'impact' edge kind exists&lt;/b&gt;&lt;br&gt;Impact = &lt;b&gt;direction + time&lt;/b&gt; over the edges that already exist. Incoming&lt;br&gt;references, filtered by &lt;font face='Courier New'&gt;CreatedAt &amp;gt; T&lt;/font&gt;, &lt;i&gt;are&lt;/i&gt; the consequences.&lt;br&gt;That is why &lt;font face='Courier New'&gt;Neighbors&lt;/font&gt; must take an explicit direction parameter (Δ12)&lt;br&gt;and why &lt;font face='Courier New'&gt;CreatedAt&lt;/font&gt; had to be added alongside &lt;font face='Courier New'&gt;UpdatedAt&lt;/font&gt; (Δ8).&lt;br&gt;&lt;br&gt;Open question (07 #3): whether &lt;font face='Courier New'&gt;impact_of&lt;/font&gt; should also accept an explicit&lt;br&gt;&lt;font face='Courier New'&gt;until&lt;/font&gt; for bounded windows ('what happened in the following quarter')." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2340" y="674" width="700" height="140" as="geometry"/></mxCell><mxCell id="7Reqc75" value="&lt;b&gt;Verb routing — spelled out in the MCP tool descriptions&lt;/b&gt;&lt;br&gt;&lt;b&gt;breadth&lt;/b&gt; → &lt;font face='Courier New'&gt;find_decision&lt;/font&gt; / &lt;font face='Courier New'&gt;why&lt;/font&gt;&lt;br&gt;&lt;b&gt;depth on one node&lt;/b&gt; → &lt;font face='Courier New'&gt;trace&lt;/font&gt;&lt;br&gt;&lt;b&gt;consequences&lt;/b&gt; → &lt;font face='Courier New'&gt;impact_of&lt;/font&gt;&lt;br&gt;&lt;b&gt;file evolution&lt;/b&gt; → &lt;font face='Courier New'&gt;history_of&lt;/font&gt;&lt;br&gt;Narrow verbs route better in LLM hosts than one modal tool with flags (Δ15)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="2340" y="834" width="700" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p8" name="8 · Interfaces &amp; Config"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2440" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7Intc1" value="INTERFACES &amp; CONFIG — five verbs over one bundle, four surfaces, one YAML with three independent axes" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="36" as="geometry"/></mxCell><mxCell id="7Intc2" value="docs/v3/06-interfaces-and-config.md. All MCP tools return structured EvidenceBundle JSON, never synthesized prose. Query tools carry readOnlyHint; only sync_now mutates local state — the index, never any source." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1700" height="40" as="geometry"/></mxCell><mxCell id="7Intc3" value="MCP TOOL SURFACE (stdio + Streamable HTTP · official Go MCP SDK)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="112" width="900" height="26" as="geometry"/></mxCell><mxCell id="7Intc4" value="Tool" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="60" y="146" width="170" height="26" as="geometry"/></mxCell><mxCell id="7Intc5" value="Input" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="230" y="146" width="400" height="26" as="geometry"/></mxCell><mxCell id="7Intc6" value="Returns" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="630" y="146" width="350" height="26" as="geometry"/></mxCell><mxCell id="7Intc7" value="&lt;font face='Courier New'&gt;find_decision&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="172" width="170" height="50" as="geometry"/></mxCell><mxCell id="7Intc8" value="&lt;font face='Courier New'&gt;question&lt;/font&gt;, optional &lt;font face='Courier New'&gt;around&lt;/font&gt; (event text or date), &lt;font face='Courier New'&gt;source&lt;/font&gt;, &lt;font face='Courier New'&gt;repo&lt;/font&gt;, &lt;font face='Courier New'&gt;doc_type&lt;/font&gt;, &lt;font face='Courier New'&gt;since&lt;/font&gt;, &lt;font face='Courier New'&gt;until&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="230" y="172" width="400" height="50" as="geometry"/></mxCell><mxCell id="7Intc9" value="EvidenceBundle seeded by retrieval; works with zero repos" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="630" y="172" width="350" height="50" as="geometry"/></mxCell><mxCell id="7Intc10" value="&lt;font face='Courier New'&gt;why&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="222" width="170" height="46" as="geometry"/></mxCell><mxCell id="7Intc11" value="&lt;font face='Courier New'&gt;repo&lt;/font&gt;, &lt;font face='Courier New'&gt;file&lt;/font&gt;, &lt;font face='Courier New'&gt;line_start&lt;/font&gt;, &lt;font face='Courier New'&gt;line_end&lt;/font&gt;, optional &lt;font face='Courier New'&gt;question&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="230" y="222" width="400" height="46" as="geometry"/></mxCell><mxCell id="7Intc12" value="EvidenceBundle anchored on blame; precondition error if no repos registered" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="630" y="222" width="350" height="46" as="geometry"/></mxCell><mxCell id="7Intc13" value="&lt;font face='Courier New'&gt;trace&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="268" width="170" height="46" as="geometry"/></mxCell><mxCell id="7Intc14" value="&lt;font face='Courier New'&gt;ref&lt;/font&gt; (SHA / PR# / ticket key / URL / DocID), optional &lt;font face='Courier New'&gt;direction&lt;/font&gt;, &lt;font face='Courier New'&gt;depth&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="230" y="268" width="400" height="46" as="geometry"/></mxCell><mxCell id="7Intc15" value="full provenance neighborhood + full body, chronological" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="630" y="268" width="350" height="46" as="geometry"/></mxCell><mxCell id="7Intc16" value="&lt;font face='Courier New'&gt;impact_of&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="314" width="170" height="34" as="geometry"/></mxCell><mxCell id="7Intc17" value="&lt;font face='Courier New'&gt;ref_or_query&lt;/font&gt;, optional &lt;font face='Courier New'&gt;question&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="230" y="314" width="400" height="34" as="geometry"/></mxCell><mxCell id="7Intc18" value="chronological impact timeline after the anchor decision" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="630" y="314" width="350" height="34" as="geometry"/></mxCell><mxCell id="7Intc19" value="&lt;font face='Courier New'&gt;history_of&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="348" width="170" height="46" as="geometry"/></mxCell><mxCell id="7Intc20" value="&lt;font face='Courier New'&gt;path&lt;/font&gt;, optional &lt;font face='Courier New'&gt;repo&lt;/font&gt;, &lt;font face='Courier New'&gt;limit&lt;/font&gt;, &lt;font face='Courier New'&gt;before&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="230" y="348" width="400" height="46" as="geometry"/></mxCell><mxCell id="7Intc21" value="chronological file timeline; precondition error if no repos registered" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="630" y="348" width="350" height="46" as="geometry"/></mxCell><mxCell id="7Intc22" value="&lt;font face='Courier New'&gt;sync_now&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="394" width="170" height="34" as="geometry"/></mxCell><mxCell id="7Intc23" value="optional &lt;font face='Courier New'&gt;source&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="230" y="394" width="400" height="34" as="geometry"/></mxCell><mxCell id="7Intc24" value="acknowledgment; errors if the sync lease is held" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="630" y="394" width="350" height="34" as="geometry"/></mxCell><mxCell id="7Intc25" value="&lt;font face='Courier New'&gt;sync_status&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="428" width="170" height="40" as="geometry"/></mxCell><mxCell id="7Intc26" value="—" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="230" y="428" width="400" height="40" as="geometry"/></mxCell><mxCell id="7Intc27" value="last run per connector, cursor ages, doc/edge counts, lock state" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="630" y="428" width="350" height="40" as="geometry"/></mxCell><mxCell id="7Intc28" value="&lt;b&gt;Tool-surface policy (D9 / Δ16)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;EvidenceBundle is the stable contract&lt;/b&gt;; tools are cheap, disposable verbs over it. Bundle changes are additive only.&lt;br&gt;• Descriptions spell out the division of labor so host models route well: breadth → &lt;font face='Courier New'&gt;find_decision&lt;/font&gt;/&lt;font face='Courier New'&gt;why&lt;/font&gt; · depth on one node → &lt;font face='Courier New'&gt;trace&lt;/font&gt; · consequences → &lt;font face='Courier New'&gt;impact_of&lt;/font&gt; · file evolution → &lt;font face='Courier New'&gt;history_of&lt;/font&gt;.&lt;br&gt;• &lt;b&gt;Deprecation happens in place&lt;/b&gt;: the old tool keeps its registration with a 'deprecated — use X' description for one release, then disappears. Host models follow the description automatically.&lt;br&gt;• Transports: &lt;font face='Courier New'&gt;lore mcp&lt;/font&gt; = stdio for local harnesses (Claude Code, Cursor, …) · &lt;font face='Courier New'&gt;lore serve&lt;/font&gt; = Streamable HTTP endpoint &lt;font face='Courier New'&gt;/mcp&lt;/font&gt; alongside gRPC." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="920" height="170" as="geometry"/></mxCell><mxCell id="7Intc29" value="CLI" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="400" height="26" as="geometry"/></mxCell><mxCell id="7Intc30" value="&lt;font face='Courier New'&gt;lore init                          # write a lore.yaml scaffold from the registered manifests&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore source add &amp;lt;plugin&amp;gt;           # append a source instance, prompting for its manifest fields&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore plugin list                   # what this build can use: NAME, KIND, ORIGIN, SUMMARY&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore plugin install [&amp;lt;name&amp;gt; | &amp;lt;coordinate&amp;gt;[@latest]]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore plugin update &amp;lt;name&amp;gt;[@&amp;lt;version&amp;gt;]   # the only command that rewrites a locked digest&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore plugin remove|verify &amp;lt;name&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore plugin search &amp;lt;query&amp;gt;          # query the plugin index&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore build --with &amp;lt;module&amp;gt;@&amp;lt;version&amp;gt; [-o lore]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore sync [--source=jira-acme] [--reembed]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore status                        # sync state, doc/edge counts, lock state&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore ask &quot;&amp;lt;question&amp;gt;&quot; [--around=&quot;incident X&quot;] [--since --until]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;                       [--source --repo --doc-type] [--raw]   # → find_decision&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore impact &amp;lt;ref | &quot;query&quot;&amp;gt; [--question=&quot;…&quot;]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore why &amp;lt;file&amp;gt;:&amp;lt;L1&amp;gt;[-&amp;lt;L2&amp;gt;] [&quot;question&quot;] [--repo=…]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore trace &amp;lt;ref&amp;gt; [--direction=in|out|both]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore history &amp;lt;path&amp;gt; [--repo=…] [--limit=N]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore mcp                           # MCP stdio server&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore serve [--http=:8080] [--grpc=:9090] [--mtls]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="722" width="920" height="300" as="geometry"/></mxCell><mxCell id="7Intc31" value="&lt;b&gt;Human-facing defaults&lt;/b&gt;&lt;br&gt;• &lt;font face='Courier New'&gt;why&lt;/font&gt; / &lt;font face='Courier New'&gt;trace&lt;/font&gt; / &lt;font face='Courier New'&gt;impact&lt;/font&gt; / &lt;font face='Courier New'&gt;history&lt;/font&gt; print the evidence timeline. &lt;font face='Courier New'&gt;--explain&lt;/font&gt; answers from it in prose, &lt;font face='Courier New'&gt;--raw&lt;/font&gt; emits the bundle as JSON for scripting (internal/transport/cli/render.go, evidenceOutput.emit).&lt;br&gt;• &lt;font face='Courier New'&gt;lore ask&lt;/font&gt; answers in prose by default, with &lt;font face='Courier New'&gt;--raw&lt;/font&gt; for the bundle. Prose goes through SynthesisService, so it needs the &lt;font face='Courier New'&gt;llm:&lt;/font&gt; block in lore.yaml." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1040" width="920" height="100" as="geometry"/></mxCell><mxCell id="7Intc32" value="gRPC — programmatic API &lt;font face='Courier New'&gt;lore.v1&lt;/font&gt; (NOT an MCP transport · D5)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1020" y="112" width="700" height="26" as="geometry"/></mxCell><mxCell id="7Intc33" value="&lt;font face='Courier New'&gt;service QueryService {&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  rpc FindDecision(FindDecisionRequest) returns (FindDecisionResponse);&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  rpc Why(WhyRequest)               returns (WhyResponse);&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  rpc Trace(TraceRequest)           returns (TraceResponse);&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  rpc ImpactOf(ImpactOfRequest)     returns (ImpactOfResponse);&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  rpc HistoryOf(HistoryOfRequest)   returns (HistoryOfResponse);&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;service SyncService {&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  rpc Trigger(TriggerRequest) returns (TriggerResponse); // errors if lock held&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  rpc Status(StatusRequest)   returns (StatusResponse);&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  rpc Watch(WatchRequest)     returns (stream SyncEvent); // live per-connector&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}                                                       // phase, counts, errors&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1020" y="146" width="700" height="200" as="geometry"/></mxCell><mxCell id="7Intc34" value="&lt;b&gt;Surface semantics&lt;/b&gt;&lt;br&gt;• every query request carries &lt;font face='Courier New'&gt;bool synthesize&lt;/font&gt; (default &lt;b&gt;true&lt;/b&gt; here)&lt;br&gt;• responses carry the raw &lt;b&gt;EvidenceBundle&lt;/b&gt; and optional &lt;b&gt;synthesis&lt;/b&gt; text — the web UI renders the provenance graph from the bundle and prose from the synthesis&lt;br&gt;• &lt;font face='Courier New'&gt;SyncService.Watch&lt;/font&gt; streams progress — the UI progress view depends on it" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1020" y="360" width="700" height="120" as="geometry"/></mxCell><mxCell id="7Intc35" value="&lt;b&gt;mTLS&lt;/b&gt;&lt;br&gt;• &lt;font face='Courier New'&gt;lore serve --mtls&lt;/font&gt;: TLS listener with &lt;b&gt;required client-certificate verification&lt;/b&gt; against a configured client CA (&lt;font face='Courier New'&gt;tls.RequireAndVerifyClientCert&lt;/font&gt;)&lt;br&gt;• config: server cert/key + client CA bundle paths in lore.yaml; &lt;font face='Courier New'&gt;make certs.dev&lt;/font&gt; generates a local CA + server/client certs for development&lt;br&gt;• &lt;b&gt;plain-TCP gRPC is allowed only on loopback&lt;/b&gt;; non-loopback binds without TLS are rejected at startup" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1020" y="496" width="700" height="150" as="geometry"/></mxCell><mxCell id="7Intc36" value="&lt;b&gt;Web UI (later — designed for, not built)&lt;/b&gt;&lt;br&gt;Consumes gRPC via grpc-web or a gateway. Planned views:&lt;br&gt;• provenance-graph explorer — renders &lt;font face='Courier New'&gt;Nodes&lt;/font&gt; + &lt;font face='Courier New'&gt;Chains&lt;/font&gt; directly from the bundle&lt;br&gt;• ask panel — synthesized answers + impact timelines&lt;br&gt;• sync dashboard — the &lt;font face='Courier New'&gt;Watch&lt;/font&gt; stream&lt;br&gt;No core changes required: this is exactly why the bundle/synthesis split exists on the gRPC surface." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1020" y="662" width="700" height="150" as="geometry"/></mxCell><mxCell id="7Intc37" value="&lt;b&gt;Security posture (06)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;read-only&lt;/b&gt; against all external sources; least-privilege tokens documented per source: GitHub fine-grained PAT read scopes · Notion integration scoped to a subtree · Jira API token with read-only project access&lt;br&gt;• secrets only via env vars — never written to lore.yaml, the index, or logs&lt;br&gt;• private data leaves the machine only toward the configured embedder/LLM — documented loudly; Ollama for both = fully local pipeline&lt;br&gt;• gRPC/HTTP off-loopback requires TLS; gRPC additionally supports mTLS" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1020" y="828" width="700" height="200" as="geometry"/></mxCell><mxCell id="7Intc38" value="&lt;font face='Courier New'&gt;lore.yaml&lt;/font&gt; — annotated reference (plugins / sources / repos, Δ9 + Δ19)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1760" y="112" width="640" height="26" as="geometry"/></mxCell><mxCell id="7Intc39" value="&lt;font face='Courier New'&gt;workspace: myproject&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;index_path: ~/.lore/myproject.db   # default ~/.lore/&amp;lt;workspace&amp;gt;.db&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;plugins:               # OPTIONAL — external plugin binaries; see 10&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  - name: linear&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    from: github.com/jdoe/lore-linear@v0.3.1&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;#   pubkey: ./keys/jdoe-lore.pub   # opt-in signature check&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;sources:               # instances, in sync order&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  - use: github        # id defaults to the plugin name&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    with:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;      token_env: LORE_GITHUB_TOKEN # env var NAME; value never stored&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;      repos: [acme/myproject, acme/myproject-infra]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  - use: notion&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    with:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;      token_env: LORE_NOTION_TOKEN&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;      root_pages: [&quot;Engineering Wiki&quot;]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  - id: jira-acme      # explicit id: two instances of one plugin&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    use: jira&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    with:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;      base_url: https://acme.atlassian.net&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;      email_env: LORE_JIRA_EMAIL&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;      token_env: LORE_JIRA_TOKEN&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;      projects: [PROJ, INFRA]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  - id: linear&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    use: linear        # external plugin, identical syntax&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    with: { team: PLATFORM, token_env: LORE_LINEAR_TOKEN }&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;providers:             # OPTIONAL — a role may bind a registered&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  - id: openrouter     # plugin that no providers: entry declares&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    use: openai-compatible&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    with:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;      base_url: https://openrouter.ai/api&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;      api_key_env: LORE_OPENROUTER_KEY&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;embedder:              # role binding: provider instance + model&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  provider: openai&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  model: text-embedding-3-small&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;# dimensions: 768      # REQUIRED for ollama, refused for openai&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;llm:                   # OPTIONAL — synthesis for CLI/gRPC only&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  provider: openrouter&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  model: moonshotai/kimi-k2&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;repos: []              # OPTIONAL — local clones, blame/log only.&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;# repos:               # Zero repos = ask-only; why/history_of&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;#   - path: ~/dev/myproject      # disabled, everything else works.&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;#     use: git         # defaults to the git plugin&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;#     remote: github:acme/myproject&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;query:                 # optional tuning; unset keys take defaults&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  event_window: 30d&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  walk_depth: 3&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  top_k: 12&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;scheduler:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  interval: 30m&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;server:                # used by `lore serve`&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  http_addr: &quot;:8080&quot;    # MCP Streamable HTTP&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  grpc_addr: &quot;:9090&quot;&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  mtls:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    cert: ./certs/server.pem&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    key: ./certs/server-key.pem&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    client_ca: ./certs/ca.pem&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1760" y="146" width="640" height="870" as="geometry"/></mxCell><mxCell id="7Intc40" value="&lt;b&gt;Validation at load&lt;/b&gt;&lt;br&gt;• unknown keys &lt;b&gt;rejected&lt;/b&gt; at the top level by the strict decoder, and inside &lt;font face='Courier New'&gt;with:&lt;/font&gt; against the manifest's declared fields and secret config keys (internal/registry/with.go, checkKeys). The plugin's own strict decoder never sees an unknown &lt;font face='Courier New'&gt;with:&lt;/font&gt; key, because configJSON hands it the declared fields only&lt;br&gt;• every &lt;font face='Courier New'&gt;use:&lt;/font&gt; resolves to a compiled plugin or a &lt;font face='Courier New'&gt;plugins:&lt;/font&gt; declaration. An unresolved one names what this build has and points at &lt;font face='Courier New'&gt;lore plugin list&lt;/font&gt; (internal/registry/build.go)&lt;br&gt;• duplicate instance ids rejected, and an id is required when one plugin is used twice (internal/config/validate.go, validateInstances)&lt;br&gt;• required manifest fields present, and a required list field declared empty refuses, because an empty list selects nothing (internal/registry/with.go, checkType)&lt;br&gt;• a secret the manifest does not mark optional needs a named variable holding a value. A plugin's own &lt;font face='Courier New'&gt;DefaultEnv&lt;/font&gt; applies only when that plugin is compiled into this binary (internal/registry/secrets.go, resolveSecrets)&lt;br&gt;• at least one of &lt;font face='Courier New'&gt;sources&lt;/font&gt; / &lt;font face='Courier New'&gt;repos&lt;/font&gt; non-empty&lt;br&gt;• &lt;font face='Courier New'&gt;repos[].remote&lt;/font&gt; naming no configured source is a startup &lt;b&gt;warning&lt;/b&gt;, not an error: blame still works, but chains stop at the commit layer. The claim is answered by a source implementing &lt;font face='Courier New'&gt;MatchesRemote&lt;/font&gt; (internal/registry/warnings.go, UnmatchedRemotes)&lt;br&gt;• a listen address that is not provably loopback must be served over TLS (internal/config/validate.go, ValidateListenAddr)&lt;br&gt;• embedder identity checked against the index &lt;font face='Courier New'&gt;meta&lt;/font&gt; each round (internal/services/sync.go, reconcileIdentity)&lt;br&gt;• declared external plugins are installed and digest-matched at startup, and nothing is fetched at load or sync time (internal/di/external.go, newExternals)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1760" y="1026" width="640" height="380" as="geometry"/></mxCell><mxCell id="7Intc41" value="&lt;b&gt;Plugin registry — what a &lt;font face='Courier New'&gt;use:&lt;/font&gt; may name&lt;/b&gt;&lt;br&gt;The registry is host-side and holds no list of its own (internal/registry/registry.go). Registration checks the name shape and uniqueness, &lt;font face='Courier New'&gt;api_version&lt;/font&gt;, the kind against the interfaces the value implements, and the field and secret declarations, so a plugin that misdeclares itself fails at registration rather than during a user's sync (CheckManifest, validateImplements).&lt;br&gt;Two doors: &lt;font face='Courier New'&gt;Register&lt;/font&gt; for a plugin compiled into this binary, &lt;font face='Courier New'&gt;RegisterExternal&lt;/font&gt; for one opened from a coordinate (internal/di/external.go, newWorkspaceRegistry). Only the compiled door lets a plugin's own &lt;font face='Courier New'&gt;DefaultEnv&lt;/font&gt; name a secret's variable (internal/registry/secrets.go, resolveSecrets).&lt;br&gt;An instance id is the cursor key, &lt;font face='Courier New'&gt;Document.Source&lt;/font&gt; and the &lt;font face='Courier New'&gt;DocID&lt;/font&gt; prefix, so the orchestrator fails a batch whose documents disagree with the instance that produced them (internal/services/sync.go, assertInstanceIdentity).&lt;br&gt;Registration order is load-bearing: &lt;font face='Courier New'&gt;lore init&lt;/font&gt; scaffolds from the first plugin of each kind that serves the role it needs (Registry.Starter, plugins.Official)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="1160" width="920" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p9" name="9 · Design Deltas (v1 → v3)"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="1740" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="10Dec1" value="DESIGN DELTAS — v1 → v3, with rationale" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="10Dec2" value="docs/v3/00-design-deltas.md. Driving requirement: v1 framed Lore as a &lt;i&gt;codebase&lt;/i&gt; provenance engine — the rich pipeline (graph walk, chains, gaps) existed only behind &lt;font face='Courier New'&gt;git blame&lt;/font&gt;. The product goal is broader: answer decision questions from Jira/Notion alone, with zero repositories configured. Code anchoring stays, as one anchor type among several. (v2 was abandoned research and contributed nothing.)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1900" height="40" as="geometry"/></mxCell><mxCell id="10Dec3" value="#" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="50" height="30" as="geometry"/></mxCell><mxCell id="10Dec4" value="Change" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="110" y="120" width="250" height="30" as="geometry"/></mxCell><mxCell id="10Dec5" value="Was (v1)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="470" height="30" as="geometry"/></mxCell><mxCell id="10Dec6" value="Now (v3)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="830" y="120" width="570" height="30" as="geometry"/></mxCell><mxCell id="10Dec7" value="Rationale" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1400" y="120" width="560" height="30" as="geometry"/></mxCell><mxCell id="10Dec8" value="Δ1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="50" height="46" as="geometry"/></mxCell><mxCell id="10Dec9" value="product framing" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="150" width="250" height="46" as="geometry"/></mxCell><mxCell id="10Dec10" value="'provenance engine for codebases; answers why &lt;i&gt;code&lt;/i&gt; exists'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="470" height="46" as="geometry"/></mxCell><mxCell id="10Dec11" value="decision-provenance engine; anchors = query, code span, document, time window" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="150" width="570" height="46" as="geometry"/></mxCell><mxCell id="10Dec12" value="framing drove design; every rich feature hung off &lt;font face='Courier New'&gt;git blame&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="150" width="560" height="46" as="geometry"/></mxCell><mxCell id="10Dec13" value="Δ2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="196" width="50" height="74" as="geometry"/></mxCell><mxCell id="10Dec14" value="zero-repo workspaces" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="196" width="250" height="74" as="geometry"/></mxCell><mxCell id="10Dec15" value="&lt;font face='Courier New'&gt;repos:&lt;/font&gt; implicitly required; &lt;font face='Courier New'&gt;why&lt;/font&gt; validation assumed a registered repo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="196" width="470" height="74" as="geometry"/></mxCell><mxCell id="10Dec16" value="&lt;font face='Courier New'&gt;repos:&lt;/font&gt; explicitly optional; workspace valid with none; &lt;font face='Courier New'&gt;why&lt;/font&gt;/&lt;font face='Courier New'&gt;history_of&lt;/font&gt; fail with a clear 'code anchoring disabled' error; all other tools unaffected" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="196" width="570" height="74" as="geometry"/></mxCell><mxCell id="10Dec17" value="ask-only (Jira/Notion) is a primary configuration" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="196" width="560" height="74" as="geometry"/></mxCell><mxCell id="10Dec18" value="Δ3" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="50" height="66" as="geometry"/></mxCell><mxCell id="10Dec19" value="pipeline asymmetry" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="270" width="250" height="66" as="geometry"/></mxCell><mxCell id="10Dec20" value="&lt;font face='Courier New'&gt;why&lt;/font&gt; got walk + chains + gaps; &lt;font face='Courier New'&gt;find_decision&lt;/font&gt; got retrieval + 1 hop, no chains, unspecified 'clustering'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="270" width="470" height="66" as="geometry"/></mxCell><mxCell id="10Dec21" value="one engine, four seed modes (retrieval / blame / ref / log); &lt;b&gt;every&lt;/b&gt; tool returns Chains + Gaps; clustering deleted" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="270" width="570" height="66" as="geometry"/></mxCell><mxCell id="10Dec22" value="the ask path — the primary path — received the weakest machinery" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="270" width="560" height="66" as="geometry"/></mxCell><mxCell id="10Dec23" value="Δ4" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="336" width="50" height="74" as="geometry"/></mxCell><mxCell id="10Dec24" value="event / time anchoring" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="336" width="250" height="74" as="geometry"/></mxCell><mxCell id="10Dec25" value="none; the agent had to guess dates" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="336" width="470" height="74" as="geometry"/></mxCell><mxCell id="10Dec26" value="&lt;font face='Courier New'&gt;find_decision&lt;/font&gt; takes &lt;font face='Courier New'&gt;around&lt;/font&gt; (free text or date) → event resolution → time window; ranking uses proximity-to-anchor instead of recency when anchored" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="336" width="570" height="74" as="geometry"/></mxCell><mxCell id="10Dec27" value="'when incident X happened' is unanswerable without it" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="336" width="560" height="74" as="geometry"/></mxCell><mxCell id="10Dec28" value="Δ5" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="50" height="74" as="geometry"/></mxCell><mxCell id="10Dec29" value="impact queries" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="410" width="250" height="74" as="geometry"/></mxCell><mxCell id="10Dec30" value="not expressible" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="410" width="470" height="74" as="geometry"/></mxCell><mxCell id="10Dec31" value="new &lt;font face='Courier New'&gt;impact_of&lt;/font&gt; tool: forward-in-time walk (incoming references after anchor time) + time-filtered semantic expansion, chronological timeline" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="410" width="570" height="74" as="geometry"/></mxCell><mxCell id="10Dec32" value="'what impact did we get?' is a target question. No new edge kinds needed — direction + time on existing edges" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="410" width="560" height="74" as="geometry"/></mxCell><mxCell id="10Dec33" value="Δ6" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="484" width="50" height="56" as="geometry"/></mxCell><mxCell id="10Dec34" value="Jira" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="484" width="250" height="56" as="geometry"/></mxCell><mxCell id="10Dec35" value="post-v1 aspiration" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="484" width="470" height="56" as="geometry"/></mxCell><mxCell id="10Dec36" value="v1 connector (Cloud: new &lt;font face='Courier New'&gt;/search/jql&lt;/font&gt; endpoint, &lt;font face='Courier New'&gt;updated&lt;/font&gt; watermark, ADF→text)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="484" width="570" height="56" as="geometry"/></mxCell><mxCell id="10Dec37" value="the ask-only scenario names Jira explicitly; ticket-key linking is the classic provenance case" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="484" width="560" height="56" as="geometry"/></mxCell><mxCell id="10Dec38" value="Δ7" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="50" height="40" as="geometry"/></mxCell><mxCell id="10Dec39" value="&lt;font face='Courier New'&gt;Anchor&lt;/font&gt; shape" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="540" width="250" height="40" as="geometry"/></mxCell><mxCell id="10Dec40" value="code-only (repo, file, lines, SHAs)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="540" width="470" height="40" as="geometry"/></mxCell><mxCell id="10Dec41" value="union: query / code span / document / time window" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="540" width="570" height="40" as="geometry"/></mxCell><mxCell id="10Dec42" value="generalizing later would break the bundle contract on every surface" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="540" width="560" height="40" as="geometry"/></mxCell><mxCell id="10Dec43" value="Δ8" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="50" height="66" as="geometry"/></mxCell><mxCell id="10Dec44" value="&lt;font face='Courier New'&gt;Document.CreatedAt&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="580" width="250" height="66" as="geometry"/></mxCell><mxCell id="10Dec45" value="only &lt;font face='Courier New'&gt;UpdatedAt&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="580" width="470" height="66" as="geometry"/></mxCell><mxCell id="10Dec46" value="both timestamps" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="580" width="570" height="66" as="geometry"/></mxCell><mxCell id="10Dec47" value="event time ≠ last-edit time. A postmortem edited yesterday still belongs to last year's incident. Timelines, event resolution, impact filtering all key on CreatedAt" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="580" width="560" height="66" as="geometry"/></mxCell><mxCell id="10Dec48" value="Δ9" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="646" width="50" height="66" as="geometry"/></mxCell><mxCell id="10Dec49" value="config conflation" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="646" width="250" height="66" as="geometry"/></mxCell><mxCell id="10Dec50" value="&lt;font face='Courier New'&gt;repos:&lt;/font&gt; doubled as GitHub ingest list (via &lt;font face='Courier New'&gt;remote:&lt;/font&gt;) and local-clone registry" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="646" width="470" height="66" as="geometry"/></mxCell><mxCell id="10Dec51" value="a source instance's own &lt;font face='Courier New'&gt;repos&lt;/font&gt; field (the github plugin's manifest) = what to ingest. Top-level &lt;font face='Courier New'&gt;repos:&lt;/font&gt; = local clones, for blame only" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="646" width="570" height="66" as="geometry"/></mxCell><mxCell id="10Dec52" value="zero-repo workspaces must still ingest GitHub; enrichment mapping via &lt;font face='Courier New'&gt;remote:&lt;/font&gt; when both exist" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="646" width="560" height="66" as="geometry"/></mxCell><mxCell id="10Dec53" value="Δ10" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="712" width="50" height="74" as="geometry"/></mxCell><mxCell id="10Dec54" value="&lt;font face='Courier New'&gt;Connector.Changes&lt;/font&gt; signature" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="712" width="250" height="74" as="geometry"/></mxCell><mxCell id="10Dec55" value="returned the final &lt;font face='Courier New'&gt;Cursor&lt;/font&gt; &lt;i&gt;before&lt;/i&gt; the stream was consumed — contradicted 'checkpoint every batch'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="712" width="470" height="74" as="geometry"/></mxCell><mxCell id="10Dec56" value="streams &lt;font face='Courier New'&gt;Batch{Docs, Cursor}&lt;/font&gt;; the orchestrator commits the batch, then persists its cursor" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="712" width="570" height="74" as="geometry"/></mxCell><mxCell id="10Dec57" value="the v1 signature made the documented crash-safe resume unimplementable" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="712" width="560" height="74" as="geometry"/></mxCell><mxCell id="10Dec58" value="Δ11" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="786" width="50" height="46" as="geometry"/></mxCell><mxCell id="10Dec59" value="&lt;font face='Courier New'&gt;authored_follow_up&lt;/font&gt; edge" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="786" width="250" height="46" as="geometry"/></mxCell><mxCell id="10Dec60" value="declared in &lt;font face='Courier New'&gt;EdgeKind&lt;/font&gt;, produced by nothing" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="786" width="470" height="46" as="geometry"/></mxCell><mxCell id="10Dec61" value="deleted; &lt;font face='Courier New'&gt;supersedes&lt;/font&gt; added (ADR 'supersedes' text pattern)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="786" width="570" height="46" as="geometry"/></mxCell><mxCell id="10Dec62" value="orphan removed; supersession is real signal for 'B instead of A' questions" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="786" width="560" height="46" as="geometry"/></mxCell><mxCell id="10Dec63" value="Δ12" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="832" width="50" height="46" as="geometry"/></mxCell><mxCell id="10Dec64" value="&lt;font face='Courier New'&gt;Neighbors&lt;/font&gt; direction" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="832" width="250" height="46" as="geometry"/></mxCell><mxCell id="10Dec65" value="unspecified (trace claimed 'both directions')" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="832" width="470" height="46" as="geometry"/></mxCell><mxCell id="10Dec66" value="explicit &lt;font face='Courier New'&gt;dir&lt;/font&gt; parameter (out / in / both) in the store contract" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="832" width="570" height="46" as="geometry"/></mxCell><mxCell id="10Dec67" value="impact walking requires incoming-edge traversal; contracts must say so" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="832" width="560" height="46" as="geometry"/></mxCell><mxCell id="10Dec68" value="Δ13" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="878" width="50" height="84" as="geometry"/></mxCell><mxCell id="10Dec69" value="SQLite build" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="878" width="250" height="84" as="geometry"/></mxCell><mxCell id="10Dec70" value="cgo (mattn) assumed; 'pure-Go fallback if pain appears'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="878" width="470" height="84" as="geometry"/></mxCell><mxCell id="10Dec71" value="default &lt;b&gt;ncruces/go-sqlite3 WASM&lt;/b&gt; bindings (pure Go, sqlite-vec embedded); cgo variant kept as a benchmark alternative behind the same interface" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="878" width="570" height="84" as="geometry"/></mxCell><mxCell id="10Dec72" value="official WASM bindings exist; removes the cross-compile risk instead of mitigating it" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="878" width="560" height="84" as="geometry"/></mxCell><mxCell id="10Dec73" value="Δ14" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="962" width="50" height="46" as="geometry"/></mxCell><mxCell id="10Dec74" value="milestone order" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="962" width="250" height="46" as="geometry"/></mxCell><mxCell id="10Dec75" value="blame-provenance at M2; Notion at M3; Jira absent" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="962" width="470" height="46" as="geometry"/></mxCell><mxCell id="10Dec76" value="ask-first: retrieval core → provenance engine → Notion + Jira → code anchoring" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="962" width="570" height="46" as="geometry"/></mxCell><mxCell id="10Dec77" value="ship the assistant before the code explorer; matches stated priority" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="962" width="560" height="46" as="geometry"/></mxCell><mxCell id="10Dec78" value="Δ15" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1008" width="50" height="84" as="geometry"/></mxCell><mxCell id="10Dec79" value="tool surface" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="1008" width="250" height="84" as="geometry"/></mxCell><mxCell id="10Dec80" value="&lt;font face='Courier New'&gt;find_decision&lt;/font&gt; returned flat clusters; no impact verb" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1008" width="470" height="84" as="geometry"/></mxCell><mxCell id="10Dec81" value="&lt;font face='Courier New'&gt;find_decision&lt;/font&gt; upgraded to the full engine; &lt;font face='Courier New'&gt;impact_of&lt;/font&gt; added as a narrow fifth verb; CLI &lt;font face='Courier New'&gt;lore ask&lt;/font&gt; still maps to &lt;font face='Courier New'&gt;find_decision&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="1008" width="570" height="84" as="geometry"/></mxCell><mxCell id="10Dec82" value="verb honesty: MCP returns evidence, not answers — a rename to &lt;font face='Courier New'&gt;ask&lt;/font&gt; was considered and rejected as overselling. Narrow verbs route better in LLM hosts than modal params" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="1008" width="560" height="84" as="geometry"/></mxCell><mxCell id="10Dec83" value="Δ16" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1092" width="50" height="56" as="geometry"/></mxCell><mxCell id="10Dec84" value="contract stability" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="1092" width="250" height="56" as="geometry"/></mxCell><mxCell id="10Dec85" value="implicit" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1092" width="470" height="56" as="geometry"/></mxCell><mxCell id="10Dec86" value="&lt;font face='Courier New'&gt;EvidenceBundle&lt;/font&gt; = the stable, additively-evolving contract; tools = disposable verbs with in-place MCP deprecation" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="1092" width="570" height="56" as="geometry"/></mxCell><mxCell id="10Dec87" value="changing param semantics silently breaks agent prompts; adding/retiring tools is cheap" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="1092" width="560" height="56" as="geometry"/></mxCell><mxCell id="10Dec88" value="Δ17" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1148" width="50" height="66" as="geometry"/></mxCell><mxCell id="10Dec89" value="plugin readiness" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="1148" width="250" height="66" as="geometry"/></mxCell><mxCell id="10Dec90" value="not considered" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1148" width="470" height="66" as="geometry"/></mxCell><mxCell id="10Dec91" value="connector seam kept plugin-viable by three disciplines (entities-only imports, additive schemas, conformance suite); plugin transport deferred. &lt;b&gt;Superseded by Δ18 to Δ24&lt;/b&gt;: the seam is now the shipped contract, and the transport it deferred is specified in 09, which is frozen and evolves additively" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="1148" width="570" height="66" as="geometry"/></mxCell><mxCell id="10Dec92" value="Δ10 is the cautionary tale: freezing a wire protocol before the contract stops moving turns fixes into ecosystem breaks" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="1148" width="560" height="66" as="geometry"/></mxCell><mxCell id="10Dec93" value="&lt;b&gt;Unchanged deliberately&lt;/b&gt;&lt;br&gt;• layering, FX wiring, error-handling policy, testing-strategy shape&lt;br&gt;• D1: MCP returns evidence, not prose; zero LLM key server-side&lt;br&gt;• synthesis as an optional final step for non-AI surfaces&lt;br&gt;• single SQLite file per workspace; RRF fusion in Go; store portability rules&lt;br&gt;• lease-lock sync (heartbeat + TTL takeover); read-only connectors; env-only secrets&lt;br&gt;• the &lt;font face='Courier New'&gt;Gaps&lt;/font&gt; honesty invariant — &lt;b&gt;extended&lt;/b&gt; to every tool rather than weakened" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1960" y="120" width="340" height="240" as="geometry"/></mxCell><mxCell id="10Dec94" value="&lt;b&gt;How to read this page&lt;/b&gt;&lt;br&gt;Each delta is a design decision with a paper trail. If code and these documents disagree, one of them is wrong — fix it through the same branch → PR workflow, never let them drift silently." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1960" y="380" width="340" height="140" as="geometry"/></mxCell><mxCell id="10Dec95" value="Δ18" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1214" width="50" height="66" as="geometry"/></mxCell><mxCell id="10Dec96" value="connector/provider construction" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="1214" width="250" height="66" as="geometry"/></mxCell><mxCell id="10Dec97" value="a hardcoded switch per source and per provider in the DI module, so adding either meant editing core" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1214" width="470" height="66" as="geometry"/></mxCell><mxCell id="10Dec98" value="plugin registry + manifest. The engine holds no source or provider name, and registration validates that a manifest matches what it built" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="1214" width="570" height="66" as="geometry"/></mxCell><mxCell id="10Dec99" value="'adding a source is one package' was true only if you were us" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="1214" width="560" height="66" as="geometry"/></mxCell><mxCell id="10Dec100" value="Δ19" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1280" width="50" height="66" as="geometry"/></mxCell><mxCell id="10Dec101" value="source configuration" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="1280" width="250" height="66" as="geometry"/></mxCell><mxCell id="10Dec102" value="closed &lt;font face='Courier New'&gt;sources:&lt;/font&gt; struct, one typed field per source, strict decode rejecting everything else" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1280" width="470" height="66" as="geometry"/></mxCell><mxCell id="10Dec103" value="&lt;font face='Courier New'&gt;sources:&lt;/font&gt; is a list of instances (&lt;font face='Courier New'&gt;id&lt;/font&gt; / &lt;font face='Courier New'&gt;use&lt;/font&gt; / &lt;font face='Courier New'&gt;with&lt;/font&gt;). The &lt;font face='Courier New'&gt;with:&lt;/font&gt; block is checked against the plugin's manifest and decoded strictly by the plugin" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="1280" width="570" height="66" as="geometry"/></mxCell><mxCell id="10Dec104" value="a config format that cannot express an unknown source cannot configure a plugin. Two instances of one plugin become expressible as a side effect" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="1280" width="560" height="66" as="geometry"/></mxCell><mxCell id="10Dec105" value="Δ20" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1346" width="50" height="66" as="geometry"/></mxCell><mxCell id="10Dec106" value="where implementations live" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="1346" width="250" height="66" as="geometry"/></mxCell><mxCell id="10Dec107" value="connectors and providers under &lt;font face='Courier New'&gt;internal/&lt;/font&gt;, unimportable by anyone" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1346" width="470" height="66" as="geometry"/></mxCell><mxCell id="10Dec108" value="&lt;font face='Courier New'&gt;sdk/&lt;/font&gt; (public contract, stdlib only) + &lt;font face='Courier New'&gt;plugins/&lt;/font&gt; (official plugins), both outside &lt;font face='Courier New'&gt;internal/&lt;/font&gt;, with the boundaries enforced by depguard" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="1346" width="570" height="66" as="geometry"/></mxCell><mxCell id="10Dec109" value="a plugin nobody can import is not a plugin. Official plugins hold no privilege a third party lacks" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="1346" width="560" height="66" as="geometry"/></mxCell><mxCell id="10Dec110" value="Δ21" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1412" width="50" height="66" as="geometry"/></mxCell><mxCell id="10Dec111" value="AI providers" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="1412" width="250" height="66" as="geometry"/></mxCell><mxCell id="10Dec112" value="one Go package per vendor (openai, anthropic, zai, ollama)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1412" width="470" height="66" as="geometry"/></mxCell><mxCell id="10Dec113" value="native drivers only where the wire format differs. Every OpenAI-compatible vendor is a preset row of one driver" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="1412" width="570" height="66" as="geometry"/></mxCell><mxCell id="10Dec114" value="the Z.AI package was a thin wrapper over the OpenAI client, configuration wearing a package costume" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="1412" width="560" height="66" as="geometry"/></mxCell><mxCell id="10Dec115" value="Δ22" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1478" width="50" height="66" as="geometry"/></mxCell><mxCell id="10Dec116" value="embedder identity" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="1478" width="250" height="66" as="geometry"/></mxCell><mxCell id="10Dec117" value="the provider self-reported &lt;font face='Courier New'&gt;provider/model/dims&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1478" width="470" height="66" as="geometry"/></mxCell><mxCell id="10Dec118" value="the plugin reports &lt;font face='Courier New'&gt;Dimensions()&lt;/font&gt;, and the host composes the identity from the manifest name, the configured model and that width" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="1478" width="570" height="66" as="geometry"/></mxCell><mxCell id="10Dec119" value="a plugin must not be able to claim another's vector space and silently poison an index" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="1478" width="560" height="66" as="geometry"/></mxCell><mxCell id="10Dec120" value="Δ23" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1544" width="50" height="66" as="geometry"/></mxCell><mxCell id="10Dec121" value="local git access" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="1544" width="250" height="66" as="geometry"/></mxCell><mxCell id="10Dec122" value="a bespoke interface, deliberately not a connector" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1544" width="470" height="66" as="geometry"/></mxCell><mxCell id="10Dec123" value="a third plugin kind (&lt;font face='Courier New'&gt;KindCode&lt;/font&gt;) behind the same registry and manifest" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="1544" width="570" height="66" as="geometry"/></mxCell><mxCell id="10Dec124" value="Mercurial, Jujutsu and remote forges are real alternative implementations of a small read-only contract" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="1544" width="560" height="66" as="geometry"/></mxCell><mxCell id="10Dec125" value="Δ24" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1610" width="50" height="66" as="geometry"/></mxCell><mxCell id="10Dec126" value="unknown &lt;font face='Courier New'&gt;RefKind&lt;/font&gt; from a connector" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="1610" width="250" height="66" as="geometry"/></mxCell><mxCell id="10Dec127" value="resolved to an empty rule, so every such reference vanished with no error" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1610" width="470" height="66" as="geometry"/></mxCell><mxCell id="10Dec128" value="rejected at ingest, naming the known kinds" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="1610" width="570" height="66" as="geometry"/></mxCell><mxCell id="10Dec129" value="silent drops are undebuggable for a plugin author. &lt;font face='Courier New'&gt;DocType&lt;/font&gt; stays open because unknown types degrade to ordinary evidence" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="1610" width="560" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p10" name="10 · Plugin Protocol"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="1290" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="11Ptc1" value="PLUGIN PROTOCOL — one JSON object per line over stdio, one request in flight, the batch is still the checkpoint" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="36" as="geometry"/></mxCell><mxCell id="11Ptc2" value="docs/v3/09-plugin-protocol.md. The host spawns the plugin binary and speaks NDJSON on its stdin and stdout (internal/plugexec/session.go, spawn and handshake). Every envelope carries &lt;font face='Courier New'&gt;v&lt;/font&gt; equal to &lt;font face='Courier New'&gt;lore.APIVersion&lt;/font&gt;, which is 1 (sdk/plugin.go). A manifest answering another number is refused at the handshake with both numbers named, and so is a response frame whose &lt;font face='Courier New'&gt;v&lt;/font&gt; differs (internal/plugexec/session.go, handshake and await). The frame and request types are &lt;font face='Courier New'&gt;sdk/wire&lt;/font&gt;, shared by host and SDK, so neither side hand-rolls the shape. The manifest the handshake returns is where every kind and capability below is declared: &lt;font face='Courier New'&gt;name&lt;/font&gt;, &lt;font face='Courier New'&gt;kind&lt;/font&gt;, &lt;font face='Courier New'&gt;api_version&lt;/font&gt;, &lt;font face='Courier New'&gt;summary&lt;/font&gt;, &lt;font face='Courier New'&gt;capabilities&lt;/font&gt;, &lt;font face='Courier New'&gt;fields&lt;/font&gt;, &lt;font face='Courier New'&gt;secrets&lt;/font&gt;, &lt;font face='Courier New'&gt;default_models&lt;/font&gt; (sdk/plugin.go, Manifest)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2240" height="76" as="geometry"/></mxCell><mxCell id="11Ptc3" value="TRANSPORT" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="640" height="26" as="geometry"/></mxCell><mxCell id="11Ptc4" value="Requests go to stdin, responses come back on stdout, one JSON object per line, UTF-8, newline-terminated.&lt;br&gt;• &lt;b&gt;stdout is protocol-only.&lt;/b&gt; A line that is not a frame fails the operation. There is no resynchronisation.&lt;br&gt;• &lt;b&gt;stderr is free-form&lt;/b&gt; and forwarded to the host logger at debug level, prefixed with the instance id (session.go, stderrLog.emit).&lt;br&gt;• &lt;b&gt;Line cap 8 MiB&lt;/b&gt; (&lt;font face='Courier New'&gt;sdk/wire&lt;/font&gt;, &lt;font face='Courier New'&gt;MaxLineBytes = 8 &amp;lt;&amp;lt; 20&lt;/font&gt;). A longer line fails the operation, so a batch too large to frame must be split into several &lt;font face='Courier New'&gt;batch&lt;/font&gt; frames. The batch is the checkpoint unit, so splitting is always legal.&lt;br&gt;• &lt;b&gt;Backpressure is the OS pipe.&lt;/b&gt; The host awaits the next frame only after the consumer has taken the previous batch (plugexec/connector.go, the yield in Changes).&lt;br&gt;• &lt;b&gt;One request in flight per process.&lt;/b&gt; Each request id is prefixed by a per-process random token, so a plugin cannot pass the correlation check with an id copied from an example (session.go, begin)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;" vertex="1" parent="1"><mxGeometry x="60" y="176" width="640" height="250" as="geometry"/></mxCell><mxCell id="11Ptc5" value="ENVELOPE" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="640" height="26" as="geometry"/></mxCell><mxCell id="11Ptc6" value="&lt;font face='Courier New'&gt;{ &quot;v&quot;: 1, &quot;id&quot;: &quot;7f3a&quot;, &quot;op&quot;: &quot;changes&quot;, &quot;instance&quot;: &quot;linear&quot;,&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  &quot;config&quot;: { &quot;teams&quot;: [&quot;CORE&quot;] }, &quot;secrets&quot;: { &quot;api_key&quot;: &quot;…&quot; },&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  &quot;cursor&quot;: { &quot;updated_after&quot;: &quot;2026-08-31T09:12:44Z&quot; } }&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;{ &quot;v&quot;: 1, &quot;id&quot;: &quot;7f3a&quot;, &quot;batch&quot;: { &quot;docs&quot;: [ … ],&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  &quot;cursor&quot;: { &quot;updated_after&quot;: &quot;2026-09-01T00:00:00Z&quot; } } }&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;{ &quot;v&quot;: 1, &quot;id&quot;: &quot;7f3a&quot;, &quot;done&quot;: true }&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;{ &quot;v&quot;: 1, &quot;id&quot;: &quot;7f3a&quot;, &quot;ok&quot;: true }&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;{ &quot;v&quot;: 1, &quot;id&quot;: &quot;7f3a&quot;, &quot;error&quot;: { &quot;message&quot;: &quot;…&quot;, &quot;kind&quot;: &quot;auth&quot; } }&lt;/font&gt;&lt;br&gt;The plugin echoes &lt;font face='Courier New'&gt;id&lt;/font&gt; verbatim on every frame it emits for that request, streamed frames included. Unknown fields are ignored in both directions, which is safe because the protocol evolves additively." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="476" width="640" height="180" as="geometry"/></mxCell><mxCell id="11Ptc7" value="ERRORS" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="640" height="26" as="geometry"/></mxCell><mxCell id="11Ptc8" value="Five kinds, and the host reads any other as &lt;font face='Courier New'&gt;internal&lt;/font&gt; quoting what the plugin sent (&lt;font face='Courier New'&gt;sdk/wire&lt;/font&gt;, KindInvalidConfig, KindAuth, KindRateLimit, KindNotFound, KindInternal).&lt;br&gt;The host action is the same for every kind: the instance fails for the round, and the next round asks from the last cursor the host committed. No kind delays the round, retries the operation or re-dials the plugin.&lt;br&gt;&lt;font face='Courier New'&gt;wire.Error&lt;/font&gt; holds &lt;font face='Courier New'&gt;message&lt;/font&gt; and &lt;font face='Courier New'&gt;kind&lt;/font&gt; and nothing else, so a &lt;font face='Courier New'&gt;retryable&lt;/font&gt; field a plugin sends is read by no one.&lt;br&gt;A non-zero exit is not a way to report a business error. It means the process died, and the host reports a crash naming the instance and the last op (session.go, crashed)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="696" width="640" height="230" as="geometry"/></mxCell><mxCell id="11Ptc9" value="CONFORMANCE — the suite official and third-party plugins share" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="940" width="640" height="26" as="geometry"/></mxCell><mxCell id="11Ptc10" value="&lt;font face='Courier New'&gt;sdk/conform&lt;/font&gt; checks a source against the contract, one named check each: a cursor on every batch, both timestamps set, every document fully identified, &lt;font face='Courier New'&gt;changes&lt;/font&gt; idempotent, resume from a mid-stream cursor, a stream that reaches completion, and an error that ends the stream (sdk/conform/conform.go).&lt;br&gt;&lt;font face='Courier New'&gt;lore plugin verify&lt;/font&gt; runs it against an installed binary through Certify (internal/plugexec/certify.go), which certifies a &lt;font face='Courier New'&gt;KindSource&lt;/font&gt; plugin and reports any other kind as never run.&lt;br&gt;An unconfigured plugin is judged on what its stream can show rather than failed for the configuration it was never given (certify.go, refusesWithoutConfiguration)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="976" width="640" height="230" as="geometry"/></mxCell><mxCell id="11Ptc11" value="OPERATIONS — the ops the host dispatches (sdk/wire)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="720" y="140" width="740" height="26" as="geometry"/></mxCell><mxCell id="11Ptc12" value="op" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="720" y="176" width="150" height="26" as="geometry"/></mxCell><mxCell id="11Ptc13" value="kind" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="870" y="176" width="180" height="26" as="geometry"/></mxCell><mxCell id="11Ptc14" value="payload" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1050" y="176" width="220" height="26" as="geometry"/></mxCell><mxCell id="11Ptc15" value="response" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1270" y="176" width="190" height="26" as="geometry"/></mxCell><mxCell id="11Ptc16" value="&lt;font face='Courier New'&gt;manifest&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="720" y="202" width="150" height="36" as="geometry"/></mxCell><mxCell id="11Ptc17" value="all" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="870" y="202" width="180" height="36" as="geometry"/></mxCell><mxCell id="11Ptc18" value="—" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1050" y="202" width="220" height="36" as="geometry"/></mxCell><mxCell id="11Ptc19" value="&lt;font face='Courier New'&gt;manifest&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1270" y="202" width="190" height="36" as="geometry"/></mxCell><mxCell id="11Ptc20" value="&lt;font face='Courier New'&gt;changes&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="720" y="238" width="150" height="36" as="geometry"/></mxCell><mxCell id="11Ptc21" value="&lt;font face='Courier New'&gt;KindSource&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="870" y="238" width="180" height="36" as="geometry"/></mxCell><mxCell id="11Ptc22" value="&lt;font face='Courier New'&gt;instance&lt;/font&gt;, &lt;font face='Courier New'&gt;config&lt;/font&gt;, &lt;font face='Courier New'&gt;secrets&lt;/font&gt;, &lt;font face='Courier New'&gt;cursor&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1050" y="238" width="220" height="36" as="geometry"/></mxCell><mxCell id="11Ptc23" value="&lt;font face='Courier New'&gt;batch&lt;/font&gt; frames, then &lt;font face='Courier New'&gt;done&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1270" y="238" width="190" height="36" as="geometry"/></mxCell><mxCell id="11Ptc24" value="&lt;font face='Courier New'&gt;matches_remote&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="720" y="274" width="150" height="36" as="geometry"/></mxCell><mxCell id="11Ptc25" value="&lt;font face='Courier New'&gt;KindSource&lt;/font&gt; (RepoRemotes)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="870" y="274" width="180" height="36" as="geometry"/></mxCell><mxCell id="11Ptc26" value="&lt;font face='Courier New'&gt;instance&lt;/font&gt;, &lt;font face='Courier New'&gt;config&lt;/font&gt;, &lt;font face='Courier New'&gt;secrets&lt;/font&gt;, &lt;font face='Courier New'&gt;remote&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1050" y="274" width="220" height="36" as="geometry"/></mxCell><mxCell id="11Ptc27" value="&lt;font face='Courier New'&gt;matches&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1270" y="274" width="190" height="36" as="geometry"/></mxCell><mxCell id="11Ptc28" value="&lt;font face='Courier New'&gt;embed&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="720" y="310" width="150" height="36" as="geometry"/></mxCell><mxCell id="11Ptc29" value="&lt;font face='Courier New'&gt;KindProvider&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="870" y="310" width="180" height="36" as="geometry"/></mxCell><mxCell id="11Ptc30" value="&lt;font face='Courier New'&gt;config&lt;/font&gt;, &lt;font face='Courier New'&gt;secrets&lt;/font&gt;, &lt;font face='Courier New'&gt;model&lt;/font&gt;, &lt;font face='Courier New'&gt;texts&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1050" y="310" width="220" height="36" as="geometry"/></mxCell><mxCell id="11Ptc31" value="&lt;font face='Courier New'&gt;vectors&lt;/font&gt;, &lt;font face='Courier New'&gt;dimensions&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1270" y="310" width="190" height="36" as="geometry"/></mxCell><mxCell id="11Ptc32" value="&lt;font face='Courier New'&gt;complete&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="720" y="346" width="150" height="36" as="geometry"/></mxCell><mxCell id="11Ptc33" value="&lt;font face='Courier New'&gt;KindProvider&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="870" y="346" width="180" height="36" as="geometry"/></mxCell><mxCell id="11Ptc34" value="&lt;font face='Courier New'&gt;config&lt;/font&gt;, &lt;font face='Courier New'&gt;secrets&lt;/font&gt;, &lt;font face='Courier New'&gt;model&lt;/font&gt;, &lt;font face='Courier New'&gt;system&lt;/font&gt;, &lt;font face='Courier New'&gt;user&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1050" y="346" width="220" height="36" as="geometry"/></mxCell><mxCell id="11Ptc35" value="&lt;font face='Courier New'&gt;text&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1270" y="346" width="190" height="36" as="geometry"/></mxCell><mxCell id="11Ptc36" value="&lt;font face='Courier New'&gt;blame&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="720" y="382" width="150" height="36" as="geometry"/></mxCell><mxCell id="11Ptc37" value="&lt;font face='Courier New'&gt;KindCode&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="870" y="382" width="180" height="36" as="geometry"/></mxCell><mxCell id="11Ptc38" value="&lt;font face='Courier New'&gt;path&lt;/font&gt;, &lt;font face='Courier New'&gt;start_line&lt;/font&gt;, &lt;font face='Courier New'&gt;end_line&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1050" y="382" width="220" height="36" as="geometry"/></mxCell><mxCell id="11Ptc39" value="&lt;font face='Courier New'&gt;spans&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1270" y="382" width="190" height="36" as="geometry"/></mxCell><mxCell id="11Ptc40" value="&lt;font face='Courier New'&gt;log&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="720" y="418" width="150" height="36" as="geometry"/></mxCell><mxCell id="11Ptc41" value="&lt;font face='Courier New'&gt;KindCode&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="870" y="418" width="180" height="36" as="geometry"/></mxCell><mxCell id="11Ptc42" value="&lt;font face='Courier New'&gt;path&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1050" y="418" width="220" height="36" as="geometry"/></mxCell><mxCell id="11Ptc43" value="&lt;font face='Courier New'&gt;commits&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1270" y="418" width="190" height="36" as="geometry"/></mxCell><mxCell id="11Ptc44" value="&lt;font face='Courier New'&gt;has_file&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="720" y="454" width="150" height="36" as="geometry"/></mxCell><mxCell id="11Ptc45" value="&lt;font face='Courier New'&gt;KindCode&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="870" y="454" width="180" height="36" as="geometry"/></mxCell><mxCell id="11Ptc46" value="&lt;font face='Courier New'&gt;path&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1050" y="454" width="220" height="36" as="geometry"/></mxCell><mxCell id="11Ptc47" value="&lt;font face='Courier New'&gt;present&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1270" y="454" width="190" height="36" as="geometry"/></mxCell><mxCell id="11Ptc48" value="&lt;font face='Courier New'&gt;shutdown&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="720" y="490" width="150" height="36" as="geometry"/></mxCell><mxCell id="11Ptc49" value="all" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="870" y="490" width="180" height="36" as="geometry"/></mxCell><mxCell id="11Ptc50" value="—" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1050" y="490" width="220" height="36" as="geometry"/></mxCell><mxCell id="11Ptc51" value="&lt;font face='Courier New'&gt;ok&lt;/font&gt;, then exit 0" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1270" y="490" width="190" height="36" as="geometry"/></mxCell><mxCell id="11Ptc52" value="&lt;b&gt;The &lt;font face='Courier New'&gt;changes&lt;/font&gt; stream — what the host refuses&lt;/b&gt;&lt;br&gt;Zero or more &lt;font face='Courier New'&gt;batch&lt;/font&gt; frames, then exactly one &lt;font face='Courier New'&gt;done&lt;/font&gt;. An empty cursor object means full backfill. The host commits a frame's documents and &lt;b&gt;then&lt;/b&gt; persists that frame's cursor, exactly as for a compiled connector.&lt;br&gt;Three frame shapes abort the stream (internal/plugexec/connector.go, Changes):&lt;br&gt;• a batch whose &lt;font face='Courier New'&gt;cursor&lt;/font&gt; is absent or empty, named with the count of documents that would have been checkpointed by nothing&lt;br&gt;• &lt;font face='Courier New'&gt;done&lt;/font&gt; carrying a batch, whatever cursor it holds, since neither the documents nor the cursor could be committed&lt;br&gt;• a frame carrying neither a batch nor &lt;font face='Courier New'&gt;done&lt;/font&gt;, which the host cannot act on&lt;br&gt;A host that abandons the stream terminates the process rather than shutting it down politely.&lt;br&gt;&lt;b&gt;embed&lt;/b&gt; is checked the same way: vectors positionally aligned with texts, a positive &lt;font face='Courier New'&gt;dimensions&lt;/font&gt;, and a width equal to the one this instance's index already holds (plugexec/provider.go, aligned).&lt;br&gt;&lt;b&gt;matches_remote&lt;/b&gt; is answered only by a source whose manifest declares &lt;font face='Courier New'&gt;RepoRemotes&lt;/font&gt;. Without it the host never dials, and an error or an unreachable plugin reads as false, because the answer only decides a startup warning (plugexec/connector.go, MatchesRemote)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720" y="560" width="740" height="330" as="geometry"/></mxCell><mxCell id="11Ptc53" value="&lt;b&gt;Lifecycle and cancellation&lt;/b&gt;&lt;br&gt;One process per operation. &lt;font face='Courier New'&gt;Open&lt;/font&gt; execs the binary once for the manifest handshake and shuts it down again, then every call dials a fresh process, checks that the manifest still answers with the same name and kind, runs the op and ends the round (internal/plugexec/plugin.go, open, dial and unary).&lt;br&gt;No state survives an operation except what the plugin put in the cursor.&lt;br&gt;Teardown is bounded and sequential (session.go, close and escalate): send &lt;font face='Courier New'&gt;shutdown&lt;/font&gt; and await &lt;font face='Courier New'&gt;ok&lt;/font&gt;, close stdin and wait, send the termination signal and wait again, then kill.&lt;br&gt;Default timeouts (session.go, defaultTuning): handshake 10s, unary op 60s, a completion &lt;font face='Courier New'&gt;lore.CompleteTimeout&lt;/font&gt; of 120s, idle between stream frames 300s, shutdown 5s, and a further 5s of grace before the kill.&lt;br&gt;A crash mid-stream fails that source's round only. The last persisted cursor is authoritative, so unflushed frames are work the next round redoes, and re-ingest is idempotent by &lt;font face='Courier New'&gt;DocID&lt;/font&gt;." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="920" width="740" height="290" as="geometry"/></mxCell><mxCell id="11Ptc54" value="DATA ENCODING — the json tags are the wire format" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1500" y="140" width="780" height="26" as="geometry"/></mxCell><mxCell id="11Ptc55" value="&lt;font face='Courier New'&gt;Document&lt;/font&gt; (sdk/document.go): &lt;font face='Courier New'&gt;id&lt;/font&gt;, &lt;font face='Courier New'&gt;source&lt;/font&gt;, &lt;font face='Courier New'&gt;type&lt;/font&gt;, &lt;font face='Courier New'&gt;repo_ref&lt;/font&gt;, &lt;font face='Courier New'&gt;title&lt;/font&gt;, &lt;font face='Courier New'&gt;body&lt;/font&gt;, &lt;font face='Courier New'&gt;author&lt;/font&gt;, &lt;font face='Courier New'&gt;url&lt;/font&gt;, &lt;font face='Courier New'&gt;created_at&lt;/font&gt;, &lt;font face='Courier New'&gt;updated_at&lt;/font&gt;, &lt;font face='Courier New'&gt;refs&lt;/font&gt;.&lt;br&gt;&lt;font face='Courier New'&gt;RawRef&lt;/font&gt;: &lt;font face='Courier New'&gt;kind&lt;/font&gt;, &lt;font face='Courier New'&gt;value&lt;/font&gt;, and an optional &lt;font face='Courier New'&gt;instance&lt;/font&gt; restricting where the reference may resolve. &lt;font face='Courier New'&gt;Batch&lt;/font&gt;: &lt;font face='Courier New'&gt;docs&lt;/font&gt;, &lt;font face='Courier New'&gt;cursor&lt;/font&gt;.&lt;br&gt;• &lt;font face='Courier New'&gt;id&lt;/font&gt; is &lt;font face='Courier New'&gt;&amp;lt;source&amp;gt;:&amp;lt;type&amp;gt;:&amp;lt;external_id&amp;gt;&lt;/font&gt; and the host never rebuilds it. &lt;font face='Courier New'&gt;source&lt;/font&gt; must equal the request's &lt;font face='Courier New'&gt;instance&lt;/font&gt; and &lt;font face='Courier New'&gt;id&lt;/font&gt; must carry it as a prefix, or the host fails the batch (internal/services/sync.go, assertInstanceIdentity).&lt;br&gt;• &lt;font face='Courier New'&gt;repo_ref&lt;/font&gt; is &lt;font face='Courier New'&gt;&amp;lt;forge&amp;gt;:owner/repo&lt;/font&gt; for repository-scoped documents and empty otherwise. The key is always present.&lt;br&gt;• Timestamps are RFC 3339 with an offset. Both are required and non-zero, and a source with no true creation time sets them equal.&lt;br&gt;• &lt;font face='Courier New'&gt;refs[].kind&lt;/font&gt; is a closed vocabulary of &lt;font face='Courier New'&gt;url&lt;/font&gt;, &lt;font face='Courier New'&gt;ticket_key&lt;/font&gt;, &lt;font face='Courier New'&gt;commit_sha&lt;/font&gt;, &lt;font face='Courier New'&gt;file_path&lt;/font&gt;, &lt;font face='Courier New'&gt;pr_number&lt;/font&gt; (&lt;font face='Courier New'&gt;lore.RefKinds&lt;/font&gt;). An unknown kind is rejected at ingest with the known list quoted, never dropped, because a dropped ref is a missing edge and so a wrong answer (internal/services/linkresolver.go, assertKnownRefKind).&lt;br&gt;• &lt;font face='Courier New'&gt;type&lt;/font&gt; is an open set. An unknown value is accepted, chunked with the default strategy, and ranked as ordinary evidence.&lt;br&gt;• &lt;font face='Courier New'&gt;cursor&lt;/font&gt; is a flat string to string map, opaque to the host, stored and replayed without a key being read.&lt;br&gt;• A list or map travels as &lt;font face='Courier New'&gt;[]&lt;/font&gt; or &lt;font face='Courier New'&gt;{}&lt;/font&gt; and never as &lt;font face='Courier New'&gt;null&lt;/font&gt; from the SDK, because the marshallers substitute the empty value (&lt;font face='Courier New'&gt;sdk/wire&lt;/font&gt;, listOrEmpty and mapOrEmpty). Reading, the host treats &lt;font face='Courier New'&gt;null&lt;/font&gt; and an absent key as that same empty value, so a plugin writing its own JSON is refused for neither." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;" vertex="1" parent="1"><mxGeometry x="1500" y="176" width="780" height="400" as="geometry"/></mxCell><mxCell id="11Ptc56" value="WHAT A PLUGIN AUTHOR WRITES" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1500" y="600" width="780" height="26" as="geometry"/></mxCell><mxCell id="11Ptc57" value="A plugin in any language may speak the protocol by hand. A Go plugin does not have to: &lt;font face='Courier New'&gt;sdk/stdio&lt;/font&gt; is the server half.&lt;br&gt;&lt;font face='Courier New'&gt;func Serve(plugin lore.Plugin) error&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;func ServeStreams(plugin lore.Plugin, in io.Reader, out, errOut io.Writer) error&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Serve&lt;/font&gt; runs the loop on the real standard streams. &lt;font face='Courier New'&gt;ServeStreams&lt;/font&gt; takes the three streams, which is what a test drives (sdk/stdio/stdio.go).&lt;br&gt;The SDK owns the framing, the id echo, the version gate and the manifest passthrough, and it redacts the instance's secrets from anything the plugin logs (stdio.go, redacting).&lt;br&gt;So a &lt;b&gt;source&lt;/b&gt; author implements &lt;font face='Courier New'&gt;lore.SourcePlugin&lt;/font&gt; and calls &lt;font face='Courier New'&gt;Serve&lt;/font&gt; from &lt;font face='Courier New'&gt;main&lt;/font&gt;. &lt;font face='Courier New'&gt;respond&lt;/font&gt; dispatches &lt;font face='Courier New'&gt;manifest&lt;/font&gt;, &lt;font face='Courier New'&gt;changes&lt;/font&gt;, &lt;font face='Courier New'&gt;matches_remote&lt;/font&gt; and &lt;font face='Courier New'&gt;shutdown&lt;/font&gt; and answers every other op with &lt;font face='Courier New'&gt;the plugin implements no operation&lt;/font&gt;, and &lt;font face='Courier New'&gt;openSource&lt;/font&gt; refuses a value that is no &lt;font face='Courier New'&gt;lore.SourcePlugin&lt;/font&gt; naming its manifest kind. A provider or code plugin frames the protocol itself." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1500" y="636" width="780" height="200" as="geometry"/></mxCell><mxCell id="11Ptc58" value="&lt;b&gt;Status: the protocol is frozen&lt;/b&gt;&lt;br&gt;It evolves additively from here. A new operation or a new field is allowed, changing or removing one is not, and that rule is what makes ignoring unknown fields safe in both directions.&lt;br&gt;Δ10 is why the freeze waited for the contract to settle: a wire signature frozen before its contract settled turned an internal fix into an unimplementable contract, and a published protocol turns that class of fix into an ecosystem break.&lt;br&gt;Where a binary comes from is docs/v3/10-plugin-distribution.md. The Go interfaces a compiled plugin implements instead are docs/v3/08-extensibility.md." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1500" y="860" width="780" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p11" name="11 · Plugin Distribution &amp; Trust"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="12Dst1" value="PLUGIN DISTRIBUTION &amp; TRUST — coordinate, digest, lockfile, cache, and what privilege an installed plugin holds" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="36" as="geometry"/></mxCell><mxCell id="12Dst2" value="docs/v3/10-plugin-distribution.md. How an external plugin binary is named, fetched, pinned, verified and run. The wire protocol it speaks once it is running is docs/v3/09-plugin-protocol.md, and the contract it implements is docs/v3/08-extensibility.md. Go cannot load code dynamically, so a compiled third-party plugin always means a custom binary: that is why &lt;font face='Courier New'&gt;lore build&lt;/font&gt; exists (internal/plugbuild)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2240" height="56" as="geometry"/></mxCell><mxCell id="12Dst3" value="COORDINATES — dispatch is by the shape of &lt;font face='Courier New'&gt;from:&lt;/font&gt; (internal/plugindist/coordinate.go, parseCoordinate)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="900" height="26" as="geometry"/></mxCell><mxCell id="12Dst4" value="shape of from:" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="60" y="176" width="280" height="26" as="geometry"/></mxCell><mxCell id="12Dst5" value="resolves to" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="340" y="176" width="280" height="26" as="geometry"/></mxCell><mxCell id="12Dst6" value="digest" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="620" y="176" width="340" height="26" as="geometry"/></mxCell><mxCell id="12Dst7" value="&lt;font face='Courier New'&gt;./x&lt;/font&gt;, &lt;font face='Courier New'&gt;../x&lt;/font&gt;, &lt;font face='Courier New'&gt;/x&lt;/font&gt;, &lt;font face='Courier New'&gt;~/x&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="202" width="280" height="84" as="geometry"/></mxCell><mxCell id="12Dst8" value="a local file, executed in place" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="340" y="202" width="280" height="84" as="geometry"/></mxCell><mxCell id="12Dst9" value="none. Startup warns that the plugin is unpinned, has no lock entry and is for development only (Coordinate.Warning)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="620" y="202" width="340" height="84" as="geometry"/></mxCell><mxCell id="12Dst10" value="&lt;font face='Courier New'&gt;github.com/owner/repo@vX.Y.Z&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="286" width="280" height="84" as="geometry"/></mxCell><mxCell id="12Dst11" value="the release asset published for that tag, named &lt;font face='Courier New'&gt;&amp;lt;repo&amp;gt;_&amp;lt;X.Y.Z&amp;gt;_&amp;lt;os&amp;gt;_&amp;lt;arch&amp;gt;.tar.gz&lt;/font&gt;. Coordinate.assetName strips the tag's leading &lt;font face='Courier New'&gt;v&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="340" y="286" width="280" height="84" as="geometry"/></mxCell><mxCell id="12Dst12" value="required. The release's &lt;font face='Courier New'&gt;checksums.txt&lt;/font&gt; is compared on the first install" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="620" y="286" width="340" height="84" as="geometry"/></mxCell><mxCell id="12Dst13" value="&lt;font face='Courier New'&gt;https://…&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="280" height="84" as="geometry"/></mxCell><mxCell id="12Dst14" value="that artifact URL verbatim, for private or self-hosted distribution" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="340" y="370" width="280" height="84" as="geometry"/></mxCell><mxCell id="12Dst15" value="recorded on the first download. Installer.locate looks for no checksums file, so without &lt;font face='Courier New'&gt;pubkey:&lt;/font&gt; that first fetch is compared with nothing" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="620" y="370" width="340" height="84" as="geometry"/></mxCell><mxCell id="12Dst16" value="RESOLUTION AND INSTALL" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="526" width="900" height="26" as="geometry"/></mxCell><mxCell id="12Dst17" value="A declaration is three keys, &lt;font face='Courier New'&gt;name&lt;/font&gt;, &lt;font face='Courier New'&gt;from&lt;/font&gt; and an optional &lt;font face='Courier New'&gt;pubkey&lt;/font&gt; (internal/config/config.go, PluginDecl). A &lt;font face='Courier New'&gt;github.com/…&lt;/font&gt; coordinate MUST pin an exact release tag, checked by &lt;font face='Courier New'&gt;ExactVersion&lt;/font&gt;, because a floating version means two machines silently run different code against one index. &lt;font face='Courier New'&gt;@latest&lt;/font&gt; is accepted only where a declaration is read through &lt;font face='Courier New'&gt;ResolveInstall&lt;/font&gt;, which is an install naming its target and an update, and what they resolve is written back into &lt;font face='Courier New'&gt;lore.yaml&lt;/font&gt;. The startup path reads it through &lt;font face='Courier New'&gt;Resolve&lt;/font&gt;, which refuses an &lt;font face='Courier New'&gt;@latest&lt;/font&gt; left in the file, and &lt;font face='Courier New'&gt;Install&lt;/font&gt; refuses a coordinate that reached it still floating. An &lt;font face='Courier New'&gt;https://&lt;/font&gt; coordinate carries its version in the URL's last path segment, which must be present and usable as one cache directory name and cannot be checked for exactness (coordinate.go, parseGitHub and parseURL).&lt;br&gt;The steps (internal/plugindist/install.go, Install): resolve the coordinate, fetch the archive and the expected digest, refuse on any mismatch, unpack into the cache, then exec the binary once for the &lt;font face='Courier New'&gt;manifest&lt;/font&gt; handshake and cache what it answered.&lt;br&gt;The manifest is always read from the binary through the handshake, never from a file inside the archive, so a plugin cannot ship a manifest that disagrees with its behaviour (install.go, captureManifest). The cached copy is a cache: deleting it costs one exec and a stale copy can never outvote the binary.&lt;br&gt;&lt;font face='Courier New'&gt;Install&lt;/font&gt; records what it pinned in the lock and never writes the file. The caller saves once every install has succeeded, so a failed install leaves no half-written lockfile." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;" vertex="1" parent="1"><mxGeometry x="60" y="562" width="900" height="250" as="geometry"/></mxCell><mxCell id="12Dst18" value="lore.lock — committed beside lore.yaml (internal/plugindist/lock.go)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="836" width="900" height="26" as="geometry"/></mxCell><mxCell id="12Dst19" value="&lt;font face='Courier New'&gt;# lore.lock — generated; written by `lore plugin install|update`&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;version: 1&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;plugins:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  linear:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    version: v0.3.1&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    from: github.com/jdoe/lore-linear@v0.3.1&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    artifacts:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;      darwin/arm64:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;        url: https://github.com/jdoe/lore-linear/releases/download/…&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;        digest: sha256:9f2b41c0…d7e5&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;      linux/amd64:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;        url: https://github.com/jdoe/lore-linear/releases/download/…&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;        digest: sha256:1a08be77…33c9&lt;/font&gt;&lt;br&gt;&lt;br&gt;A digest &lt;b&gt;per os/arch&lt;/b&gt;, because a team on macOS with Linux CI needs both. Rules: a mismatch refuses to launch and no flag makes it continue. &lt;font face='Courier New'&gt;update&lt;/font&gt; is the only command that rewrites a locked digest, and &lt;font face='Courier New'&gt;install&lt;/font&gt; writes entries that do not exist yet. A locally-sourced plugin has no entry by construction, and a declared plugin with no entry for the running os/arch is a startup error naming the platform, not a silent download (store.go, locate)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="872" width="900" height="290" as="geometry"/></mxCell><mxCell id="12Dst20" value="ON-DISK CACHE" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="1186" width="900" height="26" as="geometry"/></mxCell><mxCell id="12Dst21" value="One directory per version under &lt;font face='Courier New'&gt;~/.lore/plugins/&amp;lt;name&amp;gt;/&amp;lt;version&amp;gt;/&lt;/font&gt; (store.go, Store.Dir), so several versions coexist on one machine and different workspaces pin differently. The workspace's lockfile decides which one runs and the cache never picks.&lt;br&gt;Beside the binary the store keeps the manifest the handshake returned and the provenance of the install, and &lt;font face='Courier New'&gt;Store.Binary&lt;/font&gt; re-hashes the binary and checks that provenance against the lockfile before the host resolves it for launch, so a cached binary rewritten after installation is caught too.&lt;br&gt;&lt;font face='Courier New'&gt;LORE_HOME&lt;/font&gt; relocates the cache root (store.go, RootEnv). Unset, the root is &lt;font face='Courier New'&gt;~/.lore&lt;/font&gt;." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="1222" width="900" height="180" as="geometry"/></mxCell><mxCell id="12Dst22" value="CLI (internal/transport/cli/plugin.go, plugindist.go, build.go)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="620" height="26" as="geometry"/></mxCell><mxCell id="12Dst23" value="command" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1000" y="176" width="230" height="26" as="geometry"/></mxCell><mxCell id="12Dst24" value="semantics" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1230" y="176" width="390" height="26" as="geometry"/></mxCell><mxCell id="12Dst25" value="&lt;font face='Courier New'&gt;lore plugin list&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1000" y="202" width="230" height="91" as="geometry"/></mxCell><mxCell id="12Dst26" value="every plugin this build can use, as &lt;font face='Courier New'&gt;NAME&lt;/font&gt;, &lt;font face='Courier New'&gt;KIND&lt;/font&gt;, &lt;font face='Courier New'&gt;ORIGIN&lt;/font&gt;, &lt;font face='Courier New'&gt;SUMMARY&lt;/font&gt;. Origin is &lt;font face='Courier New'&gt;builtin&lt;/font&gt; or &lt;font face='Courier New'&gt;external &amp;lt;binary&amp;gt;&lt;/font&gt;. There is no version column. A declared external plugin that is not registered is not a row: it prints after the table as &lt;font face='Courier New'&gt;declared from &amp;lt;coordinate&amp;gt;&lt;/font&gt; and its state. Its manifest is not read, because reading one means executing the binary" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1230" y="202" width="390" height="91" as="geometry"/></mxCell><mxCell id="12Dst27" value="&lt;font face='Courier New'&gt;lore plugin install [&amp;lt;name&amp;gt; | &amp;lt;coordinate&amp;gt;[@latest]]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1000" y="293" width="230" height="46" as="geometry"/></mxCell><mxCell id="12Dst28" value="resolve, download, verify, unpack, handshake, write &lt;font face='Courier New'&gt;lore.lock&lt;/font&gt;. No argument installs everything declared" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1230" y="293" width="390" height="46" as="geometry"/></mxCell><mxCell id="12Dst29" value="&lt;font face='Courier New'&gt;lore plugin update &amp;lt;name&amp;gt;[@&amp;lt;version&amp;gt;]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1000" y="339" width="230" height="61" as="geometry"/></mxCell><mxCell id="12Dst30" value="re-resolve and rewrite the locked version, URLs and digests. Without a version it moves to the newest release and writes that version back into &lt;font face='Courier New'&gt;lore.yaml&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1230" y="339" width="390" height="61" as="geometry"/></mxCell><mxCell id="12Dst31" value="&lt;font face='Courier New'&gt;lore plugin remove &amp;lt;name&amp;gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1000" y="400" width="230" height="31" as="geometry"/></mxCell><mxCell id="12Dst32" value="drop the declaration, the lock entry and the cached versions" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1230" y="400" width="390" height="31" as="geometry"/></mxCell><mxCell id="12Dst33" value="&lt;font face='Courier New'&gt;lore plugin verify &amp;lt;name&amp;gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1000" y="431" width="230" height="61" as="geometry"/></mxCell><mxCell id="12Dst34" value="re-hash the installed binary against the digest recorded at install, then run &lt;font face='Courier New'&gt;sdk/conform&lt;/font&gt; against it. Certify certifies a &lt;font face='Courier New'&gt;KindSource&lt;/font&gt; plugin and reports any other kind as never run" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1230" y="431" width="390" height="61" as="geometry"/></mxCell><mxCell id="12Dst35" value="&lt;font face='Courier New'&gt;lore plugin search &amp;lt;query&amp;gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1000" y="492" width="230" height="61" as="geometry"/></mxCell><mxCell id="12Dst36" value="match the query against each indexed plugin's name, summary and kind. The index is a JSON file in a git repository, fetched over HTTPS and never cached (internal/plugbuild/index.go)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1230" y="492" width="390" height="61" as="geometry"/></mxCell><mxCell id="12Dst37" value="&lt;font face='Courier New'&gt;lore build --with &amp;lt;module&amp;gt;@&amp;lt;version&amp;gt; [-o lore]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1000" y="553" width="230" height="61" as="geometry"/></mxCell><mxCell id="12Dst38" value="generate a composition root that adds the named modules to the official set and compile it. Needs a Go toolchain, which is the whole trade for in-process calls and compile-time type safety" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1230" y="553" width="390" height="61" as="geometry"/></mxCell><mxCell id="12Dst39" value="SIGNATURES — opt-in, per plugin (internal/plugindist/signature.go)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1000" y="650" width="620" height="26" as="geometry"/></mxCell><mxCell id="12Dst40" value="A declaration may carry a &lt;font face='Courier New'&gt;pubkey:&lt;/font&gt;, which enables verification of &lt;font face='Courier New'&gt;checksums.txt&lt;/font&gt; before any digest is compared. A relative path resolves against the directory &lt;font face='Courier New'&gt;lore.yaml&lt;/font&gt; sits in, so the key a workspace declares is the same key whichever directory &lt;font face='Courier New'&gt;lore&lt;/font&gt; was started from.&lt;br&gt;Which tool signed the release is read from the key file's own shape, so a workspace never declares it twice. Both formats are verifiable with the standard library alone:&lt;br&gt;• &lt;b&gt;cosign, ECDSA&lt;/b&gt;: a PEM key on P-256 (the cosign default), P-384 or P-521. Any other curve is refused when the key loads, naming the three. The signature is base64 in a &lt;font face='Courier New'&gt;&amp;lt;file&amp;gt;.sig&lt;/font&gt; sibling, over SHA-256 or the digest the curve implies, and either verifies.&lt;br&gt;• &lt;b&gt;cosign, Ed25519&lt;/b&gt;: a PEM Ed25519 key, the same &lt;font face='Courier New'&gt;&amp;lt;file&amp;gt;.sig&lt;/font&gt; sibling, pure or Ed25519ph over SHA-512, and either verifies.&lt;br&gt;• &lt;b&gt;minisign&lt;/b&gt;: the 42-byte &lt;font face='Courier New'&gt;Ed&lt;/font&gt; key line and a &lt;font face='Courier New'&gt;&amp;lt;file&amp;gt;.minisig&lt;/font&gt; sibling, Ed25519 over the file's own bytes. The trusted comment is verified through its global signature too.&lt;br&gt;The prehashed &lt;font face='Courier New'&gt;ED&lt;/font&gt; minisign variant hashes with BLAKE2b, which the standard library does not offer, so such a signature is refused by name rather than skipped: a signature layer that silently does nothing is worse than none, because the user believes it is there.&lt;br&gt;With &lt;font face='Courier New'&gt;pubkey:&lt;/font&gt; declared, a missing or unsupported signature aborts the install: the whole signature path in Installer.expected sits behind that condition, so an undeclared key requires nothing. The two layers defend different things: the lockfile digest defends against tampering after publication, and a signature against a compromised publisher account cutting a new release with internally valid checksums." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1000" y="686" width="620" height="430" as="geometry"/></mxCell><mxCell id="12Dst41" value="TRUST MODEL — what an installed plugin holds" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1660" y="140" width="620" height="26" as="geometry"/></mxCell><mxCell id="12Dst42" value="An external plugin runs as a subprocess with the user's privileges and holds its source's token. Invariant 5, read-only, is a promise by the author and not something the engine enforces. Installing a plugin is running that author's code on your machine, and the CLI says so at install time.&lt;br&gt;&lt;b&gt;Three mitigations exist in the code:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Per-instance secret scoping.&lt;/b&gt; An instance receives only the secrets its manifest declared, each read by &lt;font face='Courier New'&gt;resolveSecrets&lt;/font&gt; (internal/registry/secrets.go) from the variable the operator's &lt;font face='Courier New'&gt;with:&lt;/font&gt; entry names. A plugin registered through &lt;font face='Courier New'&gt;RegisterExternal&lt;/font&gt; cannot fall back to a default variable of its own choosing, which a plugin compiled in through &lt;font face='Courier New'&gt;Register&lt;/font&gt;, including one added by &lt;font face='Courier New'&gt;lore build --with&lt;/font&gt;, can. The host environment is not inherited either: &lt;font face='Courier New'&gt;minimalEnv&lt;/font&gt; (internal/plugexec/env.go) hands the subprocess an empty environment, and on Windows only the variables the loader and runtime need.&lt;br&gt;• &lt;b&gt;Digest pinning.&lt;/b&gt; Remote code is pinned by content, not by tag. &lt;font face='Courier New'&gt;Install&lt;/font&gt; refuses an artifact whose digest differs from the one &lt;font face='Courier New'&gt;lore.lock&lt;/font&gt; records, and &lt;font face='Courier New'&gt;Store.Binary&lt;/font&gt; re-hashes the binary on disk before the host resolves it for launch (internal/di/external.go, newExternals). A GitHub release coordinate is checked against the release's &lt;font face='Courier New'&gt;checksums.txt&lt;/font&gt; on that first install. For an &lt;font face='Courier New'&gt;https://&lt;/font&gt; coordinate &lt;font face='Courier New'&gt;Installer.locate&lt;/font&gt; looks for no checksums file, so unless it declares &lt;font face='Courier New'&gt;pubkey:&lt;/font&gt; its first download is compared with nothing, and the CLI prints &lt;font face='Courier New'&gt;pinned in lore.lock: nothing but the download itself vouched for these bytes&lt;/font&gt;.&lt;br&gt;• &lt;b&gt;Signature verification.&lt;/b&gt; With &lt;font face='Courier New'&gt;pubkey:&lt;/font&gt; on a remote coordinate, &lt;font face='Courier New'&gt;Installer.expected&lt;/font&gt; fetches the signature and verifies it before any digest is compared. A &lt;font face='Courier New'&gt;pubkey:&lt;/font&gt; on a local &lt;font face='Courier New'&gt;from:&lt;/font&gt; is never consulted, because &lt;font face='Courier New'&gt;Install&lt;/font&gt; returns on its local branch first.&lt;br&gt;Explicit installation and &lt;font face='Courier New'&gt;lore plugin verify&lt;/font&gt; keep the operator in the loop rather than confining the process. Least-privilege tokens remain the load-bearing control: scope the credential to what the plugin must read, and never issue it a token broader than the &lt;font face='Courier New'&gt;with:&lt;/font&gt; block it was given." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1660" y="176" width="620" height="560" as="geometry"/></mxCell><mxCell id="12Dst43" value="AN ENFORCING SANDBOX IS NOT BUILT" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1660" y="770" width="620" height="26" as="geometry"/></mxCell><mxCell id="12Dst44" value="Nothing in the engine confines a plugin. Every session it serves is dialled through &lt;font face='Courier New'&gt;spawn&lt;/font&gt; (internal/plugexec/session.go), which is &lt;font face='Courier New'&gt;exec.Command&lt;/font&gt; on the plugin binary, and &lt;font face='Courier New'&gt;Open&lt;/font&gt; (internal/plugexec/plugin.go) wraps that binary without applying any isolation to it.&lt;br&gt;There is no runtime boundary and no host-function allowlist, so the ceiling of the controls above is a process that holds whatever the operator holds.&lt;br&gt;Confining a plugin inside a WebAssembly runtime is an idea and not a tier of this system." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1660" y="806" width="620" height="180" as="geometry"/></mxCell><mxCell id="12Dst45" value="NO NETWORK AT SYNC TIME" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1660" y="1010" width="620" height="26" as="geometry"/></mxCell><mxCell id="12Dst46" value="Only &lt;font face='Courier New'&gt;lore plugin install&lt;/font&gt; and &lt;font face='Courier New'&gt;lore plugin update&lt;/font&gt; download a plugin &lt;b&gt;binary&lt;/b&gt;, and nothing inside a sync round fetches one, because a background scheduler must not download and execute code on a timer.&lt;br&gt;Two other commands do reach the network without touching a plugin binary: &lt;font face='Courier New'&gt;lore plugin search&lt;/font&gt; fetches the index over HTTPS, and &lt;font face='Courier New'&gt;lore build --with&lt;/font&gt; fetches plugin modules through the Go toolchain at build time (internal/plugbuild/plugbuild.go, fetchRequirements).&lt;br&gt;A declared-but-uninstalled plugin fails at startup, before the scheduler starts and before any source is touched, with the exact command to run: &lt;font face='Courier New'&gt;plugins[linear] is not installed — run: lore plugin install linear&lt;/font&gt; (store.go, notInstalled and reinstallRemedy).&lt;br&gt;A digest mismatch reads &lt;font face='Courier New'&gt;plugins[linear]: digest mismatch for darwin/arm64 (expected …, got …)&lt;/font&gt; and refuses to launch. It never downgrades to a warning (store.go, digestMismatch).&lt;br&gt;None of these corrupts the index: writes are idempotent by &lt;font face='Courier New'&gt;DocID&lt;/font&gt; and a cursor advances only after its batch is durably committed." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1660" y="1046" width="620" height="310" as="geometry"/></mxCell><mxCell id="12Dst47" value="&lt;font face='Courier New'&gt;http://…&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="454" width="280" height="46" as="geometry"/></mxCell><mxCell id="12Dst48" value="refused at parse by name: plaintext HTTP cannot carry code anyone should run" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="340" y="454" width="280" height="46" as="geometry"/></mxCell><mxCell id="12Dst49" value="none, nothing is fetched" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="620" y="454" width="340" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
