<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="lore-design-docs" type="device" pages="9">
<diagram id="lore-v3-p1" name="1 · System Context"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1440" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1Sysc1" value="Lore — decision-provenance engine · SYSTEM CONTEXT" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="1Sysc2" value="Source of truth: docs/v3 (README, 01-overview, 02-architecture). Lore answers &lt;i&gt;why a decision was made&lt;/i&gt; and &lt;i&gt;what happened next&lt;/i&gt; from the decision trail across GitHub / Notion / Jira, with code as one optional anchor. Every answer is citation-grounded; sources are read-only; the index is derived, rebuildable data." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1220" height="52" as="geometry"/></mxCell><mxCell id="1Sysc3" value="CONSUMERS" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="300" height="760" as="geometry"/></mxCell><mxCell id="1Sysc4" value="DEVELOPER WORKSTATION — trust boundary (all state local)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="130" width="880" height="1250" as="geometry"/></mxCell><mxCell id="1Sysc5" value="EXTERNAL SYSTEMS — network egress, read-only" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1290" y="130" width="470" height="1000" as="geometry"/></mxCell><mxCell id="1Sysc6" value="&lt;b&gt;MCP host (AI harness)&lt;/b&gt;&lt;br&gt;Claude Code · Cursor · any MCP client&lt;br&gt;&lt;i&gt;client HAS a brain&lt;/i&gt;&lt;br&gt;• calls tools/call over stdio or Streamable HTTP&lt;br&gt;• receives &lt;b&gt;EvidenceBundle&lt;/b&gt; JSON, synthesizes itself&lt;br&gt;• default &lt;b&gt;synthesize=false&lt;/b&gt; (D1)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="260" height="140" as="geometry"/></mxCell><mxCell id="1Sysc7" value="&lt;b&gt;Human operator (terminal)&lt;/b&gt;&lt;br&gt;&lt;i&gt;client has NO brain&lt;/i&gt;&lt;br&gt;• lore init / source add / sync / status&lt;br&gt;• lore ask · why · trace · impact · history&lt;br&gt;• default &lt;b&gt;synthesize=true&lt;/b&gt; for ask/--explain&lt;br&gt;• --raw prints the bundle (JSON / pretty tree)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="260" height="140" as="geometry"/></mxCell><mxCell id="1Sysc8" value="&lt;b&gt;gRPC client · future web UI&lt;/b&gt;&lt;br&gt;&lt;i&gt;client has NO brain&lt;/i&gt;&lt;br&gt;• lore.v1 QueryService + SyncService&lt;br&gt;• mTLS (RequireAndVerifyClientCert)&lt;br&gt;• bundle &lt;b&gt;and&lt;/b&gt; optional synthesis text&lt;br&gt;• SyncService.Watch = streamed progress" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="260" height="140" as="geometry"/></mxCell><mxCell id="1Sysc9" value="&lt;b&gt;Layering rule (02)&lt;/b&gt;&lt;br&gt;No consumer and no transport ever touches&lt;br&gt;the store or a connector directly — every&lt;br&gt;call goes through the service layer,&lt;br&gt;including the MCP path." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="260" height="110" as="geometry"/></mxCell><mxCell id="1Sysc10" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color='#6c8ebf'&gt;▮&lt;/font&gt; transport / client surface&lt;br&gt;&lt;font color='#82b366'&gt;▮&lt;/font&gt; service (business logic)&lt;br&gt;&lt;font color='#d6b656'&gt;▮&lt;/font&gt; repository / storage&lt;br&gt;&lt;font color='#d79b00'&gt;▮&lt;/font&gt; connector (I/O adapter)&lt;br&gt;&lt;font color='#9673a6'&gt;▮&lt;/font&gt; external system&lt;br&gt;&lt;font color='#b85450'&gt;▮&lt;/font&gt; security / privacy note&lt;br&gt;dashed box = boundary, not a process" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="260" height="160" as="geometry"/></mxCell><mxCell id="1Sysc11" value="&lt;b&gt;Single Go binary  ·  &lt;font face='Courier New'&gt;lore&lt;/font&gt;  ·  pure-Go build (ncruces WASM SQLite, no cgo)  ·  Uber FX dependency injection&lt;/b&gt;&lt;br&gt;Subcommand selects the transport: &lt;font face='Courier New'&gt;lore mcp&lt;/font&gt; = MCP stdio · &lt;font face='Courier New'&gt;lore serve&lt;/font&gt; = MCP Streamable HTTP + gRPC · anything else = CLI" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="395" y="180" width="830" height="640" as="geometry"/></mxCell><mxCell id="1Sysc12" value="&lt;b&gt;MCP stdio&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore mcp&lt;/font&gt;&lt;br&gt;official Go MCP SDK&lt;br&gt;7 tools · readOnlyHint&lt;br&gt;except sync_now" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="415" y="250" width="190" height="120" as="geometry"/></mxCell><mxCell id="1Sysc13" value="&lt;b&gt;MCP Streamable HTTP&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore serve --http=:8080&lt;/font&gt;&lt;br&gt;endpoint &lt;font face='Courier New'&gt;/mcp&lt;/font&gt;&lt;br&gt;AI side, despite 'HTTP'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="615" y="250" width="200" height="120" as="geometry"/></mxCell><mxCell id="1Sysc14" value="&lt;b&gt;gRPC (+mTLS)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore serve --grpc=:9090&lt;/font&gt;&lt;br&gt;programmatic API, NOT&lt;br&gt;an MCP transport (D5)&lt;br&gt;non-loopback ⇒ TLS required" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="825" y="250" width="190" height="120" as="geometry"/></mxCell><mxCell id="1Sysc15" value="&lt;b&gt;CLI&lt;/b&gt;&lt;br&gt;cobra-style subcommands&lt;br&gt;pretty tree / timeline&lt;br&gt;exit codes + stderr" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1025" y="250" width="180" height="120" as="geometry"/></mxCell><mxCell id="1Sysc16" value="&lt;b&gt;QueryService&lt;/b&gt;&lt;br&gt;resolve anchor → seed → walk →&lt;br&gt;retrieve → rank → EvidenceBundle&lt;br&gt;4 seed modes, 5 verbs (D3)&lt;br&gt;all limits capped server-side" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="415" y="420" width="200" height="130" as="geometry"/></mxCell><mxCell id="1Sysc17" value="&lt;b&gt;SyncOrchestrator&lt;/b&gt;&lt;br&gt;scheduler tick + manual trigger&lt;br&gt;lease lock (heartbeat 15s, TTL 60s)&lt;br&gt;commit batch → persist cursor (D8)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="625" y="420" width="200" height="130" as="geometry"/></mxCell><mxCell id="1Sysc18" value="&lt;b&gt;LinkResolver&lt;/b&gt;&lt;br&gt;RawRef → typed Edge&lt;br&gt;confidence 1.0 … 0.7&lt;br&gt;pending_refs retried each round" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="835" y="420" width="180" height="130" as="geometry"/></mxCell><mxCell id="1Sysc19" value="&lt;b&gt;SynthesisService&lt;/b&gt;&lt;br&gt;non-AI surfaces only&lt;br&gt;evidence-grounded prompt&lt;br&gt;prose + [n] citations&lt;br&gt;optional — never for MCP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1025" y="420" width="180" height="130" as="geometry"/></mxCell><mxCell id="1Sysc20" value="&lt;b&gt;IndexStore (repository)&lt;/b&gt;&lt;br&gt;one interface, SQLite v1 impl · no SQL types leak out&lt;br&gt;batch upserts atomic internally · fusion happens in Go, not SQL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="415" y="600" width="390" height="100" as="geometry"/></mxCell><mxCell id="1Sysc21" value="&lt;b&gt;Connectors (adapters)&lt;/b&gt;&lt;br&gt;GitHub · Notion · Jira · GitRepo&lt;br&gt;Embedder · LLM — all optional per workspace" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="815" y="600" width="390" height="100" as="geometry"/></mxCell><mxCell id="1Sysc22" value="&lt;b&gt;&lt;font face='Courier New'&gt;~/.lore/&amp;lt;workspace&amp;gt;.db&lt;/font&gt;  (single SQLite file)&lt;/b&gt;&lt;br&gt;documents · chunks · chunks_fts (FTS5/BM25)&lt;br&gt;chunk_vectors (sqlite-vec) · edges · pending_refs&lt;br&gt;cursors · sync_lock · meta (schema ver + embedder identity)&lt;br&gt;offline-queryable after sync · portable · rebuildable cache" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="415" y="860" width="390" height="150" as="geometry"/></mxCell><mxCell id="1Sysc23" value="&lt;b&gt;Registered local git clones — OPTIONAL&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;repos:&lt;/font&gt; in lore.yaml · zero repos = ask-only workspace&lt;br&gt;&lt;font face='Courier New'&gt;git blame --porcelain&lt;/font&gt; → line attribution&lt;br&gt;&lt;font face='Courier New'&gt;git log --follow&lt;/font&gt; → rename-aware history&lt;br&gt;ground truth for &lt;font face='Courier New'&gt;why&lt;/font&gt; / &lt;font face='Courier New'&gt;history_of&lt;/font&gt;; absent ⇒ precondition error" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="815" y="860" width="390" height="150" as="geometry"/></mxCell><mxCell id="1Sysc24" value="&lt;b&gt;Secrets — env vars only (never in lore.yaml, index, or logs)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;LORE_GITHUB_TOKEN&lt;/font&gt; · &lt;font face='Courier New'&gt;LORE_NOTION_TOKEN&lt;/font&gt; · &lt;font face='Courier New'&gt;LORE_JIRA_EMAIL&lt;/font&gt; + &lt;font face='Courier New'&gt;LORE_JIRA_TOKEN&lt;/font&gt; · &lt;font face='Courier New'&gt;LORE_LLM_KEY&lt;/font&gt;&lt;br&gt;config stores env-var &lt;i&gt;names&lt;/i&gt;; load-time validation asserts each named var exists · least-privilege read scopes documented per source" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="415" y="1050" width="790" height="90" as="geometry"/></mxCell><mxCell id="1Sysc25" value="&lt;b&gt;&lt;font face='Courier New'&gt;lore.yaml&lt;/font&gt; — two independent axes (Δ9)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;sources:&lt;/font&gt; what to INGEST (github.repos / notion.root_pages / jira.projects) — no clone needed&lt;br&gt;&lt;font face='Courier New'&gt;repos:&lt;/font&gt; local clones for blame/log ONLY · at least one of the two must be non-empty · unknown keys rejected" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="415" y="1160" width="790" height="90" as="geometry"/></mxCell><mxCell id="1Sysc26" value="&lt;b&gt;GitHub API&lt;/b&gt;&lt;br&gt;auth: fine-grained PAT (read)&lt;br&gt;GraphQL for backfill (fewer round-trips), REST where simpler&lt;br&gt;ingests: commits · PRs · pr_reviews · review_comments · issues · issue_comments&lt;br&gt;cursor: per-repo &lt;font face='Courier New'&gt;updated_at&lt;/font&gt; watermark · respects Retry-After + secondary limits" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1310" y="175" width="430" height="150" as="geometry"/></mxCell><mxCell id="1Sysc27" value="&lt;b&gt;Notion API&lt;/b&gt;&lt;br&gt;auth: integration token, scoped to &lt;font face='Courier New'&gt;root_pages&lt;/font&gt; subtrees&lt;br&gt;ingests: pages + blocks flattened to markdown-ish text&lt;br&gt;CreatedAt = &lt;font face='Courier New'&gt;created_time&lt;/font&gt; · cursor = &lt;font face='Courier New'&gt;last_edited_time&lt;/font&gt; search watermark" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1310" y="345" width="430" height="130" as="geometry"/></mxCell><mxCell id="1Sysc28" value="&lt;b&gt;Jira Cloud API&lt;/b&gt;&lt;br&gt;auth: email + API token (basic) · &lt;font face='Courier New'&gt;base_url&lt;/font&gt; per site&lt;br&gt;endpoint: &lt;b&gt;new&lt;/b&gt; &lt;font face='Courier New'&gt;/rest/api/3/search/jql&lt;/font&gt; + &lt;font face='Courier New'&gt;nextPageToken&lt;/font&gt; (legacy /search deprecated)&lt;br&gt;cursor: JQL &lt;font face='Courier New'&gt;updated &amp;gt;= watermark ORDER BY updated ASC&lt;/font&gt;&lt;br&gt;ingests: issues → ticket · comments → ticket_comment · ADF → plain text" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1310" y="495" width="430" height="150" as="geometry"/></mxCell><mxCell id="1Sysc29" value="&lt;b&gt;Embedder provider&lt;/b&gt;&lt;br&gt;default &lt;b&gt;OpenAI&lt;/b&gt; &lt;font face='Courier New'&gt;text-embedding-3-small&lt;/font&gt; (1536d)&lt;br&gt;or &lt;b&gt;Ollama&lt;/b&gt; → fully local pipeline&lt;br&gt;&lt;font face='Courier New'&gt;Identity()&lt;/font&gt; = provider/model/dims, pinned in &lt;font face='Courier New'&gt;meta&lt;/font&gt;;&lt;br&gt;mismatch at startup ⇒ explicit &lt;font face='Courier New'&gt;lore sync --reembed&lt;/font&gt; error" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1310" y="665" width="430" height="140" as="geometry"/></mxCell><mxCell id="1Sysc30" value="&lt;b&gt;LLM provider (OPTIONAL)&lt;/b&gt;&lt;br&gt;OpenAI · Anthropic · Z.AI · Ollama&lt;br&gt;used ONLY by SynthesisService for CLI/gRPC&lt;br&gt;MCP needs &lt;b&gt;zero&lt;/b&gt; LLM key on the server (D1)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1310" y="825" width="430" height="120" as="geometry"/></mxCell><mxCell id="1Sysc31" value="&lt;b&gt;Privacy / posture&lt;/b&gt;&lt;br&gt;• Lore is &lt;b&gt;read-only&lt;/b&gt; toward every source — it never writes to GitHub, Notion, or Jira&lt;br&gt;• Private text leaves the machine only toward the configured embedder / LLM — documented loudly&lt;br&gt;• Ollama for both ⇒ nothing leaves the machine" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1310" y="965" width="430" height="140" as="geometry"/></mxCell><mxCell id="1Sysc81" value="&lt;b&gt;Call semantics (edge labels omitted for clarity)&lt;/b&gt;&lt;br&gt;• every transport → service call is the same request type; the only difference is the &lt;font face='Courier New'&gt;synthesize&lt;/font&gt; flag (D2): MCP false, CLI/gRPC true&lt;br&gt;• sync verbs: &lt;font face='Courier New'&gt;lore sync&lt;/font&gt; (CLI) · &lt;font face='Courier New'&gt;sync_now&lt;/font&gt; / &lt;font face='Courier New'&gt;sync_status&lt;/font&gt; (MCP) · &lt;font face='Courier New'&gt;SyncService.Trigger&lt;/font&gt; / &lt;font face='Courier New'&gt;Status&lt;/font&gt; / &lt;font face='Courier New'&gt;Watch&lt;/font&gt; (gRPC) — all land on SyncOrchestrator&lt;br&gt;• dashed = optional path (sync, synthesis, network egress) · solid = the always-on query path" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="415" y="1270" width="790" height="100" as="geometry"/></mxCell><mxCell id="1Syse82" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc6" target="1Sysc12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse83" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc7" target="1Sysc15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="400"/><mxPoint x="1250" y="310"/></Array></mxGeometry></mxCell><mxCell id="1Syse84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc8" target="1Sysc14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="560"/><mxPoint x="380" y="235"/><mxPoint x="880" y="235"/></Array></mxGeometry></mxCell><mxCell id="1Syse85" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc12" target="1Sysc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc13" target="1Sysc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse87" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc14" target="1Sysc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc15" target="1Sysc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc12" target="1Sysc17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc15" target="1Sysc17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse91" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc15" target="1Sysc19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse92" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc14" target="1Sysc19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse93" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc16" target="1Sysc20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse94" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.08;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc16" target="1Sysc21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse95" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc17" target="1Sysc20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse96" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc17" target="1Sysc21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse97" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc18" target="1Sysc20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse98" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc19" target="1Sysc21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse99" value="SQL · FTS5 · vec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc20" target="1Sysc22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse100" value="git shell-out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc21" target="1Sysc23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse101" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=1;exitY=0.12;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc21" target="1Sysc26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse102" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=1;exitY=0.28;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc21" target="1Sysc27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse103" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=1;exitY=0.44;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc21" target="1Sysc28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse104" value="embed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=1;exitY=0.66;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc21" target="1Sysc29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Syse105" value="chat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=1;exitY=0.86;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1Sysc21" target="1Sysc30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p2" name="2 · Problem &amp; Personas"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2260" pageHeight="1340" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2Proc1" value="PROBLEM, CONCEPT &amp; PERSONAS — what Lore is for, and why the shape follows" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="36" as="geometry"/></mxCell><mxCell id="2Proc2" value="docs/v3/01-overview.md. Codebase RAG tools answer &lt;i&gt;what&lt;/i&gt; code is. Lore answers &lt;i&gt;why decisions were made and what happened next&lt;/i&gt; — whether or not the question touches code at all." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1700" height="40" as="geometry"/></mxCell><mxCell id="2Proc3" value="&lt;b&gt;The problem — teams lose their &lt;i&gt;why&lt;/i&gt;&lt;/b&gt;&lt;br&gt;Decisions are made in incident channels, Jira tickets, Notion pages, PR&lt;br&gt;reviews. Then people rotate, context scatters, and six months later nobody&lt;br&gt;can answer:&lt;br&gt;&lt;br&gt;• Why did we choose option B instead of A when incident X happened?&lt;br&gt;• At the moment of X, why did we do A — and what impact did we get?&lt;br&gt;• Why does this function have a weird retry with a 250ms sleep?&lt;br&gt;• Who added this check, what bug forced it, and is it still needed?&lt;br&gt;• Which repos and services were affected by decision X?&lt;br&gt;&lt;br&gt;The answers exist — scattered across tickets, design docs, postmortems, PR&lt;br&gt;descriptions, review threads, commit messages. Nobody reads that trail&lt;br&gt;manually. &lt;b&gt;No single source is sufficient&lt;/b&gt;: a commit that says only&lt;br&gt;&lt;font face='Courier New'&gt;JIRA-4521&lt;/font&gt; carries no reasoning; the reasoning lives in the ticket; the&lt;br&gt;&lt;i&gt;consequences&lt;/i&gt; live in documents written weeks later." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="660" height="280" as="geometry"/></mxCell><mxCell id="2Proc4" value="&lt;b&gt;1 · Ingest&lt;/b&gt;&lt;br&gt;documents from configured sources (GitHub, Notion, Jira in v1) into a&lt;br&gt;normalized store. Sources are independent; &lt;b&gt;any subset works&lt;/b&gt;, including&lt;br&gt;workspaces with no repository at all." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="660" height="90" as="geometry"/></mxCell><mxCell id="2Proc5" value="&lt;b&gt;2 · Resolve&lt;/b&gt;&lt;br&gt;cross-source references (ticket keys, URLs, SHAs, file paths) into a typed&lt;br&gt;&lt;b&gt;edge graph&lt;/b&gt;: ticket → design doc → PR → review thread → commit, in any&lt;br&gt;direction the links actually exist." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="660" height="90" as="geometry"/></mxCell><mxCell id="2Proc6" value="&lt;b&gt;3 · Answer&lt;/b&gt;&lt;br&gt;provenance questions through &lt;b&gt;one query pipeline&lt;/b&gt; that combines graph walks&lt;br&gt;with hybrid semantic retrieval (BM25 + vectors) and time anchoring ('when&lt;br&gt;incident X happened'), returning an &lt;b&gt;EvidenceBundle&lt;/b&gt; where every claim&lt;br&gt;carries a source URL." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="660" height="100" as="geometry"/></mxCell><mxCell id="2Proe7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="2Proc4" target="2Proc5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Proe8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="2Proc5" target="2Proc6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Proc9" value="&lt;b&gt;Honesty is a feature&lt;/b&gt;&lt;br&gt;When the trail ends, Lore says so — 'trail ends at PROJ-4521; no linked follow-up' — instead of fabricating. Every tool reports &lt;font face='Courier New'&gt;Gaps&lt;/font&gt;." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="660" height="80" as="geometry"/></mxCell><mxCell id="2Proc10" value="&lt;b&gt;Name&lt;/b&gt;&lt;br&gt;Working name &lt;font face='Courier New'&gt;lore&lt;/font&gt; — short, meaningful ('accumulated tribal knowledge'), good CLI ergonomics (&lt;font face='Courier New'&gt;lore ask&lt;/font&gt;, &lt;font face='Courier New'&gt;lore why&lt;/font&gt;, &lt;font face='Courier New'&gt;lore impact&lt;/font&gt;).&lt;br&gt;Check GitHub + package registries for collisions before first public release." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="866" width="660" height="90" as="geometry"/></mxCell><mxCell id="2Proc11" value="TWO PERSONAS, ONE ENGINE" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="760" y="112" width="700" height="26" as="geometry"/></mxCell><mxCell id="2Proc12" value="Ask-only workspace (no repos)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="760" y="146" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc13" value="Code-anchored workspace" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1130" y="146" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc14" value="sources: Jira + Notion (± GitHub issues/PRs)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="760" y="186" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc15" value="the same, plus local clones registered" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1130" y="186" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc16" value="'Why B over A during incident X?' → &lt;font face='Courier New'&gt;find_decision&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="760" y="226" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc17" value="'Why does auth.go:40-55 exist?' → &lt;font face='Courier New'&gt;why&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1130" y="226" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc18" value="'What impact did decision A have?' → &lt;font face='Courier New'&gt;impact_of&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="760" y="266" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc19" value="'How did this file evolve?' → &lt;font face='Courier New'&gt;history_of&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1130" y="266" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc20" value="anchors: query, document, time window" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="760" y="306" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc21" value="additional anchor: code span (blame)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1130" y="306" width="370" height="40" as="geometry"/></mxCell><mxCell id="2Proc22" value="&lt;b&gt;Nothing in the first column is degraded&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;find_decision&lt;/font&gt;, &lt;font face='Courier New'&gt;trace&lt;/font&gt;, and &lt;font face='Courier New'&gt;impact_of&lt;/font&gt; run the full walk with chains and gaps.&lt;br&gt;The second column is the first column &lt;b&gt;plus one extra anchor type&lt;/b&gt; (Δ1–Δ3)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="760" y="356" width="740" height="80" as="geometry"/></mxCell><mxCell id="2Proc23" value="ANCHOR UNION — &lt;font face='Courier New'&gt;EvidenceBundle.Anchor&lt;/font&gt; (Δ7)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="760" y="456" width="700" height="26" as="geometry"/></mxCell><mxCell id="2Proc24" value="&lt;b&gt;query&lt;/b&gt;&lt;br&gt;free-text question&lt;br&gt;&lt;font face='Courier New'&gt;find_decision&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="492" width="170" height="70" as="geometry"/></mxCell><mxCell id="2Proc25" value="&lt;b&gt;document&lt;/b&gt;&lt;br&gt;resolved ref&lt;br&gt;&lt;font face='Courier New'&gt;trace&lt;/font&gt; · &lt;font face='Courier New'&gt;impact_of&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="950" y="492" width="170" height="70" as="geometry"/></mxCell><mxCell id="2Proc26" value="&lt;b&gt;time_window&lt;/b&gt;&lt;br&gt;event resolution&lt;br&gt;combines with query/doc" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1140" y="492" width="180" height="70" as="geometry"/></mxCell><mxCell id="2Proc27" value="&lt;b&gt;code_span&lt;/b&gt;&lt;br&gt;blame — OPTIONAL&lt;br&gt;&lt;font face='Courier New'&gt;why&lt;/font&gt; · &lt;font face='Courier New'&gt;history_of&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1340" y="492" width="160" height="70" as="geometry"/></mxCell><mxCell id="2Proc28" value="&lt;b&gt;one typed union, not a code-shaped struct&lt;/b&gt;&lt;br&gt;generalizing later would have broken the bundle contract on every surface" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="590" width="740" height="60" as="geometry"/></mxCell><mxCell id="2Proe29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Proc24" target="2Proc28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Proe30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Proc25" target="2Proc28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Proe31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Proc26" target="2Proc28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Proe32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Proc27" target="2Proc28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Proc33" value="GOALS" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="760" y="680" width="700" height="26" as="geometry"/></mxCell><mxCell id="2Proc34" value="• answer 'why was this decided' and 'what impact did it have' with cited, verifiable evidence — with or without a codebase&lt;br&gt;• treat every source as an optional connector; Jira-only, Notion-only, GitHub-only, and any combination fully supported&lt;br&gt;• keep code provenance excellent: &lt;font face='Courier New'&gt;git blame&lt;/font&gt; anchoring, rename-aware history, commit → PR → review → issue chains&lt;br&gt;• be useful from an AI agent (MCP), a terminal (CLI), and programmatically (gRPC, future web UI)&lt;br&gt;• local-first: index in a single SQLite file; private credentials never leave the machine; fully-local mode via Ollama&lt;br&gt;• ship as a single &lt;b&gt;pure-Go&lt;/b&gt; binary (no cgo in the default build)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="714" width="740" height="170" as="geometry"/></mxCell><mxCell id="2Proc35" value="DIFFERENTIATORS" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1540" y="112" width="660" height="26" as="geometry"/></mxCell><mxCell id="2Proc36" value="Typical codebase RAG" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1540" y="146" width="320" height="26" as="geometry"/></mxCell><mxCell id="2Proc37" value="Lore" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1860" y="146" width="340" height="26" as="geometry"/></mxCell><mxCell id="2Proc38" value="indexes code (the &lt;i&gt;what&lt;/i&gt;)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1540" y="172" width="320" height="46" as="geometry"/></mxCell><mxCell id="2Proc39" value="indexes decisions (the &lt;i&gt;why&lt;/i&gt; and the &lt;i&gt;what happened next&lt;/i&gt;)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1860" y="172" width="340" height="46" as="geometry"/></mxCell><mxCell id="2Proc40" value="requires a repository" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1540" y="218" width="320" height="46" as="geometry"/></mxCell><mxCell id="2Proc41" value="repository optional; Jira/Notion-only workspaces are first-class" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1860" y="218" width="340" height="46" as="geometry"/></mxCell><mxCell id="2Proc42" value="single repo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1540" y="264" width="320" height="32" as="geometry"/></mxCell><mxCell id="2Proc43" value="multi-repo, multi-source workspace; cross-source edges" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1860" y="264" width="340" height="32" as="geometry"/></mxCell><mxCell id="2Proc44" value="returns similar chunks" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1540" y="296" width="320" height="52" as="geometry"/></mxCell><mxCell id="2Proc45" value="returns a cited provenance &lt;i&gt;chain&lt;/i&gt; (graph walk + retrieval + time anchor)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1860" y="296" width="340" height="52" as="geometry"/></mxCell><mxCell id="2Proc46" value="no temporal reasoning" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1540" y="348" width="320" height="52" as="geometry"/></mxCell><mxCell id="2Proc47" value="event resolution ('when incident X happened') and forward-in-time impact tracing" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1860" y="348" width="340" height="52" as="geometry"/></mxCell><mxCell id="2Proc48" value="server synthesizes prose with its own LLM" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1540" y="400" width="320" height="60" as="geometry"/></mxCell><mxCell id="2Proc49" value="MCP returns structured evidence; the calling agent synthesizes. No LLM key needed on the server" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1860" y="400" width="340" height="60" as="geometry"/></mxCell><mxCell id="2Proc50" value="&lt;b&gt;Landscape — why this niche is open&lt;/b&gt;&lt;br&gt;Saturated: 'index codebase → vector DB → semantic search' MCP servers —&lt;br&gt;project-rag · code-graph-rag · claude-context · codebase-memory-mcp.&lt;br&gt;All index the &lt;i&gt;what&lt;/i&gt;; all require code.&lt;br&gt;&lt;b&gt;Not covered by any of them&lt;/b&gt;: cross-source decision provenance with&lt;br&gt;citation-grounded evidence, temporal anchoring, and impact tracing." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1540" y="470" width="660" height="130" as="geometry"/></mxCell><mxCell id="2Proc51" value="&lt;b&gt;Locked decisions (README)&lt;/b&gt;&lt;br&gt;• Go, layered architecture, Uber FX for DI&lt;br&gt;• single SQLite file per workspace (FTS5 + sqlite-vec, RRF in Go); default build pure Go via ncruces WASM bindings&lt;br&gt;• transports: MCP stdio, MCP Streamable HTTP, gRPC + mTLS, CLI — gRPC is the programmatic API, not an MCP transport&lt;br&gt;• one pipeline, four seed modes; every tool returns the same EvidenceBundle with Chains and Gaps&lt;br&gt;• v1 connectors GitHub + Notion + Jira; contract keeps GitLab / Confluence / ClickUp / Slack drop-in; every connector and the repo list itself optional&lt;br&gt;• embeddings pluggable, cloud default (OpenAI), Ollama for fully-local&lt;br&gt;• LLM synthesis pluggable and optional — MCP never requires an LLM key on the server&lt;br&gt;• sync: background scheduler + manual trigger sharing a lease lock; checkpointable batches resume mid-source&lt;br&gt;• five narrow MCP verbs over one stable bundle; tools deprecate in place, the bundle changes additively&lt;br&gt;• plugin ecosystem deferred; the connector seam stays plugin-ready via three disciplines" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1540" y="620" width="660" height="264" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p3" name="3 · Layered Architecture"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2Layc1" value="LAYERED ARCHITECTURE — transport → service → repository/connector (strictly one-directional, wired with Uber FX)" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="36" as="geometry"/></mxCell><mxCell id="2Layc2" value="docs/v3/02-architecture.md. Dependency arrows point downward only. Nothing in a lower band knows the band above it; the EvidenceBundle is the single artifact that crosses layers outward." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1500" height="40" as="geometry"/></mxCell><mxCell id="2Layc3" value="TRANSPORT LAYER — protocol parsing, schema validation, error mapping. No store access, no connector access, no business logic." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1560" height="300" as="geometry"/></mxCell><mxCell id="2Layc4" value="SERVICE LAYER — all business logic, orchestration, validation, classification of errors." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1560" height="380" as="geometry"/></mxCell><mxCell id="2Layc5" value="REPOSITORY / CONNECTOR LAYER — pure I/O adapters. Repository talks only to the DB; connectors talk only to their API. Zero business logic." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1560" height="360" as="geometry"/></mxCell><mxCell id="2Layc6" value="&lt;b&gt;mcp — stdio&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore mcp&lt;/font&gt; · official Go MCP SDK&lt;br&gt;registers 7 tools with JSON schemas +&lt;br&gt;routing hints in descriptions&lt;br&gt;returns &lt;b&gt;EvidenceBundle JSON&lt;/b&gt;, never prose&lt;br&gt;error ⇒ MCP tool error result&lt;br&gt;deprecation in place: old tool keeps its&lt;br&gt;registration with 'deprecated — use X'&lt;br&gt;for one release (D9)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="360" height="210" as="geometry"/></mxCell><mxCell id="2Layc7" value="&lt;b&gt;mcp — Streamable HTTP&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore serve --http=:8080&lt;/font&gt; → &lt;font face='Courier New'&gt;/mcp&lt;/font&gt;&lt;br&gt;same tool set, same handlers as stdio&lt;br&gt;AI-side surface despite the word HTTP&lt;br&gt;off-loopback bind without TLS is rejected&lt;br&gt;at startup" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="190" width="360" height="210" as="geometry"/></mxCell><mxCell id="2Layc8" value="&lt;b&gt;grpc — controllers + mTLS&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore serve --grpc=:9090 [--mtls]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore.v1.QueryService&lt;/font&gt; (5 unary RPCs)&lt;br&gt;&lt;font face='Courier New'&gt;lore.v1.SyncService&lt;/font&gt; Trigger/Status/Watch&lt;br&gt;&lt;font face='Courier New'&gt;Watch&lt;/font&gt; = server-streaming SyncEvent&lt;br&gt;error ⇒ gRPC status code&lt;br&gt;TLS RequireAndVerifyClientCert vs client CA" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="190" width="360" height="210" as="geometry"/></mxCell><mxCell id="2Layc9" value="&lt;b&gt;cli — commands&lt;/b&gt;&lt;br&gt;flag parsing, workspace resolution&lt;br&gt;pretty-printers: provenance tree, impact&lt;br&gt;timeline, sync status table&lt;br&gt;&lt;font face='Courier New'&gt;--raw&lt;/font&gt; ⇒ bundle as JSON (scripting)&lt;br&gt;error ⇒ exit code + stderr" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1200" y="190" width="380" height="210" as="geometry"/></mxCell><mxCell id="2Layc10" value="&lt;b&gt;QueryService&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;FindDecision(q, around?, filters?)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Why(repo, file, l1, l2, q?)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Trace(ref, dir?, depth?)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;ImpactOf(refOrQuery, q?)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;HistoryOf(path, repo?, limit, before)&lt;/font&gt;&lt;br&gt;one pipeline · four seed modes · every verb&lt;br&gt;fills Chains + Gaps&lt;br&gt;validates: workspace initialized, embedder&lt;br&gt;identity matches meta, repo required only&lt;br&gt;for why/history_of, ref resolves to exactly&lt;br&gt;one doc, all limits capped" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="360" height="300" as="geometry"/></mxCell><mxCell id="2Layc11" value="&lt;b&gt;SyncOrchestrator&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;RunRound(ctx, source?)&lt;/font&gt; · scheduler goroutine&lt;br&gt;ticks every &lt;font face='Courier New'&gt;scheduler.interval&lt;/font&gt; (30m)&lt;br&gt;manual trigger acquires the lease or errors&lt;br&gt;verbosely; scheduler &lt;b&gt;skips&lt;/b&gt; its round when&lt;br&gt;the lease is held&lt;br&gt;per connector: cursor → stream batches →&lt;br&gt;upsert → chunk → embed → refs → commit →&lt;br&gt;&lt;b&gt;persist batch.Cursor&lt;/b&gt; (D8)&lt;br&gt;then one LinkResolver pass" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="510" width="360" height="300" as="geometry"/></mxCell><mxCell id="2Layc12" value="&lt;b&gt;LinkResolver&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;ResolvePass(ctx)&lt;/font&gt;&lt;br&gt;reads &lt;font face='Courier New'&gt;pending_refs&lt;/font&gt; + refs from this round&lt;br&gt;matches by URL / ticket key / SHA prefix /&lt;br&gt;file path via indexed columns (no scans)&lt;br&gt;writes typed edges, INSERT OR IGNORE&lt;br&gt;Src = body that contains the ref,&lt;br&gt;Dst = referenced doc — direction is known,&lt;br&gt;never guessed" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="820" y="510" width="360" height="300" as="geometry"/></mxCell><mxCell id="2Layc13" value="&lt;b&gt;SynthesisService&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Synthesize(bundle, question) (string, error)&lt;/font&gt;&lt;br&gt;system prompt: answer ONLY from evidence,&lt;br&gt;cite node URL per claim, state gaps, respect&lt;br&gt;timeline ordering for impact answers&lt;br&gt;output: markdown + inline [n] citations +&lt;br&gt;source list&lt;br&gt;missing llm config ⇒ clear error naming the&lt;br&gt;remedy; MCP unaffected (never calls it)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1200" y="510" width="380" height="300" as="geometry"/></mxCell><mxCell id="2Layc14" value="&lt;b&gt;IndexStore (repository interface)&lt;/b&gt;&lt;br&gt;UpsertDocuments · ReplaceChunks&lt;br&gt;SearchLexical · SearchVector  (two ranked lists;&lt;br&gt;  RRF fusion stays in the service layer)&lt;br&gt;ResolveRef → []DocumentMeta (all candidates)&lt;br&gt;UpsertEdges · Neighbors(ids, kinds, dir)&lt;br&gt;Cursor / SetCursor · PendingRefs&lt;br&gt;TryAcquireLease · HeartbeatLease · ReleaseLease&lt;br&gt;Meta / SetMeta&lt;br&gt;impl: SQLite via ncruces/go-sqlite3 (WASM) +&lt;br&gt;sqlite-vec ncruces bindings — cgo pairing is a&lt;br&gt;drop-in alternative behind the same interface" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="920" width="400" height="280" as="geometry"/></mxCell><mxCell id="2Layc15" value="&lt;b&gt;Connector (one interface per source)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Name() string&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Changes(ctx, Cursor) iter.Seq2[Batch, error]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Batch{ Docs []Document; Cursor Cursor }&lt;/font&gt;&lt;br&gt;impls: &lt;b&gt;github&lt;/b&gt; · &lt;b&gt;notion&lt;/b&gt; · &lt;b&gt;jira&lt;/b&gt;  (v1)&lt;br&gt;future: gitlab · confluence · clickup · slack&lt;br&gt;rules: read-only · no business logic ·&lt;br&gt;entities-only imports · both timestamps set ·&lt;br&gt;resumable + idempotent by DocID ·&lt;br&gt;conformance-suite tested" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480" y="920" width="380" height="280" as="geometry"/></mxCell><mxCell id="2Layc16" value="&lt;b&gt;GitRepo (not a Connector)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Blame(ctx, path, l1, l2) []BlameSpan&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Log(ctx, path) []CommitRef&lt;/font&gt;&lt;br&gt;shells out to &lt;font face='Courier New'&gt;git&lt;/font&gt; (blame --porcelain,&lt;br&gt;log --follow) — zero deps&lt;br&gt;constructed only when &lt;font face='Courier New'&gt;repos:&lt;/font&gt; is non-empty" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="880" y="920" width="340" height="280" as="geometry"/></mxCell><mxCell id="2Layc17" value="&lt;b&gt;Embedder / LLM&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Embed(ctx, texts) [][]float32&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Identity() string&lt;/font&gt;  // openai/…/1536&lt;br&gt;&lt;font face='Courier New'&gt;Complete(ctx, system, user) string&lt;/font&gt;&lt;br&gt;providers behind config keys:&lt;br&gt;embedder = openai | ollama&lt;br&gt;llm = openai | anthropic | zai | ollama" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1240" y="920" width="340" height="280" as="geometry"/></mxCell><mxCell id="2Layc18" value="&lt;b&gt;EvidenceBundle — THE stability boundary (D9)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Question · Anchor · Nodes[] · Chains[][] · Gaps[]&lt;/font&gt;&lt;br&gt;consumed by every surface ⇒ changes are additive only.&lt;br&gt;Produced by QueryService · returned as-is on MCP · the input SynthesisService turns into cited prose. Tools are disposable verbs over it." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="510" width="540" height="130" as="geometry"/></mxCell><mxCell id="2Layc19" value="&lt;b&gt;Layering rules — no exceptions&lt;/b&gt;&lt;br&gt;1. Transport calls &lt;b&gt;only&lt;/b&gt; services. The MCP path is not special: the harness AI drives the tool loop, every tool call still goes through a service.&lt;br&gt;2. Services orchestrate repositories + connectors and own all logic and validation.&lt;br&gt;3. IndexStore talks only to SQLite; connectors only to their API. Neither classifies errors.&lt;br&gt;4. Connector packages import &lt;font face='Courier New'&gt;entities&lt;/font&gt; + stdlib only — never services, repositories, or each other (keeps the plugin seam viable)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1620" y="120" width="540" height="190" as="geometry"/></mxCell><mxCell id="2Layc20" value="&lt;b&gt;Error handling — &lt;font face='Courier New'&gt;internalerror&lt;/font&gt; package&lt;/b&gt;&lt;br&gt;constructors: NewBadRequestError · NewNotFoundError · NewPreconditionError · NewInternalError · …&lt;br&gt;• connectors / repository: raw errors with context wrapping, no classification&lt;br&gt;• services: classify. Notable preconditions —&lt;br&gt;   'no repositories registered — code anchoring disabled for this workspace' (why / history_of)&lt;br&gt;   'embedder identity mismatch — run lore sync --reembed'&lt;br&gt;   'sync lease held by &amp;lt;holder&amp;gt;' (manual trigger)&lt;br&gt;   'ambiguous ref — candidates: …' (trace / impact_of)&lt;br&gt;• transports: map to protocol-native form (MCP tool error · gRPC status · CLI exit code + stderr)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1620" y="660" width="540" height="210" as="geometry"/></mxCell><mxCell id="2Layc21" value="&lt;b&gt;Testing strategy (per layer)&lt;/b&gt;&lt;br&gt;services — gomock for IndexStore + every connector; table-driven tests for graph walk, event resolution, impact windowing, ranking (pure functions where possible)&lt;br&gt;repository — integration tests against a temp SQLite file&lt;br&gt;connectors — httptest servers replaying recorded GitHub/Notion/Jira fixtures; retry, pagination, batch-checkpoint covered explicitly; plus the shared conformance suite&lt;br&gt;transports — mocked services; assert request parsing + error mapping&lt;br&gt;e2e ask-only — fixture Jira + Notion servers, zero repos: sync → find_decision / impact_of; assert citation chain + chronological timeline&lt;br&gt;e2e code-anchored — fixture git repo + fixture API server: sync → why; assert the blame-seeded chain" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1620" y="890" width="540" height="260" as="geometry"/></mxCell><mxCell id="2Layc22" value="&lt;b&gt;Project structure (planned)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;cmd/lore/                  single entry point&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;internal/transport/{mcp,grpc,cli}&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;internal/services/&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;internal/repositories/      IndexStore&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;internal/connectors/{github,notion,jira,&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    gitrepo,embedder,llm}&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;internal/di/                Uber FX modules&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;internal/entities/          Document, Edge,&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    Anchor, EvidenceBundle, Cursor, Batch&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;internal/errors/internalerror/&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;internal/config/            lore.yaml&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;api/proto/lore/v1/          gRPC contract&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1620" y="1170" width="540" height="260" as="geometry"/></mxCell><mxCell id="2Layc44" value="&lt;b&gt;Uber FX wiring&lt;/b&gt;&lt;br&gt;each layer is an FX module: config → store → connectors (only the configured ones) → services → the transport selected by the subcommand.&lt;br&gt;Adding a source = one package + one FX provider. Swapping SQLite for another backend = one provider change (03 — store portability)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1240" width="1520" height="90" as="geometry"/></mxCell><mxCell id="2Laye62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc6" target="2Layc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc7" target="2Layc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc8" target="2Layc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc9" target="2Layc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc6" target="2Layc11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc8" target="2Layc11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc9" target="2Layc11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc8" target="2Layc13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc9" target="2Layc13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc10" target="2Layc14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc10" target="2Layc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc10" target="2Layc17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc11" target="2Layc15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc11" target="2Layc14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc11" target="2Layc17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye77" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc12" target="2Layc14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2Laye78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2Layc13" target="2Layc17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p4" name="4 · Query Engine"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2360" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3Quec1" value="QUERY ENGINE — one pipeline, four seed modes, five verbs, one result shape" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="36" as="geometry"/></mxCell><mxCell id="3Quec2" value="docs/v3/05-query-engine.md + 02 (D2, D3). Only the seed step differs per verb; walk, expansion, ranking, chain assembly, and gap reporting are shared. Every verb fills Chains and Gaps — the ask-only path gets the full engine, not a stripped retrieval endpoint." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1600" height="40" as="geometry"/></mxCell><mxCell id="3Quec3" value="SEED MODES — the only per-verb difference" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="112" width="600" height="26" as="geometry"/></mxCell><mxCell id="3Quec4" value="&lt;b&gt;find_decision (primary)&lt;/b&gt;&lt;br&gt;&lt;b&gt;anchor&lt;/b&gt;: free-text query ± time window&lt;br&gt;&lt;b&gt;seed&lt;/b&gt;: hybrid retrieval (BM25 + vectors + RRF)&lt;br&gt;of the question, filters applied, top-k chunks&lt;br&gt;lifted to their parent documents&lt;br&gt;&lt;b&gt;walk&lt;/b&gt;: both directions, depth ≤ 3&lt;br&gt;&lt;b&gt;expansion&lt;/b&gt;: none — seeding &lt;i&gt;is&lt;/i&gt; retrieval&lt;br&gt;&lt;b&gt;repos required&lt;/b&gt;: no, ever&lt;br&gt;gaps: 'PROJ-4521 stands alone; no linked&lt;br&gt;discussion' · unresolved event candidates" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="420" height="250" as="geometry"/></mxCell><mxCell id="3Quec5" value="&lt;b&gt;why (code-anchored)&lt;/b&gt;&lt;br&gt;&lt;b&gt;anchor&lt;/b&gt;: code span (repo, file, L1–L2)&lt;br&gt;&lt;b&gt;seed&lt;/b&gt;: &lt;font face='Courier New'&gt;git blame --porcelain&lt;/font&gt; on the local clone&lt;br&gt;→ contributing commit SHAs per line&lt;br&gt;&lt;b&gt;walk&lt;/b&gt;: both — commit → PR → review threads →&lt;br&gt;linked tickets/issues → linked pages&lt;br&gt;&lt;b&gt;expansion&lt;/b&gt;: embed question (optional) + blamed&lt;br&gt;code span + commit subjects; drop nodes the walk&lt;br&gt;already found; keep top-k as semantic_match&lt;br&gt;&lt;b&gt;repos required&lt;/b&gt;: yes — else precondition error" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="500" y="150" width="420" height="250" as="geometry"/></mxCell><mxCell id="3Quec6" value="&lt;b&gt;trace (drill-down)&lt;/b&gt;&lt;br&gt;&lt;b&gt;anchor&lt;/b&gt;: one document&lt;br&gt;&lt;b&gt;seed&lt;/b&gt;: &lt;font face='Courier New'&gt;ResolveRef&lt;/font&gt;(SHA / PR# / ticket key /&lt;br&gt;URL / DocID) → exactly one doc&lt;br&gt;(ambiguous ⇒ error listing candidates)&lt;br&gt;&lt;b&gt;walk&lt;/b&gt;: &lt;font face='Courier New'&gt;direction&lt;/font&gt; param (out|in|both, default both),&lt;br&gt;depth ≤ 2&lt;br&gt;&lt;b&gt;expansion&lt;/b&gt;: none (mechanical neighborhood)&lt;br&gt;returns the &lt;b&gt;full body&lt;/b&gt;, nodes chronological&lt;br&gt;&lt;b&gt;repos required&lt;/b&gt;: no" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="940" y="150" width="420" height="250" as="geometry"/></mxCell><mxCell id="3Quec7" value="&lt;b&gt;impact_of (consequences)&lt;/b&gt;&lt;br&gt;&lt;b&gt;anchor&lt;/b&gt;: document + its CreatedAt = T&lt;br&gt;(ref via ResolveRef, or free text → top doc,&lt;br&gt;interpretation recorded in Anchor.Doc)&lt;br&gt;&lt;b&gt;seed&lt;/b&gt;: the resolved document&lt;br&gt;&lt;b&gt;walk&lt;/b&gt;: edges traversed both ways mechanically,&lt;br&gt;keep only nodes with &lt;font face='Courier New'&gt;CreatedAt &amp;gt; T&lt;/font&gt; — in practice&lt;br&gt;incoming references_doc / mentions_commit +&lt;br&gt;supersedes chains. depth ≤ 3&lt;br&gt;&lt;b&gt;expansion&lt;/b&gt;: retrieval hard-filtered created_at &amp;gt; T&lt;br&gt;&lt;b&gt;output&lt;/b&gt;: chronological timeline, not a rank list" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1380" y="150" width="420" height="250" as="geometry"/></mxCell><mxCell id="3Quec8" value="&lt;b&gt;history_of (file evolution)&lt;/b&gt;&lt;br&gt;&lt;b&gt;anchor&lt;/b&gt;: file path (+ repo)&lt;br&gt;&lt;b&gt;seed&lt;/b&gt;: &lt;font face='Courier New'&gt;git log --follow&lt;/font&gt; commit sequence&lt;br&gt;(rename-aware)&lt;br&gt;&lt;b&gt;walk&lt;/b&gt;: both, 1 hop per commit — attaches each&lt;br&gt;commit's PR / ticket / doc layer via edges&lt;br&gt;&lt;b&gt;expansion&lt;/b&gt;: none&lt;br&gt;&lt;b&gt;output&lt;/b&gt;: chronological timeline, windowed by&lt;br&gt;&lt;font face='Courier New'&gt;limit&lt;/font&gt; + &lt;font face='Courier New'&gt;before&lt;/font&gt; cursor pagination&lt;br&gt;&lt;b&gt;repos required&lt;/b&gt;: yes" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1820" y="150" width="420" height="250" as="geometry"/></mxCell><mxCell id="3Quec9" value="SHARED PIPELINE — identical for all five verbs (D2/D3): resolve anchor → seed → graph walk → semantic expansion → rank → EvidenceBundle" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="2260" height="250" as="geometry"/></mxCell><mxCell id="3Quec10" value="&lt;b&gt;1 · Resolve anchor&lt;/b&gt;&lt;br&gt;typed union (Δ7): query | code_span |&lt;br&gt;document | time_window — combinable&lt;br&gt;(Code+Window, Doc+Window).&lt;br&gt;Event resolution runs here when&lt;br&gt;&lt;font face='Courier New'&gt;around&lt;/font&gt; is supplied." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="350" height="190" as="geometry"/></mxCell><mxCell id="3Quec11" value="&lt;b&gt;2 · Seed documents&lt;/b&gt;&lt;br&gt;retrieval hits → parent docs, or&lt;br&gt;blamed commits, or the resolved doc,&lt;br&gt;or the git-log sequence.&lt;br&gt;Chunk hits are always lifted to their&lt;br&gt;parent document before the walk." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="470" width="350" height="190" as="geometry"/></mxCell><mxCell id="3Quec12" value="&lt;b&gt;3 · Graph walk&lt;/b&gt;&lt;br&gt;breadth-first over &lt;font face='Courier New'&gt;edges&lt;/font&gt;,&lt;br&gt;depth ≤ 3 (config-capped, server-capped),&lt;br&gt;cycle-guarded, direction-aware.&lt;br&gt;confidence &lt;b&gt;multiplies&lt;/b&gt; along the path;&lt;br&gt;tails below floor 0.3 are pruned." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="470" width="350" height="190" as="geometry"/></mxCell><mxCell id="3Quec13" value="&lt;b&gt;4 · Semantic expansion&lt;/b&gt;&lt;br&gt;only where the table says so&lt;br&gt;(why, impact_of).&lt;br&gt;hybrid retrieval over decision-type docs,&lt;br&gt;drop nodes already reached by the walk,&lt;br&gt;keep top-k as &lt;font face='Courier New'&gt;semantic_match&lt;/font&gt; —&lt;br&gt;catches never-linked discussions." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1170" y="470" width="350" height="190" as="geometry"/></mxCell><mxCell id="3Quec14" value="&lt;b&gt;5 · Rank + assemble&lt;/b&gt;&lt;br&gt;score = graph proximity × path confidence&lt;br&gt;× retrieval relevance × time prior.&lt;br&gt;Chains from walk paths; Gaps from dead-end&lt;br&gt;seeds, unresolved events, empty windows.&lt;br&gt;impact_of / history_of re-order chronologically." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1540" y="470" width="350" height="190" as="geometry"/></mxCell><mxCell id="3Quec15" value="&lt;b&gt;6 · EvidenceBundle out&lt;/b&gt;&lt;br&gt;MCP: returned as-is.&lt;br&gt;CLI/gRPC: optionally handed to&lt;br&gt;SynthesisService for cited prose.&lt;br&gt;Every node carries a real URL,&lt;br&gt;or it is not returned." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1910" y="470" width="350" height="190" as="geometry"/></mxCell><mxCell id="3Quee16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec10" target="3Quec11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3Quee17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec11" target="3Quec12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3Quee18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec12" target="3Quec13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3Quee19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec13" target="3Quec14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3Quee20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec14" target="3Quec15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3Quec26" value="EVENT RESOLUTION — &lt;font face='Courier New'&gt;around&lt;/font&gt; → TimeWindow (Δ4)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="500" height="26" as="geometry"/></mxCell><mxCell id="3Quec27" value="&lt;b&gt;input: &lt;font face='Courier New'&gt;around&lt;/font&gt;&lt;/b&gt;&lt;br&gt;free text ('incident X', 'the March outage')&lt;br&gt;or an ISO date" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="736" width="400" height="70" as="geometry"/></mxCell><mxCell id="3Quec28" value="&lt;b&gt;A · date given&lt;/b&gt;&lt;br&gt;window = date ± &lt;font face='Courier New'&gt;event_window&lt;/font&gt; (default 30d, configurable)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="826" width="400" height="60" as="geometry"/></mxCell><mxCell id="3Quec29" value="&lt;b&gt;B · free text, hits agree&lt;/b&gt;&lt;br&gt;hybrid retrieval of the event text → take top hits' &lt;font face='Courier New'&gt;CreatedAt&lt;/font&gt;.&lt;br&gt;If they agree (span ≤ 2 × event_window): anchor time = earliest&lt;br&gt;agreeing hit, window = anchor ± event_window." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="896" width="400" height="90" as="geometry"/></mxCell><mxCell id="3Quec30" value="&lt;b&gt;C · ambiguous (hits scattered in time)&lt;/b&gt;&lt;br&gt;no window — proceed unwindowed and record a Gap:&lt;br&gt;&quot;could not resolve event 'X' to a time — candidates: &amp;lt;top 3 with&lt;br&gt;dates and URLs&amp;gt;&quot;. The agent retries with a date or better phrase." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="996" width="400" height="90" as="geometry"/></mxCell><mxCell id="3Quec31" value="&lt;b&gt;effect of a resolved window&lt;/b&gt;&lt;br&gt;• applied as a &lt;font face='Courier New'&gt;created_at&lt;/font&gt; range filter on seed retrieval&lt;br&gt;• flips the ranking time prior: unanchored = mild recency boost →&lt;br&gt;  anchored = &lt;b&gt;proximity to the window&lt;/b&gt; (recency would be actively&lt;br&gt;  wrong for 'at the moment of X' questions)&lt;br&gt;• returned in &lt;font face='Courier New'&gt;Anchor.Window&lt;/font&gt; with its derivation, so answers are&lt;br&gt;  auditable: &quot;interpreted 'incident X' as 2025-03-12 via INC-201&quot;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="1096" width="400" height="140" as="geometry"/></mxCell><mxCell id="3Quee32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3Quec27" target="3Quec28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3Quee35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec28" target="3Quec31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3Quee36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec29" target="3Quec31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3Quec37" value="RANKING &amp; WALK PARAMETERS" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="500" y="700" width="400" height="26" as="geometry"/></mxCell><mxCell id="3Quec38" value="&lt;b&gt;score(node)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;graph proximity&lt;/font&gt;   fewer hops ⇒ higher&lt;br&gt;&lt;font face='Courier New'&gt;× path confidence&lt;/font&gt; product of edge confidences&lt;br&gt;&lt;font face='Courier New'&gt;× retrieval relevance&lt;/font&gt; when a question exists&lt;br&gt;&lt;font face='Courier New'&gt;× time prior&lt;/font&gt;       recency &lt;i&gt;or&lt;/i&gt; window proximity" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="736" width="420" height="110" as="geometry"/></mxCell><mxCell id="3Quec39" value="&lt;b&gt;Hybrid retrieval (03)&lt;/b&gt;&lt;br&gt;1 · BM25 over &lt;font face='Courier New'&gt;chunks_fts&lt;/font&gt; — exact identifiers, ticket&lt;br&gt;keys, error strings score well lexically&lt;br&gt;2 · vector KNN over &lt;font face='Courier New'&gt;chunk_vectors&lt;/font&gt; — paraphrase&lt;br&gt;('why Postgres' ↔ 'database selection rationale')&lt;br&gt;3 · &lt;b&gt;RRF in Go&lt;/b&gt;: score(d) = Σ 1/(k + rank_i(d)), k = 60&lt;br&gt;4 · metadata filters pushed into SQL: source, repo_ref,&lt;br&gt;doc_type, created_at range" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="856" width="420" height="150" as="geometry"/></mxCell><mxCell id="3Quec40" value="&lt;b&gt;Caps &amp; knobs (&lt;font face='Courier New'&gt;query:&lt;/font&gt; in lore.yaml, server-capped)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;event_window: 30d&lt;/font&gt; · &lt;font face='Courier New'&gt;walk_depth: 3&lt;/font&gt; · &lt;font face='Courier New'&gt;top_k: 12&lt;/font&gt;&lt;br&gt;confidence floor 0.3 · RRF k = 60 · trace depth ≤ 2&lt;br&gt;excerpt size + timeline window capped — MCP clients&lt;br&gt;cannot request unbounded output&lt;br&gt;(scoring constants are open question #2 in 07)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="500" y="1016" width="420" height="120" as="geometry"/></mxCell><mxCell id="3Quec41" value="&lt;b&gt;Gaps — honesty is a feature&lt;/b&gt;&lt;br&gt;dead-end seed · unresolved event · empty impact window&lt;br&gt;('no follow-up evidence after 2025-03-12' is itself an answer)&lt;br&gt;never papered over, never fabricated" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="1146" width="420" height="90" as="geometry"/></mxCell><mxCell id="3Quec42" value="QUERY-TIME VALIDATION (service layer)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="960" y="700" width="500" height="26" as="geometry"/></mxCell><mxCell id="3Quec43" value="Check" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="960" y="736" width="190" height="26" as="geometry"/></mxCell><mxCell id="3Quec44" value="Failure mode" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1150" y="736" width="330" height="26" as="geometry"/></mxCell><mxCell id="3Quec45" value="workspace exists + initialized" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="960" y="762" width="190" height="30" as="geometry"/></mxCell><mxCell id="3Quec46" value="precondition error" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1150" y="762" width="330" height="30" as="geometry"/></mxCell><mxCell id="3Quec47" value="embedder identity in &lt;font face='Courier New'&gt;meta&lt;/font&gt; == config" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="960" y="792" width="190" height="34" as="geometry"/></mxCell><mxCell id="3Quec48" value="explicit re-embed error (&lt;font face='Courier New'&gt;lore sync --reembed&lt;/font&gt;)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1150" y="792" width="330" height="34" as="geometry"/></mxCell><mxCell id="3Quec49" value="find_decision / trace / impact_of" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="960" y="826" width="190" height="30" as="geometry"/></mxCell><mxCell id="3Quec50" value="no repo required, ever" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1150" y="826" width="330" height="30" as="geometry"/></mxCell><mxCell id="3Quec51" value="why / history_of: ≥ 1 repo registered" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="960" y="856" width="190" height="46" as="geometry"/></mxCell><mxCell id="3Quec52" value="'no repositories registered — code anchoring disabled for this workspace'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1150" y="856" width="330" height="46" as="geometry"/></mxCell><mxCell id="3Quec53" value="why: file exists at HEAD, span valid" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="960" y="902" width="190" height="30" as="geometry"/></mxCell><mxCell id="3Quec54" value="bad-request error" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1150" y="902" width="330" height="30" as="geometry"/></mxCell><mxCell id="3Quec55" value="trace / impact_of ref → exactly 1 doc" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="960" y="932" width="190" height="34" as="geometry"/></mxCell><mxCell id="3Quec56" value="error listing candidate documents" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1150" y="932" width="330" height="34" as="geometry"/></mxCell><mxCell id="3Quec57" value="all limits (depth, top-k, excerpt, window)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="960" y="966" width="190" height="34" as="geometry"/></mxCell><mxCell id="3Quec58" value="clamped server-side, silently capped" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1150" y="966" width="330" height="34" as="geometry"/></mxCell><mxCell id="3Quec59" value="SYNTHESIS (non-AI surfaces only)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="960" y="1010" width="500" height="26" as="geometry"/></mxCell><mxCell id="3Quec60" value="&lt;b&gt;SynthesisService&lt;/b&gt;&lt;br&gt;input: EvidenceBundle + original question&lt;br&gt;system prompt: &lt;i&gt;answer ONLY from the provided evidence; cite the&lt;br&gt;node URL for every claim; state gaps explicitly; respect timeline&lt;br&gt;ordering for impact questions&lt;/i&gt;&lt;br&gt;output: markdown prose, inline [n] citations mapped to node URLs,&lt;br&gt;closing source list&lt;br&gt;provider: user-configured LLMConnector (openai | anthropic | zai |&lt;br&gt;ollama). Missing config ⇒ clear error naming the remedy.&lt;br&gt;MCP surfaces are unaffected — they never call synthesis (D1)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="960" y="1046" width="500" height="190" as="geometry"/></mxCell><mxCell id="3Quec61" value="THE ONE RESULT SHAPE" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1500" y="700" width="500" height="26" as="geometry"/></mxCell><mxCell id="3Quec62" value="&lt;b&gt;&lt;font face='Courier New'&gt;type EvidenceBundle struct {&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Question string   // normalized restatement&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Anchor   Anchor   // how it was grounded&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Nodes    []EvidenceNode // by relevance;&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;                   // impact_of: chronological&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Chains   [][]DocID // [ticket, page, pr, commit]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Gaps     []string  // 'trail ends at PROJ-4521;&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;                     //  no linked follow-up'&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1500" y="736" width="800" height="150" as="geometry"/></mxCell><mxCell id="3Quec63" value="&lt;b&gt;&lt;font face='Courier New'&gt;type Anchor struct {&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Kind   AnchorKind  // query | code_span | document | time_window&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Query  string      // find_decision: question as used for retrieval&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Code   *CodeAnchor // why/history_of: repo, file, span, blamed SHAs&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Doc    *DocRef     // trace/impact_of: resolved anchor document&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Window *TimeWindow // event resolution: from, to, how derived&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}   // combinable: Code+Window, Doc+Window&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1500" y="900" width="800" height="125" as="geometry"/></mxCell><mxCell id="3Quec64" value="&lt;b&gt;&lt;font face='Courier New'&gt;type EvidenceNode struct {&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Doc     DocumentMeta // id, source, type, title, author, url, created_at, updated_at&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Excerpt string       // the relevant span, not the whole body&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Role    string       // seed | blamed_commit | review_thread | linked_ticket |&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;                       // linked_change | design_doc | follow_up | semantic_match&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Score   float32&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Via     []Edge       // how it was reached; empty for pure retrieval hits&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1500" y="1040" width="800" height="135" as="geometry"/></mxCell><mxCell id="3Quec65" value="&lt;b&gt;Invariants&lt;/b&gt;&lt;br&gt;• every node carries a real URL — no URL ⇒ not evidence ⇒ not returned&lt;br&gt;• gaps are explicit; a dead-end trail is reported&lt;br&gt;• every verb fills Chains and Gaps — the ask-only path is not second-class&lt;br&gt;• excerpts are extracted spans; full bodies come from &lt;font face='Courier New'&gt;trace&lt;/font&gt; on the node ID, keeping default MCP responses token-cheap&lt;br&gt;• the bundle is additive-only (D9/Δ16); verbs may be added or retired around it" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1500" y="1190" width="800" height="110" as="geometry"/></mxCell><mxCell id="3Quec66" value="↓  all five seed modes feed step 2 — everything from step 2 onward is identical  ↓" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="404" width="2200" height="22" as="geometry"/></mxCell><mxCell id="3Quee67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.03;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec27" target="3Quec29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="46" y="818"/><mxPoint x="46" y="932"/></Array></mxGeometry></mxCell><mxCell id="3Quee68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.06;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="3Quec27" target="3Quec30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="34" y="818"/><mxPoint x="34" y="1032"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p5" name="5 · Data Model &amp; Storage"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2260" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="4Datc1" value="DATA MODEL &amp; STORAGE — one Document shape, one typed Edge graph, one SQLite file per workspace" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="36" as="geometry"/></mxCell><mxCell id="4Datc2" value="docs/v3/03-data-model.md. Everything any connector produces normalizes to Document + RawRef; the LinkResolver turns RawRefs into typed Edges. RepoRef is a metadata dimension, not a partition — one index holds many repos and repo-less documents side by side, so cross-repo / cross-source questions work for free." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1700" height="40" as="geometry"/></mxCell><mxCell id="4Datc3" value="ENTITIES — versioned, additive-only" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="112" width="520" height="26" as="geometry"/></mxCell><mxCell id="4Datc4" value="&lt;b&gt;&lt;font face='Courier New'&gt;type Document struct {&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  ID        DocID     // &quot;&amp;lt;source&amp;gt;:&amp;lt;type&amp;gt;:&amp;lt;external_id&amp;gt;&quot;, globally unique&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Source    string    // github | notion | jira | (later gitlab, slack…)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Type      DocType   // open set, see below&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  RepoRef   string    // &quot;github:owner/repo&quot; — EMPTY for non-repo docs&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Title     string&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Body      string    // normalized plain text / markdown&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Author    string&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  URL       string    // canonical web URL — THE citation target&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  CreatedAt time.Time // when the thing happened (event time)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  UpdatedAt time.Time // last edit (freshness / sync watermark)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Refs      []RawRef  // unresolved references found in the body&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="148" width="540" height="215" as="geometry"/></mxCell><mxCell id="4Datc5" value="&lt;b&gt;&lt;font face='Courier New'&gt;type RawRef struct {&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Kind  RefKind // url | ticket_key | commit_sha | file_path | pr_number&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Value string  // &quot;https://notion.so/…&quot;, &quot;PROJ-123&quot;, &quot;abc123&quot;,&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;                //  &quot;internal/auth/auth.go&quot;&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="375" width="540" height="95" as="geometry"/></mxCell><mxCell id="4Datc6" value="&lt;b&gt;&lt;font face='Courier New'&gt;type Edge struct {&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Src        DocID    // the doc whose body contains the reference&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Dst        DocID    // the referenced doc&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Kind       EdgeKind // commit_in_pr | pr_closes_issue | references_doc |&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;                      // mentions_commit | mentions_path | supersedes&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Confidence float32  // 1.0 explicit API link … 0.5 fuzzy text match&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="482" width="540" height="120" as="geometry"/></mxCell><mxCell id="4Datc7" value="&lt;b&gt;Direction is the whole trick (Δ5 / Δ12)&lt;/b&gt;&lt;br&gt;Edges are directional and traversal direction is a &lt;b&gt;query-time&lt;/b&gt; parameter&lt;br&gt;(&lt;font face='Courier New'&gt;Neighbors(..., dir)&lt;/font&gt;). &lt;b&gt;Incoming&lt;/b&gt; edges to a decision document, filtered&lt;br&gt;by time, are how &lt;font face='Courier New'&gt;impact_of&lt;/font&gt; finds consequences — no special 'impact'&lt;br&gt;edge kind exists. &lt;font face='Courier New'&gt;authored_follow_up&lt;/font&gt; from v1 was deleted (produced by&lt;br&gt;nothing); &lt;font face='Courier New'&gt;supersedes&lt;/font&gt; was added for ADR-style 'supersedes / replaced by'." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="614" width="540" height="120" as="geometry"/></mxCell><mxCell id="4Datc8" value="&lt;b&gt;CreatedAt vs UpdatedAt (Δ8) — not interchangeable&lt;/b&gt;&lt;br&gt;A postmortem edited yesterday still &lt;i&gt;belongs to&lt;/i&gt; last year's incident.&lt;br&gt;• &lt;b&gt;CreatedAt&lt;/b&gt; drives: event resolution, impact filtering (&lt;font face='Courier New'&gt;&amp;gt; T&lt;/font&gt;), timeline order&lt;br&gt;• &lt;b&gt;UpdatedAt&lt;/b&gt; drives: sync watermarks, freshness only&lt;br&gt;Sources without a true creation time set &lt;font face='Courier New'&gt;CreatedAt = UpdatedAt&lt;/font&gt; and the&lt;br&gt;connector's package doc says so." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="746" width="540" height="120" as="geometry"/></mxCell><mxCell id="4Datc9" value="&lt;b&gt;DocType — open set&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;commit · pr · pr_review · review_comment · issue · issue_comment&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;page · ticket · ticket_comment&lt;/font&gt;&lt;br&gt;A new connector MAY introduce a type; unknown types get the default&lt;br&gt;chunking strategy and rank as ordinary evidence (no core change)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="878" width="540" height="100" as="geometry"/></mxCell><mxCell id="4Datc10" value="CHUNKING — type-aware, with a defined default" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="995" width="540" height="26" as="geometry"/></mxCell><mxCell id="4Datc11" value="DocType" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="60" y="1026" width="190" height="26" as="geometry"/></mxCell><mxCell id="4Datc12" value="Strategy" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="250" y="1026" width="350" height="26" as="geometry"/></mxCell><mxCell id="4Datc13" value="commit" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1052" width="190" height="32" as="geometry"/></mxCell><mxCell id="4Datc14" value="whole message = one chunk (subject weighted into the title field)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="250" y="1052" width="350" height="32" as="geometry"/></mxCell><mxCell id="4Datc15" value="pr / issue / ticket / page" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1084" width="190" height="46" as="geometry"/></mxCell><mxCell id="4Datc16" value="split on markdown headings / paragraph groups, target ~300–500 tokens, small overlap" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="250" y="1084" width="350" height="46" as="geometry"/></mxCell><mxCell id="4Datc17" value="review_comment / issue_comment / ticket_comment" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1130" width="190" height="58" as="geometry"/></mxCell><mxCell id="4Datc18" value="one comment = one chunk; thread id kept in metadata so retrieval can rehydrate the thread" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="250" y="1130" width="350" height="58" as="geometry"/></mxCell><mxCell id="4Datc19" value="any other / future type" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1188" width="190" height="46" as="geometry"/></mxCell><mxCell id="4Datc20" value="default: heading + paragraph split, ~300–500 tokens, small overlap" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="250" y="1188" width="350" height="46" as="geometry"/></mxCell><mxCell id="4Datc21" value="&lt;b&gt;Every chunk carries filterable metadata&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;doc_id · source · repo_ref · doc_type · author · created_at · updated_at&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="1264" width="540" height="50" as="geometry"/></mxCell><mxCell id="4Datc22" value="SQLITE SCHEMA — &lt;font face='Courier New'&gt;~/.lore/&amp;lt;workspace&amp;gt;.db&lt;/font&gt; (path configurable)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="640" y="112" width="760" height="26" as="geometry"/></mxCell><mxCell id="4Datc23" value="&lt;b&gt;documents&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;doc_id PK · source · doc_type · repo_ref&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;title · body (full, for excerpts) · author&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;url (indexed) · created_at · updated_at&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;external_key (indexed) — ticket keys, PR #&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;sha_prefix (indexed) — commit SHA lookup&lt;/font&gt;&lt;br&gt;full body retained: excerpts are extracted,&lt;br&gt;and &lt;font face='Courier New'&gt;trace&lt;/font&gt; returns whole bodies on demand" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="148" width="360" height="160" as="geometry"/></mxCell><mxCell id="4Datc24" value="&lt;b&gt;chunks&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;chunk_id PK (rowid) · doc_id FK → documents&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;ord · text · token_est&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;source · repo_ref · doc_type · author&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;created_at · updated_at (denormalized&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  for filter push-down)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;thread_id (comments)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1040" y="148" width="360" height="160" as="geometry"/></mxCell><mxCell id="4Datc25" value="&lt;b&gt;chunks_fts  — FTS5 virtual table&lt;/b&gt;&lt;br&gt;BM25 over chunk text · lexical arm of hybrid retrieval&lt;br&gt;wins on exact identifiers, ticket keys, error strings" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="360" height="90" as="geometry"/></mxCell><mxCell id="4Datc26" value="&lt;b&gt;chunk_vectors — sqlite-vec virtual table&lt;/b&gt;&lt;br&gt;rowid-aligned with &lt;font face='Courier New'&gt;chunks&lt;/font&gt; · vector KNN arm&lt;br&gt;dimension fixed by the embedder identity in &lt;font face='Courier New'&gt;meta&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1040" y="330" width="360" height="90" as="geometry"/></mxCell><mxCell id="4Datc27" value="&lt;b&gt;edges&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;src FK · dst FK · kind · confidence&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;UNIQUE(src, dst, kind)&lt;/font&gt; — INSERT OR IGNORE&lt;br&gt;indexed on &lt;b&gt;both&lt;/b&gt; src and dst → direction-aware&lt;br&gt;walks (DirOut / DirIn / DirBoth) with no scans" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="442" width="360" height="110" as="geometry"/></mxCell><mxCell id="4Datc28" value="&lt;b&gt;pending_refs&lt;/b&gt;&lt;br&gt;RawRefs whose target is not ingested yet&lt;br&gt;&lt;font face='Courier New'&gt;src_doc_id · kind · value · first_seen · attempts&lt;/font&gt;&lt;br&gt;retried every sync round; a Notion page linked&lt;br&gt;from a PR may arrive after the PR" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1040" y="442" width="360" height="110" as="geometry"/></mxCell><mxCell id="4Datc29" value="&lt;b&gt;cursors&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;connector PK · cursor_blob · updated_at&lt;/font&gt;&lt;br&gt;per-connector incremental sync position;&lt;br&gt;written only &lt;b&gt;after&lt;/b&gt; its batch is durable" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="574" width="360" height="90" as="geometry"/></mxCell><mxCell id="4Datc30" value="&lt;b&gt;sync_lock  — single-row lease&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;holder · acquired_at · heartbeat_at&lt;/font&gt;&lt;br&gt;heartbeat older than TTL (60s) ⇒ dead, may be&lt;br&gt;taken over: a crashed sync never wedges the&lt;br&gt;scheduler; also guards multi-process access" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1040" y="574" width="360" height="110" as="geometry"/></mxCell><mxCell id="4Datc31" value="&lt;b&gt;meta&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;schema_version&lt;/font&gt; · &lt;font face='Courier New'&gt;embedder_identity&lt;/font&gt; (provider+model+dims)&lt;br&gt;changing the embedder invalidates every vector ⇒ detected at&lt;br&gt;startup, surfaced as an explicit error with the &lt;font face='Courier New'&gt;lore sync --reembed&lt;/font&gt;&lt;br&gt;remedy. Never silent, never a quiet quality regression." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="640" y="700" width="760" height="110" as="geometry"/></mxCell><mxCell id="4Datc37" value="HYBRID RETRIEVAL — fusion happens in Go, never in SQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="640" y="830" width="760" height="26" as="geometry"/></mxCell><mxCell id="4Datc38" value="&lt;b&gt;query text&lt;/b&gt;&lt;br&gt;+ filters: source, repo_ref, doc_type,&lt;br&gt;created_at range (event window)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="640" y="866" width="220" height="80" as="geometry"/></mxCell><mxCell id="4Datc39" value="&lt;b&gt;Embed(query)&lt;/b&gt;&lt;br&gt;embedder connector" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="900" y="866" width="200" height="80" as="geometry"/></mxCell><mxCell id="4Datc40" value="&lt;b&gt;SearchLexical&lt;/b&gt;&lt;br&gt;BM25 / FTS5 → ranked list A" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="976" width="340" height="70" as="geometry"/></mxCell><mxCell id="4Datc41" value="&lt;b&gt;SearchVector&lt;/b&gt;&lt;br&gt;sqlite-vec KNN → ranked list B" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1020" y="976" width="380" height="70" as="geometry"/></mxCell><mxCell id="4Datc42" value="&lt;b&gt;RRF fusion (service layer)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;score(d) = Σ 1/(k + rank_i(d)) , k = 60&lt;/font&gt;&lt;br&gt;any backend that can rank lexically and by vector distance qualifies" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="1076" width="760" height="80" as="geometry"/></mxCell><mxCell id="4Datc43" value="&lt;b&gt;lift chunks → parent documents&lt;/b&gt;&lt;br&gt;seeds for the shared walk / rank machinery (05)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="1186" width="760" height="60" as="geometry"/></mxCell><mxCell id="4Datc50" value="STORE CONTRACT &amp; PORTABILITY" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1440" y="112" width="700" height="26" as="geometry"/></mxCell><mxCell id="4Datc51" value="&lt;b&gt;&lt;font face='Courier New'&gt;type IndexStore interface {&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // documents &amp;amp; chunks — batch upserts atomic internally;&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // no transaction type ever leaks out of the store&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  UpsertDocuments(ctx, docs []Document) error&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  ReplaceChunks(ctx, docID DocID, chunks []Chunk) error&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // retrieval — two independently ranked lists&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  SearchLexical(ctx, query string, f Filters, k int) ([]ChunkHit, error)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  SearchVector(ctx, emb []float32, f Filters, k int) ([]ChunkHit, error)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // ref resolution — URL, ticket key, SHA prefix, PR/issue #, DocID&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  ResolveRef(ctx, ref string) ([]DocumentMeta, error)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // graph — direction-aware traversal&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  UpsertEdges(ctx, edges []Edge) error&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Neighbors(ctx, ids []DocID, kinds []EdgeKind, dir Direction) ([]Edge, error)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // sync bookkeeping&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Cursor(ctx, connector string) (Cursor, error)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  SetCursor(ctx, connector string, c Cursor) error&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  PendingRefs(ctx) ([]PendingRef, error)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // lease lock — SQLite: lease row; Postgres: advisory lock. Same semantics.&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  TryAcquireLease(ctx, holder string) (bool, error)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  HeartbeatLease(ctx, holder string) error&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  ReleaseLease(ctx, holder string) error&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Meta(ctx, key string) (string, error)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  SetMeta(ctx, key, value string) error&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;type Direction int // DirOut (src→dst) | DirIn (dst→src) | DirBoth&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1440" y="148" width="700" height="470" as="geometry"/></mxCell><mxCell id="4Datc52" value="&lt;b&gt;Portability rules baked into the design&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Fusion in Go, not SQL.&lt;/b&gt; The store returns ranked lists; RRF lives in the service layer. FTS5+sqlite-vec, tsvector+pgvector, Elastic — all qualify.&lt;br&gt;• &lt;b&gt;The index is derived data.&lt;/b&gt; Sources are ground truth; the index is a rebuildable cache. Switching backends = re-sync + re-embed against a fresh store — no data-migration tooling, ever.&lt;br&gt;• &lt;b&gt;No leaked SQL types.&lt;/b&gt; Callers never see transactions, rowids, or virtual-table details.&lt;br&gt;• Config gains a &lt;font face='Courier New'&gt;store:&lt;/font&gt; key (&lt;font face='Courier New'&gt;sqlite&lt;/font&gt; default) only when a second backend lands — not before (YAGNI).&lt;br&gt;• Honest cost of a new backend: schema + interface impl + integration tests + vector-dimension handling. Bounded to one package, not free." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1440" y="638" width="700" height="210" as="geometry"/></mxCell><mxCell id="4Datc53" value="&lt;b&gt;Driver choice (D6 / Δ13)&lt;/b&gt;&lt;br&gt;&lt;b&gt;default: ncruces/go-sqlite3 (WASM)&lt;/b&gt; with sqlite-vec embedded via the official&lt;br&gt;sqlite-vec-go-bindings &lt;font face='Courier New'&gt;ncruces&lt;/font&gt; package → pure Go, no cgo, clean cross-compilation.&lt;br&gt;&lt;b&gt;alternative:&lt;/b&gt; mattn/go-sqlite3 + sqlite-vec cgo bindings, drop-in behind IndexStore.&lt;br&gt;M1 benchmarks on a realistic corpus decide whether the cgo pairing is ever needed&lt;br&gt;(named risk: 'WASM SQLite slower than cgo' → query latency)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1440" y="868" width="700" height="130" as="geometry"/></mxCell><mxCell id="4Datc54" value="&lt;b&gt;Why one SQLite file per workspace&lt;/b&gt;&lt;br&gt;• zero external infra — nothing to run, nothing to operate&lt;br&gt;• single-file portability and trivial backup&lt;br&gt;• offline queries after sync&lt;br&gt;• trivial integration tests (temp file per test)&lt;br&gt;• &lt;font face='Courier New'&gt;RepoRef&lt;/font&gt; is metadata, not a partition ⇒ 'which repos were affected by decision X'&lt;br&gt;  is an ordinary query over one index that also holds repo-less documents" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1440" y="1018" width="700" height="150" as="geometry"/></mxCell><mxCell id="4Datc55" value="&lt;b&gt;Ref-lookup indexes (no table scans)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;documents.url&lt;/font&gt; · &lt;font face='Courier New'&gt;documents.external_key&lt;/font&gt; (ticket keys, PR/issue numbers) ·&lt;br&gt;&lt;font face='Courier New'&gt;documents.sha_prefix&lt;/font&gt; — all populated at ingest. Both &lt;font face='Courier New'&gt;ResolveRef&lt;/font&gt; and the&lt;br&gt;LinkResolver use them, which is what makes ticket-key and SHA-prefix&lt;br&gt;resolution cheap enough to run on every sync round." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1440" y="1188" width="700" height="120" as="geometry"/></mxCell><mxCell id="4Date56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc23" target="4Datc24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc24" target="4Datc25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc24" target="4Datc26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc28" target="4Datc27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc38" target="4Datc39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc38" target="4Datc40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc39" target="4Datc41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc40" target="4Datc42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc41" target="4Datc42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Date66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc42" target="4Datc43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4Datc67" value="&lt;b&gt;What the arrows mean (labels omitted so they never sit on a column list)&lt;/b&gt;&lt;br&gt;• &lt;font face='Courier New'&gt;documents&lt;/font&gt; 1 : N &lt;font face='Courier New'&gt;chunks&lt;/font&gt; — &lt;font face='Courier New'&gt;ReplaceChunks(docID, chunks)&lt;/font&gt; rewrites a document's chunk set atomically&lt;br&gt;• &lt;font face='Courier New'&gt;chunks&lt;/font&gt; → &lt;font face='Courier New'&gt;chunks_fts&lt;/font&gt; — chunk text mirrored into the FTS5 virtual table (lexical arm)&lt;br&gt;• &lt;font face='Courier New'&gt;chunks&lt;/font&gt; → &lt;font face='Courier New'&gt;chunk_vectors&lt;/font&gt; — embeddings written rowid-aligned with the chunk rows (vector arm)&lt;br&gt;• &lt;font face='Courier New'&gt;documents&lt;/font&gt; ← &lt;font face='Courier New'&gt;edges&lt;/font&gt; — &lt;font face='Courier New'&gt;src&lt;/font&gt; and &lt;font face='Courier New'&gt;dst&lt;/font&gt; both FK into documents; indexed on both for direction-aware walks&lt;br&gt;• &lt;font face='Courier New'&gt;pending_refs&lt;/font&gt; → &lt;font face='Courier New'&gt;edges&lt;/font&gt; — a pending ref is promoted to a typed edge once both sides exist (idempotent)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="640" y="1260" width="760" height="120" as="geometry"/></mxCell><mxCell id="4Date68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;exitX=0.02;exitY=1;exitDx=0;exitDy=0;entryX=0.02;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4Datc23" target="4Datc27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="622" y="320"/><mxPoint x="622" y="430"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p6" name="6 · Connectors &amp; Sync"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="1620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="5Conc1" value="CONNECTORS &amp; SYNC — one contract, optional sources, batch-checkpointed streams, lease-locked rounds" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="36" as="geometry"/></mxCell><mxCell id="5Conc2" value="docs/v3/04-connectors-and-sync.md. Every source is a package implementing one interface plus an FX provider. The orchestrator only iterates configured connectors, so Jira-only, Notion-only, GitHub-only, and any combination are fully supported." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1700" height="40" as="geometry"/></mxCell><mxCell id="5Conc3" value="&lt;b&gt;&lt;font face='Courier New'&gt;type Connector interface {&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Name() string // &quot;github&quot;, &quot;notion&quot;, &quot;jira&quot;, …&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // Changes streams batches of documents modified since cursor,&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // oldest-first. Each Batch carries the cursor that becomes&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // durable once the batch is committed — the checkpoint unit&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  // IS the batch. Must be resumable and idempotent.&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Changes(ctx context.Context, cursor Cursor) iter.Seq2[Batch, error]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;type Batch struct {&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Docs   []Document&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Cursor Cursor // persist AFTER Docs are durably committed&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f0f8ff;strokeColor=#4d7ea8;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="600" height="230" as="geometry"/></mxCell><mxCell id="5Conc4" value="&lt;b&gt;Why this signature (D8 / Δ10)&lt;/b&gt;&lt;br&gt;The v1 signature returned one final cursor &lt;i&gt;before&lt;/i&gt; the stream was consumed, which made&lt;br&gt;the documented crash-safe resume unimplementable. Now: &lt;b&gt;commit batch → persist that&lt;br&gt;batch's cursor → next batch&lt;/b&gt;. Interrupted backfills resume mid-source with no re-work&lt;br&gt;and no duplicate writes (upserts are idempotent by DocID)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="392" width="600" height="105" as="geometry"/></mxCell><mxCell id="5Conc5" value="&lt;b&gt;Contract rules&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Optional by construction&lt;/b&gt; — lore.yaml declares which sources exist; absent source = not synced, not required.&lt;br&gt;• &lt;b&gt;No business logic&lt;/b&gt; — connectors fetch, paginate, retry, normalize to Document + RawRefs. Ref &lt;i&gt;resolution&lt;/i&gt; is the LinkResolver's job.&lt;br&gt;• &lt;b&gt;Read-only&lt;/b&gt; — no connector ever writes to its source.&lt;br&gt;• Credentials come from env vars &lt;i&gt;named&lt;/i&gt; in config — never stored in lore.yaml or the index.&lt;br&gt;• Both timestamps populated; a source without a true creation time sets CreatedAt = UpdatedAt and says so in its package doc.&lt;br&gt;• &lt;b&gt;Conformance-tested&lt;/b&gt; — resumability, idempotency, batch-cursor honesty, timestamps, read-only behavior.&lt;br&gt;• Entities-only imports: connector packages import &lt;font face='Courier New'&gt;entities&lt;/font&gt; + stdlib, never services, repositories, or each other." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="509" width="600" height="190" as="geometry"/></mxCell><mxCell id="5Conc6" value="&lt;b&gt;GitHubConnector (v1)&lt;/b&gt;&lt;br&gt;&lt;b&gt;auth&lt;/b&gt;: PAT &lt;font face='Courier New'&gt;LORE_GITHUB_TOKEN&lt;/font&gt; — public + private&lt;br&gt;&lt;b&gt;scope&lt;/b&gt;: &lt;font face='Courier New'&gt;sources.github.repos&lt;/font&gt; — independent of local clones;&lt;br&gt;a workspace can index PRs/issues with no repo on disk&lt;br&gt;&lt;b&gt;ingests&lt;/b&gt;: commits (message + metadata) · PRs (body) · PR reviews ·&lt;br&gt;review comments · issues · issue comments&lt;br&gt;&lt;b&gt;API&lt;/b&gt;: GraphQL for backfill (batches related objects, fewer&lt;br&gt;round-trips under rate limits)&lt;br&gt;&lt;b&gt;cursor&lt;/b&gt;: per-repo &lt;font face='Courier New'&gt;updated_at&lt;/font&gt; watermarks&lt;br&gt;&lt;b&gt;RawRefs&lt;/b&gt;: ticket keys in commit/branch/PR text · URLs in bodies&lt;br&gt;(Notion + Jira links!) · &lt;font face='Courier New'&gt;#123&lt;/font&gt; issue/PR refs · commit SHAs ·&lt;br&gt;file paths from the touched-file lists&lt;br&gt;&lt;b&gt;explicit API relations&lt;/b&gt; (PR ↔ closing issue, PR ↔ commits) are&lt;br&gt;emitted as ready-made high-confidence refs" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="700" y="150" width="520" height="250" as="geometry"/></mxCell><mxCell id="5Conc7" value="&lt;b&gt;NotionConnector (v1)&lt;/b&gt;&lt;br&gt;&lt;b&gt;auth&lt;/b&gt;: integration token &lt;font face='Courier New'&gt;LORE_NOTION_TOKEN&lt;/font&gt;&lt;br&gt;&lt;b&gt;scope&lt;/b&gt;: limited to configured &lt;font face='Courier New'&gt;root_pages&lt;/font&gt; subtrees&lt;br&gt;&lt;b&gt;ingests&lt;/b&gt;: pages + block content flattened to markdown-ish text&lt;br&gt;&lt;b&gt;timestamps&lt;/b&gt;: CreatedAt = &lt;font face='Courier New'&gt;created_time&lt;/font&gt;&lt;br&gt;&lt;b&gt;cursor&lt;/b&gt;: &lt;font face='Courier New'&gt;last_edited_time&lt;/font&gt; search watermark&lt;br&gt;&lt;b&gt;RawRefs&lt;/b&gt;: URLs to GitHub PRs/commits/issues and Jira tickets ·&lt;br&gt;repo file paths mentioned in text · ticket keys&lt;br&gt;&lt;b&gt;doc types&lt;/b&gt;: &lt;font face='Courier New'&gt;page&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1240" y="150" width="520" height="250" as="geometry"/></mxCell><mxCell id="5Conc8" value="&lt;b&gt;JiraConnector (v1) — Δ6&lt;/b&gt;&lt;br&gt;&lt;b&gt;target&lt;/b&gt;: Jira &lt;b&gt;Cloud&lt;/b&gt; (Data Center post-v1: same package, 2nd auth mode)&lt;br&gt;&lt;b&gt;auth&lt;/b&gt;: email + API token (basic) &lt;font face='Courier New'&gt;LORE_JIRA_EMAIL&lt;/font&gt; /&lt;br&gt;&lt;font face='Courier New'&gt;LORE_JIRA_TOKEN&lt;/font&gt; · &lt;font face='Courier New'&gt;base_url: https://&amp;lt;org&amp;gt;.atlassian.net&lt;/font&gt;&lt;br&gt;&lt;b&gt;endpoint&lt;/b&gt;: the &lt;b&gt;new&lt;/b&gt; &lt;font face='Courier New'&gt;/rest/api/3/search/jql&lt;/font&gt; with&lt;br&gt;&lt;font face='Courier New'&gt;nextPageToken&lt;/font&gt; pagination (legacy &lt;font face='Courier New'&gt;/rest/api/3/search&lt;/font&gt; is deprecated)&lt;br&gt;&lt;b&gt;cursor&lt;/b&gt;: JQL watermark — &lt;font face='Courier New'&gt;project IN (…) AND updated &amp;gt;=&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;&quot;&amp;lt;watermark&amp;gt;&quot; ORDER BY updated ASC&lt;/font&gt;. Comment edits bump the&lt;br&gt;issue's &lt;font face='Courier New'&gt;updated&lt;/font&gt;, so comment changes re-enter the stream&lt;br&gt;automatically; re-ingest is idempotent by DocID.&lt;br&gt;&lt;b&gt;ingests&lt;/b&gt;: issues → &lt;font face='Courier New'&gt;ticket&lt;/font&gt; (summary + description),&lt;br&gt;comments → &lt;font face='Courier New'&gt;ticket_comment&lt;/font&gt;; ADF flattened to plain text&lt;br&gt;&lt;b&gt;why it matters&lt;/b&gt;: this connector is what makes ticket-key refs from&lt;br&gt;commits / PRs / Notion actually &lt;i&gt;resolve&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1780" y="150" width="520" height="250" as="geometry"/></mxCell><mxCell id="5Conc9" value="&lt;b&gt;GitConnector — local clones, NOT a &lt;font face='Courier New'&gt;Connector&lt;/font&gt;&lt;/b&gt;&lt;br&gt;separate small interface; entirely optional. Absent &lt;font face='Courier New'&gt;repos:&lt;/font&gt; ⇒ never&lt;br&gt;constructed, and &lt;font face='Courier New'&gt;why&lt;/font&gt; / &lt;font face='Courier New'&gt;history_of&lt;/font&gt; return a precondition error.&lt;br&gt;&lt;font face='Courier New'&gt;Blame(ctx, path, startLine, endLine) ([]BlameSpan, error)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Log(ctx, path) ([]CommitRef, error)&lt;/font&gt;&lt;br&gt;impl: shell out to &lt;font face='Courier New'&gt;git&lt;/font&gt; (&lt;font face='Courier New'&gt;blame --porcelain&lt;/font&gt;, &lt;font face='Courier New'&gt;log --follow&lt;/font&gt;) —&lt;br&gt;robust, zero-dependency, already installed everywhere Lore runs.&lt;br&gt;Local git is ground truth for line attribution; the GitHub/GitLab&lt;br&gt;connectors &lt;i&gt;enrich&lt;/i&gt; those commits with PR/review/issue layers,&lt;br&gt;matched via the &lt;font face='Courier New'&gt;remote:&lt;/font&gt; mapping in config." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="700" y="430" width="520" height="210" as="geometry"/></mxCell><mxCell id="5Conc10" value="&lt;b&gt;EmbedderConnector / LLMConnector&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;type Embedder interface {&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Embed(ctx, texts []string) ([][]float32, error)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Identity() string // &quot;openai/text-embedding-3-small/1536&quot;&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;type LLM interface { // ONLY SynthesisService (non-AI surfaces)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  Complete(ctx, system, user string) (string, error)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;&lt;br&gt;embedder default OpenAI, Ollama for fully-local. LLM providers:&lt;br&gt;OpenAI · Anthropic · Z.AI · Ollama — never required for MCP.&lt;br&gt;&lt;font face='Courier New'&gt;Identity()&lt;/font&gt; is written to &lt;font face='Courier New'&gt;meta&lt;/font&gt; and checked at startup." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1240" y="430" width="520" height="210" as="geometry"/></mxCell><mxCell id="5Conc11" value="&lt;b&gt;Future connectors (post-v1, same contract)&lt;/b&gt;&lt;br&gt;&lt;b&gt;GitLab&lt;/b&gt; — proves the git-host abstraction (MR ≈ PR mapping);&lt;br&gt;strongest evidence the abstraction holds&lt;br&gt;&lt;b&gt;Confluence&lt;/b&gt; · &lt;b&gt;ClickUp&lt;/b&gt;&lt;br&gt;&lt;b&gt;Slack&lt;/b&gt; — decision threads, new &lt;font face='Courier New'&gt;message&lt;/font&gt; DocType&lt;br&gt;Each is a new package + one config entry + one FX provider.&lt;br&gt;&lt;b&gt;Core does not change.&lt;/b&gt; Unknown DocTypes already degrade&lt;br&gt;gracefully to the default chunking strategy." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1780" y="430" width="520" height="210" as="geometry"/></mxCell><mxCell id="5Conc12" value="SYNC ROUND — per configured connector, then one resolver pass" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="900" height="26" as="geometry"/></mxCell><mxCell id="5Conc13" value="&lt;b&gt;1 · load cursor&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;cursors[connector]&lt;/font&gt;&lt;br&gt;empty ⇒ full backfill" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="736" width="200" height="80" as="geometry"/></mxCell><mxCell id="5Conc14" value="&lt;b&gt;2 · stream Changes(cursor)&lt;/b&gt;&lt;br&gt;oldest-first batches&lt;br&gt;pagination + retry inside&lt;br&gt;the connector" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="280" y="736" width="220" height="80" as="geometry"/></mxCell><mxCell id="5Conc15" value="&lt;b&gt;3a · upsert documents&lt;/b&gt;&lt;br&gt;idempotent by DocID" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="736" width="200" height="80" as="geometry"/></mxCell><mxCell id="5Conc16" value="&lt;b&gt;3b · chunk + embed&lt;/b&gt;&lt;br&gt;type-aware chunking;&lt;br&gt;embed new/changed chunks in&lt;br&gt;batches; update FTS + vectors" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="740" y="736" width="220" height="80" as="geometry"/></mxCell><mxCell id="5Conc17" value="&lt;b&gt;3c · store RawRefs&lt;/b&gt;&lt;br&gt;into &lt;font face='Courier New'&gt;pending_refs&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="846" width="200" height="70" as="geometry"/></mxCell><mxCell id="5Conc18" value="&lt;b&gt;3d · commit durably&lt;/b&gt;&lt;br&gt;documents + chunks + vectors&lt;br&gt;+ refs as one atomic unit" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="280" y="846" width="220" height="70" as="geometry"/></mxCell><mxCell id="5Conc19" value="&lt;b&gt;3e · persist batch.Cursor&lt;/b&gt;&lt;br&gt;&lt;b&gt;after&lt;/b&gt; the commit, never before&lt;br&gt;⇒ crash-safe resume at batch&lt;br&gt;granularity" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="520" y="846" width="200" height="70" as="geometry"/></mxCell><mxCell id="5Conc20" value="&lt;b&gt;4 · LinkResolver pass&lt;/b&gt;&lt;br&gt;after ALL connectors finish —&lt;br&gt;cross-source edges need both&lt;br&gt;sides ingested" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="740" y="846" width="220" height="70" as="geometry"/></mxCell><mxCell id="5Cone21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="5Conc13" target="5Conc14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone22" value="per Batch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="5Conc14" target="5Conc15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="5Conc15" target="5Conc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5Conc16" target="5Conc17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="5Conc17" target="5Conc18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="5Conc18" target="5Conc19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="5Conc19" target="5Conc20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone28" value="next batch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="5Conc19" target="5Conc14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="950"/><mxPoint x="390" y="950"/></Array></mxGeometry></mxCell><mxCell id="5Conc29" value="LEASE LOCK — manual trigger wins, scheduler skips its round" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1000" y="700" width="800" height="26" as="geometry"/></mxCell><mxCell id="5Conc30" value="&lt;b&gt;Manual trigger&lt;/b&gt;&lt;br&gt;CLI &lt;font face='Courier New'&gt;lore sync&lt;/font&gt; · MCP &lt;font face='Courier New'&gt;sync_now&lt;/font&gt; ·&lt;br&gt;gRPC &lt;font face='Courier New'&gt;SyncService.Trigger&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1000" y="736" width="280" height="70" as="geometry"/></mxCell><mxCell id="5Conc31" value="&lt;b&gt;Scheduler tick&lt;/b&gt;&lt;br&gt;every &lt;font face='Courier New'&gt;scheduler.interval&lt;/font&gt; (default 30m)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1000" y="826" width="280" height="60" as="geometry"/></mxCell><mxCell id="5Conc32" value="&lt;b&gt;Acquire lease&lt;/b&gt;&lt;br&gt;blocks or errors verbosely:&lt;br&gt;'lease held by &amp;lt;holder&amp;gt;'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1320" y="736" width="220" height="70" as="geometry"/></mxCell><mxCell id="5Conc33" value="&lt;b&gt;TryAcquireLease&lt;/b&gt;&lt;br&gt;held? → yes: &lt;b&gt;skip round&lt;/b&gt;, log the skip&lt;br&gt;no (or heartbeat &amp;gt; TTL 60s ⇒ dead&lt;br&gt;holder): take over" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1320" y="826" width="260" height="80" as="geometry"/></mxCell><mxCell id="5Conc34" value="&lt;b&gt;RUN SYNC ROUND&lt;/b&gt;&lt;br&gt;single writer per workspace file" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1620" y="736" width="240" height="70" as="geometry"/></mxCell><mxCell id="5Conc35" value="&lt;b&gt;Heartbeat every 15s&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;heartbeat_at = now()&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1620" y="826" width="240" height="60" as="geometry"/></mxCell><mxCell id="5Conc36" value="&lt;b&gt;Release on finish&lt;/b&gt;&lt;br&gt;deferred; crash ⇒ TTL takeover" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1620" y="906" width="240" height="60" as="geometry"/></mxCell><mxCell id="5Cone37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="5Conc30" target="5Conc32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="5Conc31" target="5Conc33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Conc43" value="&lt;b&gt;The same lock covers&lt;/b&gt;&lt;br&gt;• scheduler vs scheduler (a long round overlapping the next tick)&lt;br&gt;• manual vs scheduled (manual wins; the tick logs a skip)&lt;br&gt;• multiple processes sharing one workspace file — e.g. a &lt;font face='Courier New'&gt;lore serve&lt;/font&gt;&lt;br&gt;  daemon plus an ad-hoc CLI run&lt;br&gt;A crashed sync never wedges the scheduler: the heartbeat goes stale,&lt;br&gt;the lease expires, the next tick takes it over." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1900" y="736" width="400" height="230" as="geometry"/></mxCell><mxCell id="5Conc44" value="LINK RESOLVER — RawRefs → typed edges (second pass)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="990" width="900" height="26" as="geometry"/></mxCell><mxCell id="5Conc45" value="RawRef" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="60" y="1026" width="300" height="26" as="geometry"/></mxCell><mxCell id="5Conc46" value="Resolution" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="360" y="1026" width="300" height="26" as="geometry"/></mxCell><mxCell id="5Conc47" value="Edge kind" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="660" y="1026" width="200" height="26" as="geometry"/></mxCell><mxCell id="5Conc48" value="Confidence" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="860" y="1026" width="100" height="26" as="geometry"/></mxCell><mxCell id="5Conc49" value="explicit API relation (GitHub)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1052" width="300" height="32" as="geometry"/></mxCell><mxCell id="5Conc50" value="direct — no matching needed" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1052" width="300" height="32" as="geometry"/></mxCell><mxCell id="5Conc51" value="&lt;font face='Courier New'&gt;commit_in_pr&lt;/font&gt;, &lt;font face='Courier New'&gt;pr_closes_issue&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="660" y="1052" width="200" height="32" as="geometry"/></mxCell><mxCell id="5Conc52" value="1.0" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="860" y="1052" width="100" height="32" as="geometry"/></mxCell><mxCell id="5Conc53" value="URL to a known document" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1084" width="300" height="28" as="geometry"/></mxCell><mxCell id="5Conc54" value="exact URL match (indexed)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1084" width="300" height="28" as="geometry"/></mxCell><mxCell id="5Conc55" value="&lt;font face='Courier New'&gt;references_doc&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="660" y="1084" width="200" height="28" as="geometry"/></mxCell><mxCell id="5Conc56" value="1.0" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="860" y="1084" width="100" height="28" as="geometry"/></mxCell><mxCell id="5Conc57" value="commit SHA in text" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1112" width="300" height="28" as="geometry"/></mxCell><mxCell id="5Conc58" value="prefix match vs ingested commits" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1112" width="300" height="28" as="geometry"/></mxCell><mxCell id="5Conc59" value="&lt;font face='Courier New'&gt;mentions_commit&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="660" y="1112" width="200" height="28" as="geometry"/></mxCell><mxCell id="5Conc60" value="0.9" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="860" y="1112" width="100" height="28" as="geometry"/></mxCell><mxCell id="5Conc61" value="ticket key &lt;font face='Courier New'&gt;PROJ-123&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1140" width="300" height="28" as="geometry"/></mxCell><mxCell id="5Conc62" value="key match vs ingested tickets/issues" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1140" width="300" height="28" as="geometry"/></mxCell><mxCell id="5Conc63" value="&lt;font face='Courier New'&gt;references_doc&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="660" y="1140" width="200" height="28" as="geometry"/></mxCell><mxCell id="5Conc64" value="0.9" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="860" y="1140" width="100" height="28" as="geometry"/></mxCell><mxCell id="5Conc65" value="'supersedes' / 'replaced by' phrase + resolved ref (ADR-style text)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1168" width="300" height="40" as="geometry"/></mxCell><mxCell id="5Conc66" value="pattern + ref resolution" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1168" width="300" height="40" as="geometry"/></mxCell><mxCell id="5Conc67" value="&lt;font face='Courier New'&gt;supersedes&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="660" y="1168" width="200" height="40" as="geometry"/></mxCell><mxCell id="5Conc68" value="0.8" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="860" y="1168" width="100" height="40" as="geometry"/></mxCell><mxCell id="5Conc69" value="file path in text" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1208" width="300" height="28" as="geometry"/></mxCell><mxCell id="5Conc70" value="path match vs workspace repos" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1208" width="300" height="28" as="geometry"/></mxCell><mxCell id="5Conc71" value="&lt;font face='Courier New'&gt;mentions_path&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="660" y="1208" width="200" height="28" as="geometry"/></mxCell><mxCell id="5Conc72" value="0.7" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="860" y="1208" width="100" height="28" as="geometry"/></mxCell><mxCell id="5Conc73" value="&lt;b&gt;Resolver invariants&lt;/b&gt;&lt;br&gt;• Unresolved refs stay in &lt;font face='Courier New'&gt;pending_refs&lt;/font&gt; and are retried every round — a Notion page linked from a PR may be ingested &lt;i&gt;after&lt;/i&gt; the PR; the edge appears once both sides exist.&lt;br&gt;• Resolution is idempotent (&lt;font face='Courier New'&gt;INSERT OR IGNORE&lt;/font&gt; semantics) — re-running a round never duplicates edges.&lt;br&gt;• Direction is never guessed: &lt;font face='Courier New'&gt;Src&lt;/font&gt; = the document whose body contained the ref, &lt;font face='Courier New'&gt;Dst&lt;/font&gt; = the referenced document. The resolver always knows which body it came from.&lt;br&gt;• Confidence &lt;b&gt;multiplies&lt;/b&gt; along a walked path, so a 0.7 path-mention two hops out prunes itself below the 0.3 floor." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="1270" width="900" height="140" as="geometry"/></mxCell><mxCell id="5Conc74" value="&lt;b&gt;Rate limits &amp; backfill — the stress case is the first sync&lt;/b&gt;&lt;br&gt;• GraphQL batching (GitHub) — fewer round-trips per object graph&lt;br&gt;• batch-level cursor checkpoints ⇒ interruptible and resumable everywhere&lt;br&gt;• respect &lt;font face='Courier New'&gt;Retry-After&lt;/font&gt; and secondary-limit headers with exponential backoff&lt;br&gt;• per-connector concurrency of 1 in v1 (simple, sufficient)&lt;br&gt;• Jira / Notion pagination is slow ⇒ project + subtree scoping keeps backfill bounded" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1000" y="990" width="660" height="150" as="geometry"/></mxCell><mxCell id="5Conc75" value="&lt;b&gt;Plugin readiness — seam kept viable, transport deferred (D10 / Δ17)&lt;/b&gt;&lt;br&gt;v1 ships every connector &lt;b&gt;in-process&lt;/b&gt;: with three sources, packages beat processes on type safety, testing, and distribution (YAGNI). Three disciplines keep the seam plugin-viable:&lt;br&gt;1 · &lt;b&gt;entities-only dependency&lt;/b&gt; — connectors import entities + stdlib only&lt;br&gt;2 · &lt;b&gt;schemas as if external&lt;/b&gt; — Document, RawRef, Batch, Cursor are versioned and additive-only; they &lt;i&gt;are&lt;/i&gt; the future wire format&lt;br&gt;3 · &lt;b&gt;conformance suite&lt;/b&gt; — one shared table of contract assertions runs against every built-in connector; it becomes the plugin certification suite verbatim&lt;br&gt;When warranted (&amp;gt;5 sources or third-party authors), transport candidates in order: &lt;b&gt;exec + NDJSON batches over stdio&lt;/b&gt; (any language, no SDK) → &lt;b&gt;subprocess gRPC&lt;/b&gt; (hashicorp/go-plugin model) → &lt;b&gt;WASM via wazero&lt;/b&gt; (only option with a real sandbox: HTTP host-function + domain allowlist). Go's native &lt;font face='Courier New'&gt;plugin&lt;/font&gt; package is ruled out — version-locked, no Windows, breaks the pure-Go build.&lt;br&gt;Freeze the wire protocol only after the connector contract stops moving — Δ10 is the cautionary tale." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="1160" width="660" height="300" as="geometry"/></mxCell><mxCell id="5Conc76" value="&lt;b&gt;Plugin trust model — document before accepting third-party plugins&lt;/b&gt;&lt;br&gt;A connector plugin holds its source token: 'read-only' is a &lt;b&gt;promise&lt;/b&gt;, not enforceable for a subprocess.&lt;br&gt;Mitigations when the time comes:&lt;br&gt;• per-plugin env allowlist — a plugin sees only its own &lt;font face='Courier New'&gt;token_env&lt;/font&gt;&lt;br&gt;• checksum-pinned plugin manifest&lt;br&gt;• WASM sandbox for untrusted authors" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1700" y="990" width="600" height="200" as="geometry"/></mxCell><mxCell id="5Conc77" value="&lt;b&gt;Sync observability&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;sync_status&lt;/font&gt; (MCP) / &lt;font face='Courier New'&gt;lore status&lt;/font&gt; (CLI) / &lt;font face='Courier New'&gt;SyncService.Status&lt;/font&gt; (gRPC) report:&lt;br&gt;last run per connector · cursor ages · document + edge counts · lock state.&lt;br&gt;&lt;font face='Courier New'&gt;SyncService.Watch&lt;/font&gt; streams live per-connector phase, counts, and errors —&lt;br&gt;the progress feed a future web UI renders." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1700" y="1210" width="600" height="250" as="geometry"/></mxCell><mxCell id="5Cone78" value="acquired" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="5Conc32" target="5Conc34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="5Conc33" target="5Conc34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1600" y="851"/><mxPoint x="1600" y="792"/></Array></mxGeometry></mxCell><mxCell id="5Cone80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5Conc34" target="5Conc35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5Cone81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5Conc35" target="5Conc36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p7" name="7 · Request Flows"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3160" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7Reqc1" value="REQUEST FLOWS — four end-to-end walkthroughs, step by step" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="36" as="geometry"/></mxCell><mxCell id="7Reqc2" value="docs/v3/02 (request flows) + 05 (tool algorithms). Colour = the layer that owns the step: blue transport · green service · yellow repository/storage · orange connector · red precondition or honesty step." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1700" height="40" as="geometry"/></mxCell><mxCell id="7Reqc3" value="A · MCP · ask-only workspace (Jira + Notion, ZERO repos)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="700" height="26" as="geometry"/></mxCell><mxCell id="7Reqc4" value="&lt;font face='Courier New'&gt;find_decision(&quot;why did we choose option B instead of A?&quot;, around=&quot;incident X&quot;)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="138" width="700" height="40" as="geometry"/></mxCell><mxCell id="7Reqc5" value="&lt;b&gt;1 · AI host → MCP stdio&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;tools/call find_decision{question, around}&lt;/font&gt;&lt;br&gt;client HAS a brain ⇒ it wants evidence, not prose" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="184" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqc6" value="&lt;b&gt;2 · MCP transport → service&lt;/b&gt;&lt;br&gt;parse + JSON-schema validate, map nothing else;&lt;br&gt;&lt;font face='Courier New'&gt;QueryService.FindDecision(req)&lt;/font&gt; with synthesize=false" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="264" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc5" target="7Reqc6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc8" value="&lt;b&gt;3 · Service validation&lt;/b&gt;&lt;br&gt;workspace initialized · embedder identity in &lt;font face='Courier New'&gt;meta&lt;/font&gt; == config&lt;br&gt;no repo requirement on this path, ever (D4)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="344" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc6" target="7Reqc8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc10" value="&lt;b&gt;4 · Event resolution of 'incident X'&lt;/b&gt;&lt;br&gt;hybrid retrieval of the event text → top hits' CreatedAt agree&lt;br&gt;⇒ anchor 2025-03-12 via INC-201, window = anchor ± 30d" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="424" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc8" target="7Reqc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc12" value="&lt;b&gt;5 · Embedder.Embed(question)&lt;/b&gt;&lt;br&gt;one call; OpenAI default, or local Ollama" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="504" width="700" height="50" as="geometry"/></mxCell><mxCell id="7Reqe13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc10" target="7Reqc12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc14" value="&lt;b&gt;6 · Two ranked lists from the store&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;SearchLexical&lt;/font&gt; (BM25/FTS5) + &lt;font face='Courier New'&gt;SearchVector&lt;/font&gt; (sqlite-vec KNN)&lt;br&gt;filters pushed into SQL: created_at ∈ window, source, doc_type" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="568" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc12" target="7Reqc14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc16" value="&lt;b&gt;7 · RRF fusion in Go, then lift&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;score = Σ 1/(60 + rank_i)&lt;/font&gt;&lt;br&gt;top-k chunks → parent documents = the seed set" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="648" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc14" target="7Reqc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc18" value="&lt;b&gt;8 · Graph walk&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Neighbors(seeds, kinds, DirBoth)&lt;/font&gt;, BFS depth ≤ 3, cycle-guarded&lt;br&gt;confidence multiplied along paths, tails below 0.3 pruned" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="728" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc16" target="7Reqc18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc20" value="&lt;b&gt;9 · Rank&lt;/b&gt;&lt;br&gt;proximity × path confidence × question relevance ×&lt;br&gt;&lt;b&gt;window proximity&lt;/b&gt; (not recency — the query is time-anchored)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="808" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc18" target="7Reqc20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc22" value="&lt;b&gt;10 · Assemble bundle&lt;/b&gt;&lt;br&gt;Chains: INC-201 → decision page → PR #482 → commit a1b2c3&lt;br&gt;Nodes: roles seed / linked_ticket / design_doc / linked_change&lt;br&gt;Gaps: 'PROJ-4521 stands alone; no linked discussion'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="888" width="700" height="82" as="geometry"/></mxCell><mxCell id="7Reqe23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc20" target="7Reqc22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc24" value="&lt;b&gt;11 · Return EvidenceBundle as-is&lt;/b&gt;&lt;br&gt;structured JSON; every node carries a real URL&lt;br&gt;zero LLM key needed on the server (D1)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="984" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc22" target="7Reqc24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc26" value="&lt;b&gt;12 · AI synthesizes in its own context&lt;/b&gt;&lt;br&gt;may immediately chain &lt;font face='Courier New'&gt;impact_of(decision page)&lt;/font&gt; or &lt;font face='Courier New'&gt;trace(PR #482)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="1064" width="700" height="50" as="geometry"/></mxCell><mxCell id="7Reqe27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc24" target="7Reqc26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc28" value="&lt;b&gt;Why retrieval seeding matters here&lt;/b&gt;&lt;br&gt;The walk alone would never surface documents that discuss the &lt;b&gt;rejected&lt;/b&gt;&lt;br&gt;alternative A — nothing links to a road not taken. Lexical + semantic&lt;br&gt;seeding does, which is exactly what pure graph tools miss." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="1138" width="700" height="90" as="geometry"/></mxCell><mxCell id="7Reqc29" value="B · MCP · code-anchored workspace" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="700" height="26" as="geometry"/></mxCell><mxCell id="7Reqc30" value="&lt;font face='Courier New'&gt;why(repo=&quot;acme/myproject&quot;, file=&quot;internal/auth/auth.go&quot;, line_start=40, line_end=55)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="820" y="138" width="700" height="40" as="geometry"/></mxCell><mxCell id="7Reqc31" value="&lt;b&gt;1 · AI host → MCP&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;tools/call why{repo, file, line_start, line_end, question?}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="184" width="700" height="50" as="geometry"/></mxCell><mxCell id="7Reqc32" value="&lt;b&gt;2 · Precondition gate&lt;/b&gt;&lt;br&gt;≥ 1 repo registered — else precondition error 'no repositories&lt;br&gt;registered — code anchoring disabled for this workspace' (Δ2).&lt;br&gt;Then: file exists at HEAD, line span valid." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="820" y="248" width="700" height="82" as="geometry"/></mxCell><mxCell id="7Reqe33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc31" target="7Reqc32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc34" value="&lt;b&gt;3 · GitRepo.Blame(path, 40, 55)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;git blame --porcelain&lt;/font&gt; on the &lt;b&gt;local clone&lt;/b&gt; — ground truth for&lt;br&gt;line attribution → contributing commit SHAs per line" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="820" y="344" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc32" target="7Reqc34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc36" value="&lt;b&gt;4 · Blamed SHAs → seed documents&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;ResolveRef(sha)&lt;/font&gt; via the indexed &lt;font face='Courier New'&gt;sha_prefix&lt;/font&gt; column&lt;br&gt;unmatched SHA (commit not ingested) ⇒ recorded as a Gap" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="424" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc34" target="7Reqc36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc38" value="&lt;b&gt;5 · Walk the enrichment layers&lt;/b&gt;&lt;br&gt;commit —&lt;font face='Courier New'&gt;commit_in_pr&lt;/font&gt;→ PR —review→ review threads&lt;br&gt;PR —&lt;font face='Courier New'&gt;pr_closes_issue&lt;/font&gt;→ issue/ticket —&lt;font face='Courier New'&gt;references_doc&lt;/font&gt;→ Notion page" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="504" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc36" target="7Reqc38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc40" value="&lt;b&gt;6 · Semantic expansion&lt;/b&gt;&lt;br&gt;embed(question + blamed code span + commit subjects) → hybrid&lt;br&gt;retrieval over decision-type docs; drop nodes the walk already&lt;br&gt;found; keep top-k as &lt;font face='Courier New'&gt;semantic_match&lt;/font&gt; (never-linked discussions)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="820" y="584" width="700" height="82" as="geometry"/></mxCell><mxCell id="7Reqe41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc38" target="7Reqc40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc42" value="&lt;b&gt;7 · Rank + Chains + Gaps&lt;/b&gt;&lt;br&gt;identical shared machinery; roles: &lt;font face='Courier New'&gt;blamed_commit&lt;/font&gt;,&lt;br&gt;&lt;font face='Courier New'&gt;review_thread&lt;/font&gt;, &lt;font face='Courier New'&gt;linked_ticket&lt;/font&gt;, &lt;font face='Courier New'&gt;design_doc&lt;/font&gt;, &lt;font face='Courier New'&gt;semantic_match&lt;/font&gt;&lt;br&gt;typical gap: 'commit a1b2c3 has no PR — direct push'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="820" y="680" width="700" height="82" as="geometry"/></mxCell><mxCell id="7Reqe43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc40" target="7Reqc42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc44" value="&lt;b&gt;8 · EvidenceBundle back to the AI&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Anchor.Kind = code_span&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Anchor.Code = {repo, file, 40–55, blamed SHAs}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="776" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc42" target="7Reqc44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc46" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• &lt;font face='Courier New'&gt;question&lt;/font&gt; is optional: blame + walk need only the line span. Absent ⇒&lt;br&gt;  defaults to 'why does &amp;lt;file&amp;gt;:&amp;lt;L1&amp;gt;-&amp;lt;L2&amp;gt; exist in its current form'.&lt;br&gt;• &lt;font face='Courier New'&gt;history_of(path)&lt;/font&gt; is the same shape with &lt;font face='Courier New'&gt;git log --follow&lt;/font&gt; as the seed&lt;br&gt;  (rename-aware), 1 hop per commit, chronological output, windowed by&lt;br&gt;  &lt;font face='Courier New'&gt;limit&lt;/font&gt; + &lt;font face='Courier New'&gt;before&lt;/font&gt;.&lt;br&gt;• GitHub enrichment is matched to the clone through &lt;font face='Courier New'&gt;repos[].remote&lt;/font&gt;; a clone&lt;br&gt;  with no matching source still blames, but chains stop at the commit layer&lt;br&gt;  (startup warning, not an error)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="820" y="866" width="700" height="150" as="geometry"/></mxCell><mxCell id="7Reqc47" value="C · Non-AI path · CLI / gRPC with synthesis" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1580" y="110" width="700" height="26" as="geometry"/></mxCell><mxCell id="7Reqc48" value="&lt;font face='Courier New'&gt;lore ask &quot;why B over A?&quot; --around &quot;incident X&quot; --explain&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1580" y="138" width="700" height="40" as="geometry"/></mxCell><mxCell id="7Reqc49" value="&lt;b&gt;1 · Human → CLI&lt;/b&gt;&lt;br&gt;client has NO brain ⇒ it wants prose with citations&lt;br&gt;&lt;font face='Courier New'&gt;lore ask&lt;/font&gt; maps to &lt;font face='Courier New'&gt;find_decision&lt;/font&gt; (Δ15)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1580" y="184" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqc50" value="&lt;b&gt;2 · CLI → QueryService&lt;/b&gt;&lt;br&gt;same request type, &lt;b&gt;synthesize=true&lt;/b&gt; — a toggle, not a fork (D2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1580" y="264" width="700" height="50" as="geometry"/></mxCell><mxCell id="7Reqe51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc49" target="7Reqc50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc52" value="&lt;b&gt;3 · Identical pipeline as flow A&lt;/b&gt;&lt;br&gt;resolve anchor → seed → walk → expand → rank → EvidenceBundle&lt;br&gt;not one line of the engine differs between AI and non-AI surfaces" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1580" y="328" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc50" target="7Reqc52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc54" value="&lt;b&gt;4 · SynthesisService.Synthesize(bundle, question)&lt;/b&gt;&lt;br&gt;system prompt: answer ONLY from the evidence, cite the node URL&lt;br&gt;for every claim, state gaps explicitly, respect timeline ordering" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1580" y="408" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc52" target="7Reqc54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc56" value="&lt;b&gt;5 · LLMConnector.Complete(system, user)&lt;/b&gt;&lt;br&gt;provider from &lt;font face='Courier New'&gt;llm:&lt;/font&gt; config — openai | anthropic | zai | ollama&lt;br&gt;missing config ⇒ clear error naming the remedy (MCP unaffected)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1580" y="488" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc54" target="7Reqc56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc58" value="&lt;b&gt;6 · Render&lt;/b&gt;&lt;br&gt;CLI: markdown prose + inline [n] citations + source list&lt;br&gt;&lt;font face='Courier New'&gt;--raw&lt;/font&gt; ⇒ the bundle instead (pretty tree, or JSON for scripting)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1580" y="568" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc56" target="7Reqc58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc60" value="&lt;b&gt;7 · gRPC variant&lt;/b&gt;&lt;br&gt;the response carries the raw bundle &lt;b&gt;and&lt;/b&gt; the optional synthesis:&lt;br&gt;the future web UI renders the provenance graph from Nodes + Chains&lt;br&gt;and the prose from synthesis — no core change needed (D5)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1580" y="648" width="700" height="82" as="geometry"/></mxCell><mxCell id="7Reqe61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc58" target="7Reqc60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc62" value="&lt;b&gt;Synthesize defaults per surface (D2)&lt;/b&gt;&lt;br&gt;MCP stdio / Streamable HTTP → &lt;font face='Courier New'&gt;false&lt;/font&gt; (the host model synthesizes; no override)&lt;br&gt;CLI → &lt;font face='Courier New'&gt;true&lt;/font&gt; for &lt;font face='Courier New'&gt;lore ask&lt;/font&gt; and &lt;font face='Courier New'&gt;--explain&lt;/font&gt;; raw pretty-print otherwise; &lt;font face='Courier New'&gt;--raw&lt;/font&gt; forces raw&lt;br&gt;gRPC → &lt;font face='Courier New'&gt;true&lt;/font&gt;; &lt;font face='Courier New'&gt;FindDecision{synthesize:false}&lt;/font&gt; for e.g. UI graph rendering&lt;br&gt;&lt;br&gt;Careful with the word 'HTTP': MCP-over-Streamable-HTTP is on the &lt;b&gt;AI&lt;/b&gt; side;&lt;br&gt;gRPC and the future web UI are on the &lt;b&gt;non-AI&lt;/b&gt; side." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1580" y="754" width="700" height="130" as="geometry"/></mxCell><mxCell id="7Reqc63" value="D · &lt;font face='Courier New'&gt;impact_of&lt;/font&gt; — consequences, forward in time (Δ5)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="2340" y="110" width="700" height="26" as="geometry"/></mxCell><mxCell id="7Reqc64" value="&lt;font face='Courier New'&gt;impact_of(&quot;PROJ-4521&quot;)&lt;/font&gt; or &lt;font face='Courier New'&gt;impact_of(&quot;the retry backoff decision&quot;)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="2340" y="138" width="700" height="40" as="geometry"/></mxCell><mxCell id="7Reqc65" value="&lt;b&gt;1 · Resolve the anchor&lt;/b&gt;&lt;br&gt;a ref → &lt;font face='Courier New'&gt;ResolveRef&lt;/font&gt; (ambiguous ⇒ error listing candidates);&lt;br&gt;free text → retrieval, top document, interpretation recorded in&lt;br&gt;&lt;font face='Courier New'&gt;Anchor.Doc&lt;/font&gt;. Anchor time &lt;b&gt;T = Doc.CreatedAt&lt;/b&gt; (event time)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2340" y="184" width="700" height="82" as="geometry"/></mxCell><mxCell id="7Reqc66" value="&lt;b&gt;2 · Forward walk&lt;/b&gt;&lt;br&gt;traverse edges from the anchor both ways &lt;i&gt;mechanically&lt;/i&gt;, keep only&lt;br&gt;nodes with &lt;font face='Courier New'&gt;CreatedAt &amp;gt; T&lt;/font&gt;; depth ≤ 3&lt;br&gt;dominated by &lt;b&gt;incoming&lt;/b&gt; &lt;font face='Courier New'&gt;references_doc&lt;/font&gt; / &lt;font face='Courier New'&gt;mentions_commit&lt;/font&gt; edges&lt;br&gt;(later documents citing the decision) and &lt;font face='Courier New'&gt;supersedes&lt;/font&gt; chains" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2340" y="280" width="700" height="98" as="geometry"/></mxCell><mxCell id="7Reqe67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc65" target="7Reqc66"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc68" value="&lt;b&gt;3 · Semantic expansion, hard time filter&lt;/b&gt;&lt;br&gt;retrieval of the question (default: 'consequences, follow-ups,&lt;br&gt;incidents related to &amp;lt;anchor title&amp;gt;') + anchor excerpt, filtered&lt;br&gt;&lt;font face='Courier New'&gt;created_at &amp;gt; T&lt;/font&gt;; drop already-found nodes → &lt;font face='Courier New'&gt;semantic_match&lt;/font&gt;&lt;br&gt;catches the postmortem that never linked back" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2340" y="392" width="700" height="98" as="geometry"/></mxCell><mxCell id="7Reqe69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc66" target="7Reqc68"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc70" value="&lt;b&gt;4 · Return chronologically&lt;/b&gt;&lt;br&gt;a timeline, not a relevance list&lt;br&gt;Chains = anchor → follow-up paths" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2340" y="504" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc68" target="7Reqc70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc72" value="&lt;b&gt;5 · Gaps as a real answer&lt;/b&gt;&lt;br&gt;'no follow-up evidence after 2025-03-12' — itself useful output,&lt;br&gt;and honest instead of invented" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="2340" y="584" width="700" height="66" as="geometry"/></mxCell><mxCell id="7Reqe73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7Reqc70" target="7Reqc72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7Reqc74" value="&lt;b&gt;Why no 'impact' edge kind exists&lt;/b&gt;&lt;br&gt;Impact = &lt;b&gt;direction + time&lt;/b&gt; over the edges that already exist. Incoming&lt;br&gt;references, filtered by &lt;font face='Courier New'&gt;CreatedAt &amp;gt; T&lt;/font&gt;, &lt;i&gt;are&lt;/i&gt; the consequences.&lt;br&gt;That is why &lt;font face='Courier New'&gt;Neighbors&lt;/font&gt; must take an explicit direction parameter (Δ12)&lt;br&gt;and why &lt;font face='Courier New'&gt;CreatedAt&lt;/font&gt; had to be added alongside &lt;font face='Courier New'&gt;UpdatedAt&lt;/font&gt; (Δ8).&lt;br&gt;&lt;br&gt;Open question (07 #3): whether &lt;font face='Courier New'&gt;impact_of&lt;/font&gt; should also accept an explicit&lt;br&gt;&lt;font face='Courier New'&gt;until&lt;/font&gt; for bounded windows ('what happened in the following quarter')." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2340" y="674" width="700" height="140" as="geometry"/></mxCell><mxCell id="7Reqc75" value="&lt;b&gt;Verb routing — spelled out in the MCP tool descriptions&lt;/b&gt;&lt;br&gt;&lt;b&gt;breadth&lt;/b&gt; → &lt;font face='Courier New'&gt;find_decision&lt;/font&gt; / &lt;font face='Courier New'&gt;why&lt;/font&gt;&lt;br&gt;&lt;b&gt;depth on one node&lt;/b&gt; → &lt;font face='Courier New'&gt;trace&lt;/font&gt;&lt;br&gt;&lt;b&gt;consequences&lt;/b&gt; → &lt;font face='Courier New'&gt;impact_of&lt;/font&gt;&lt;br&gt;&lt;b&gt;file evolution&lt;/b&gt; → &lt;font face='Courier New'&gt;history_of&lt;/font&gt;&lt;br&gt;Narrow verbs route better in LLM hosts than one modal tool with flags (Δ15)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="2340" y="834" width="700" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p8" name="8 · Interfaces &amp; Config"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2440" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7Intc1" value="INTERFACES &amp; CONFIG — five verbs over one bundle, four surfaces, one YAML with two independent axes" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="36" as="geometry"/></mxCell><mxCell id="7Intc2" value="docs/v3/06-interfaces-and-config.md. All MCP tools return structured EvidenceBundle JSON, never synthesized prose. Query tools carry readOnlyHint; only sync_now mutates local state — the index, never any source." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1700" height="40" as="geometry"/></mxCell><mxCell id="7Intc3" value="MCP TOOL SURFACE (stdio + Streamable HTTP · official Go MCP SDK)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="112" width="900" height="26" as="geometry"/></mxCell><mxCell id="7Intc4" value="Tool" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="60" y="146" width="170" height="26" as="geometry"/></mxCell><mxCell id="7Intc5" value="Input" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="230" y="146" width="400" height="26" as="geometry"/></mxCell><mxCell id="7Intc6" value="Returns" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="630" y="146" width="350" height="26" as="geometry"/></mxCell><mxCell id="7Intc7" value="&lt;font face='Courier New'&gt;find_decision&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="172" width="170" height="50" as="geometry"/></mxCell><mxCell id="7Intc8" value="&lt;font face='Courier New'&gt;question&lt;/font&gt;, optional &lt;font face='Courier New'&gt;around&lt;/font&gt; (event text or date), &lt;font face='Courier New'&gt;source&lt;/font&gt;, &lt;font face='Courier New'&gt;repo&lt;/font&gt;, &lt;font face='Courier New'&gt;doc_type&lt;/font&gt;, &lt;font face='Courier New'&gt;since&lt;/font&gt;, &lt;font face='Courier New'&gt;until&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="230" y="172" width="400" height="50" as="geometry"/></mxCell><mxCell id="7Intc9" value="EvidenceBundle seeded by retrieval; works with zero repos" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="630" y="172" width="350" height="50" as="geometry"/></mxCell><mxCell id="7Intc10" value="&lt;font face='Courier New'&gt;why&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="222" width="170" height="46" as="geometry"/></mxCell><mxCell id="7Intc11" value="&lt;font face='Courier New'&gt;repo&lt;/font&gt;, &lt;font face='Courier New'&gt;file&lt;/font&gt;, &lt;font face='Courier New'&gt;line_start&lt;/font&gt;, &lt;font face='Courier New'&gt;line_end&lt;/font&gt;, optional &lt;font face='Courier New'&gt;question&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="230" y="222" width="400" height="46" as="geometry"/></mxCell><mxCell id="7Intc12" value="EvidenceBundle anchored on blame; precondition error if no repos registered" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="630" y="222" width="350" height="46" as="geometry"/></mxCell><mxCell id="7Intc13" value="&lt;font face='Courier New'&gt;trace&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="268" width="170" height="46" as="geometry"/></mxCell><mxCell id="7Intc14" value="&lt;font face='Courier New'&gt;ref&lt;/font&gt; (SHA / PR# / ticket key / URL / DocID), optional &lt;font face='Courier New'&gt;direction&lt;/font&gt;, &lt;font face='Courier New'&gt;depth&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="230" y="268" width="400" height="46" as="geometry"/></mxCell><mxCell id="7Intc15" value="full provenance neighborhood + full body, chronological" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="630" y="268" width="350" height="46" as="geometry"/></mxCell><mxCell id="7Intc16" value="&lt;font face='Courier New'&gt;impact_of&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="314" width="170" height="34" as="geometry"/></mxCell><mxCell id="7Intc17" value="&lt;font face='Courier New'&gt;ref_or_query&lt;/font&gt;, optional &lt;font face='Courier New'&gt;question&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="230" y="314" width="400" height="34" as="geometry"/></mxCell><mxCell id="7Intc18" value="chronological impact timeline after the anchor decision" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="630" y="314" width="350" height="34" as="geometry"/></mxCell><mxCell id="7Intc19" value="&lt;font face='Courier New'&gt;history_of&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="348" width="170" height="46" as="geometry"/></mxCell><mxCell id="7Intc20" value="&lt;font face='Courier New'&gt;path&lt;/font&gt;, optional &lt;font face='Courier New'&gt;repo&lt;/font&gt;, &lt;font face='Courier New'&gt;limit&lt;/font&gt;, &lt;font face='Courier New'&gt;before&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="230" y="348" width="400" height="46" as="geometry"/></mxCell><mxCell id="7Intc21" value="chronological file timeline; precondition error if no repos registered" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="630" y="348" width="350" height="46" as="geometry"/></mxCell><mxCell id="7Intc22" value="&lt;font face='Courier New'&gt;sync_now&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="394" width="170" height="34" as="geometry"/></mxCell><mxCell id="7Intc23" value="optional &lt;font face='Courier New'&gt;source&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="230" y="394" width="400" height="34" as="geometry"/></mxCell><mxCell id="7Intc24" value="acknowledgment; errors if the sync lease is held" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="630" y="394" width="350" height="34" as="geometry"/></mxCell><mxCell id="7Intc25" value="&lt;font face='Courier New'&gt;sync_status&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="428" width="170" height="40" as="geometry"/></mxCell><mxCell id="7Intc26" value="—" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="230" y="428" width="400" height="40" as="geometry"/></mxCell><mxCell id="7Intc27" value="last run per connector, cursor ages, doc/edge counts, lock state" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="630" y="428" width="350" height="40" as="geometry"/></mxCell><mxCell id="7Intc28" value="&lt;b&gt;Tool-surface policy (D9 / Δ16)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;EvidenceBundle is the stable contract&lt;/b&gt;; tools are cheap, disposable verbs over it. Bundle changes are additive only.&lt;br&gt;• Descriptions spell out the division of labor so host models route well: breadth → &lt;font face='Courier New'&gt;find_decision&lt;/font&gt;/&lt;font face='Courier New'&gt;why&lt;/font&gt; · depth on one node → &lt;font face='Courier New'&gt;trace&lt;/font&gt; · consequences → &lt;font face='Courier New'&gt;impact_of&lt;/font&gt; · file evolution → &lt;font face='Courier New'&gt;history_of&lt;/font&gt;.&lt;br&gt;• &lt;b&gt;Deprecation happens in place&lt;/b&gt;: the old tool keeps its registration with a 'deprecated — use X' description for one release, then disappears. Host models follow the description automatically.&lt;br&gt;• Transports: &lt;font face='Courier New'&gt;lore mcp&lt;/font&gt; = stdio for local harnesses (Claude Code, Cursor, …) · &lt;font face='Courier New'&gt;lore serve&lt;/font&gt; = Streamable HTTP endpoint &lt;font face='Courier New'&gt;/mcp&lt;/font&gt; alongside gRPC." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="920" height="170" as="geometry"/></mxCell><mxCell id="7Intc29" value="CLI" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="400" height="26" as="geometry"/></mxCell><mxCell id="7Intc30" value="&lt;font face='Courier New'&gt;lore init                          # create workspace + lore.yaml scaffold&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore source add github|notion|jira # append source config interactively&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore sync [--source=jira] [--reembed]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore status                        # sync state, doc/edge counts, lock state&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore ask &quot;&amp;lt;question&amp;gt;&quot; [--around=&quot;incident X&quot;] [--since --until]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;                       [--source --repo --type]   # → find_decision&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore impact &amp;lt;ref | &quot;query&quot;&amp;gt; [--question=&quot;…&quot;]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore why &amp;lt;file&amp;gt;:&amp;lt;L1&amp;gt;-&amp;lt;L2&amp;gt; [&quot;question&quot;] [--repo=…]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore trace &amp;lt;ref&amp;gt; [--direction=in|out|both]&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore history &amp;lt;path&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore mcp                           # MCP stdio server&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;lore serve [--http=:8080] [--grpc=:9090] [--mtls]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="722" width="920" height="190" as="geometry"/></mxCell><mxCell id="7Intc31" value="&lt;b&gt;Human-facing defaults&lt;/b&gt;&lt;br&gt;• &lt;font face='Courier New'&gt;why&lt;/font&gt; / &lt;font face='Courier New'&gt;trace&lt;/font&gt; / &lt;font face='Courier New'&gt;impact&lt;/font&gt; / &lt;font face='Courier New'&gt;history&lt;/font&gt; pretty-print the evidence chain — tree or timeline, with URLs.&lt;br&gt;• &lt;font face='Courier New'&gt;lore ask&lt;/font&gt; and &lt;font face='Courier New'&gt;--explain&lt;/font&gt; invoke SynthesisService (requires &lt;font face='Courier New'&gt;llm:&lt;/font&gt; config). Until synthesis ships — and always with &lt;font face='Courier New'&gt;--raw&lt;/font&gt; — they emit the bundle, pretty-printed or as JSON for scripting." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="930" width="920" height="100" as="geometry"/></mxCell><mxCell id="7Intc32" value="gRPC — programmatic API &lt;font face='Courier New'&gt;lore.v1&lt;/font&gt; (NOT an MCP transport · D5)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1020" y="112" width="700" height="26" as="geometry"/></mxCell><mxCell id="7Intc33" value="&lt;font face='Courier New'&gt;service QueryService {&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  rpc FindDecision(FindDecisionRequest) returns (FindDecisionResponse);&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  rpc Why(WhyRequest)               returns (WhyResponse);&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  rpc Trace(TraceRequest)           returns (TraceResponse);&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  rpc ImpactOf(ImpactOfRequest)     returns (ImpactOfResponse);&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  rpc HistoryOf(HistoryOfRequest)   returns (HistoryOfResponse);&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;service SyncService {&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  rpc Trigger(TriggerRequest) returns (TriggerResponse); // errors if lock held&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  rpc Status(StatusRequest)   returns (StatusResponse);&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  rpc Watch(WatchRequest)     returns (stream SyncEvent); // live per-connector&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;}                                                       // phase, counts, errors&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1020" y="146" width="700" height="200" as="geometry"/></mxCell><mxCell id="7Intc34" value="&lt;b&gt;Surface semantics&lt;/b&gt;&lt;br&gt;• every query request carries &lt;font face='Courier New'&gt;bool synthesize&lt;/font&gt; (default &lt;b&gt;true&lt;/b&gt; here)&lt;br&gt;• responses carry the raw &lt;b&gt;EvidenceBundle&lt;/b&gt; and optional &lt;b&gt;synthesis&lt;/b&gt; text — the web UI renders the provenance graph from the bundle and prose from the synthesis&lt;br&gt;• &lt;font face='Courier New'&gt;SyncService.Watch&lt;/font&gt; streams progress — the UI progress view depends on it" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1020" y="360" width="700" height="120" as="geometry"/></mxCell><mxCell id="7Intc35" value="&lt;b&gt;mTLS&lt;/b&gt;&lt;br&gt;• &lt;font face='Courier New'&gt;lore serve --mtls&lt;/font&gt;: TLS listener with &lt;b&gt;required client-certificate verification&lt;/b&gt; against a configured client CA (&lt;font face='Courier New'&gt;tls.RequireAndVerifyClientCert&lt;/font&gt;)&lt;br&gt;• config: server cert/key + client CA bundle paths in lore.yaml; &lt;font face='Courier New'&gt;make certs.dev&lt;/font&gt; generates a local CA + server/client certs for development&lt;br&gt;• &lt;b&gt;plain-TCP gRPC is allowed only on loopback&lt;/b&gt;; non-loopback binds without TLS are rejected at startup" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1020" y="496" width="700" height="150" as="geometry"/></mxCell><mxCell id="7Intc36" value="&lt;b&gt;Web UI (later — designed for, not built)&lt;/b&gt;&lt;br&gt;Consumes gRPC via grpc-web or a gateway. Planned views:&lt;br&gt;• provenance-graph explorer — renders &lt;font face='Courier New'&gt;Nodes&lt;/font&gt; + &lt;font face='Courier New'&gt;Chains&lt;/font&gt; directly from the bundle&lt;br&gt;• ask panel — synthesized answers + impact timelines&lt;br&gt;• sync dashboard — the &lt;font face='Courier New'&gt;Watch&lt;/font&gt; stream&lt;br&gt;No core changes required: this is exactly why the bundle/synthesis split exists on the gRPC surface." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1020" y="662" width="700" height="150" as="geometry"/></mxCell><mxCell id="7Intc37" value="&lt;b&gt;Security posture (06)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;read-only&lt;/b&gt; against all external sources; least-privilege tokens documented per source: GitHub fine-grained PAT read scopes · Notion integration scoped to a subtree · Jira API token with read-only project access&lt;br&gt;• secrets only via env vars — never written to lore.yaml, the index, or logs&lt;br&gt;• private data leaves the machine only toward the configured embedder/LLM — documented loudly; Ollama for both = fully local pipeline&lt;br&gt;• gRPC/HTTP off-loopback requires TLS; gRPC additionally supports mTLS" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1020" y="828" width="700" height="200" as="geometry"/></mxCell><mxCell id="7Intc38" value="&lt;font face='Courier New'&gt;lore.yaml&lt;/font&gt; — annotated reference (two independent axes, Δ9)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1760" y="112" width="640" height="26" as="geometry"/></mxCell><mxCell id="7Intc39" value="&lt;font face='Courier New'&gt;workspace: myproject&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;index_path: ~/.lore/myproject.db   # default ~/.lore/&amp;lt;workspace&amp;gt;.db&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;sources:               # ALL optional — configure what exists&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  github:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    token_env: LORE_GITHUB_TOKEN   # env var NAME; value never stored&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    repos:                         # what to INGEST (no clone needed)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;      - acme/myproject&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;      - acme/myproject-infra&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  notion:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    token_env: LORE_NOTION_TOKEN&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    root_pages:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;      - &quot;Engineering Wiki&quot;         # subtree scoping&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  jira:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    base_url: https://acme.atlassian.net&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    email_env: LORE_JIRA_EMAIL&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    token_env: LORE_JIRA_TOKEN&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    projects: [PROJ, INFRA]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;repos: []              # OPTIONAL — local clones, blame/log only.&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;# repos:                # Zero repos = ask-only workspace;&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;#   - path: ~/dev/myproject      # why/history_of disabled, all&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;#     remote: github:acme/myproject # other tools fully functional.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;query:                 # optional tuning (server-capped)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  event_window: 30d    # ± window for event resolution&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  walk_depth: 3&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  top_k: 12&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;embedder:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  provider: openai     # openai | ollama&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  model: text-embedding-3-small&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;llm:                   # OPTIONAL — synthesis for CLI/gRPC only&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  provider: anthropic  # openai | anthropic | zai | ollama&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  model: claude-sonnet-4-5&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  api_key_env: LORE_LLM_KEY&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;scheduler:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  interval: 30m&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;server:                # used by `lore serve`&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  http_addr: &quot;:8080&quot;   # MCP Streamable HTTP&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  grpc_addr: &quot;:9090&quot;&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;  mtls:&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    cert: ./certs/server.pem&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    key: ./certs/server-key.pem&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;    client_ca: ./certs/ca.pem&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1760" y="146" width="640" height="660" as="geometry"/></mxCell><mxCell id="7Intc40" value="&lt;b&gt;Validation at load&lt;/b&gt;&lt;br&gt;• unknown keys &lt;b&gt;rejected&lt;/b&gt; (no silent typos)&lt;br&gt;• at least one of &lt;font face='Courier New'&gt;sources&lt;/font&gt; / &lt;font face='Courier New'&gt;repos&lt;/font&gt; non-empty&lt;br&gt;• &lt;font face='Courier New'&gt;token_env&lt;/font&gt; / &lt;font face='Courier New'&gt;email_env&lt;/font&gt; variables must exist when their source is configured&lt;br&gt;• &lt;font face='Courier New'&gt;repos[].remote&lt;/font&gt; must name a configured source repo when enrichment mapping is intended; a clone without a matching source still blames, but chains stop at the commit layer — surfaced as a startup &lt;b&gt;warning&lt;/b&gt;, not an error&lt;br&gt;• loopback/TLS rule enforced at startup&lt;br&gt;• embedder identity checked against the index &lt;font face='Courier New'&gt;meta&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1760" y="822" width="640" height="206" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="lore-v3-p9" name="9 · Design Deltas (v1 → v3)"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="1320" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="10Dec1" value="DESIGN DELTAS — v1 → v3, with rationale" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="10Dec2" value="docs/v3/00-design-deltas.md. Driving requirement: v1 framed Lore as a &lt;i&gt;codebase&lt;/i&gt; provenance engine — the rich pipeline (graph walk, chains, gaps) existed only behind &lt;font face='Courier New'&gt;git blame&lt;/font&gt;. The product goal is broader: answer decision questions from Jira/Notion alone, with zero repositories configured. Code anchoring stays, as one anchor type among several. (v2 was abandoned research and contributed nothing.)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1900" height="40" as="geometry"/></mxCell><mxCell id="10Dec3" value="#" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="50" height="30" as="geometry"/></mxCell><mxCell id="10Dec4" value="Change" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="110" y="120" width="250" height="30" as="geometry"/></mxCell><mxCell id="10Dec5" value="Was (v1)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="470" height="30" as="geometry"/></mxCell><mxCell id="10Dec6" value="Now (v3)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="830" y="120" width="570" height="30" as="geometry"/></mxCell><mxCell id="10Dec7" value="Rationale" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;spacingLeft=6;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1400" y="120" width="560" height="30" as="geometry"/></mxCell><mxCell id="10Dec8" value="Δ1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="50" height="46" as="geometry"/></mxCell><mxCell id="10Dec9" value="product framing" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="150" width="250" height="46" as="geometry"/></mxCell><mxCell id="10Dec10" value="'provenance engine for codebases; answers why &lt;i&gt;code&lt;/i&gt; exists'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="470" height="46" as="geometry"/></mxCell><mxCell id="10Dec11" value="decision-provenance engine; anchors = query, code span, document, time window" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="150" width="570" height="46" as="geometry"/></mxCell><mxCell id="10Dec12" value="framing drove design; every rich feature hung off &lt;font face='Courier New'&gt;git blame&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="150" width="560" height="46" as="geometry"/></mxCell><mxCell id="10Dec13" value="Δ2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="196" width="50" height="74" as="geometry"/></mxCell><mxCell id="10Dec14" value="zero-repo workspaces" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="196" width="250" height="74" as="geometry"/></mxCell><mxCell id="10Dec15" value="&lt;font face='Courier New'&gt;repos:&lt;/font&gt; implicitly required; &lt;font face='Courier New'&gt;why&lt;/font&gt; validation assumed a registered repo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="196" width="470" height="74" as="geometry"/></mxCell><mxCell id="10Dec16" value="&lt;font face='Courier New'&gt;repos:&lt;/font&gt; explicitly optional; workspace valid with none; &lt;font face='Courier New'&gt;why&lt;/font&gt;/&lt;font face='Courier New'&gt;history_of&lt;/font&gt; fail with a clear 'code anchoring disabled' error; all other tools unaffected" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="196" width="570" height="74" as="geometry"/></mxCell><mxCell id="10Dec17" value="ask-only (Jira/Notion) is a primary configuration" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="196" width="560" height="74" as="geometry"/></mxCell><mxCell id="10Dec18" value="Δ3" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="50" height="66" as="geometry"/></mxCell><mxCell id="10Dec19" value="pipeline asymmetry" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="270" width="250" height="66" as="geometry"/></mxCell><mxCell id="10Dec20" value="&lt;font face='Courier New'&gt;why&lt;/font&gt; got walk + chains + gaps; &lt;font face='Courier New'&gt;find_decision&lt;/font&gt; got retrieval + 1 hop, no chains, unspecified 'clustering'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="270" width="470" height="66" as="geometry"/></mxCell><mxCell id="10Dec21" value="one engine, four seed modes (retrieval / blame / ref / log); &lt;b&gt;every&lt;/b&gt; tool returns Chains + Gaps; clustering deleted" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="270" width="570" height="66" as="geometry"/></mxCell><mxCell id="10Dec22" value="the ask path — the primary path — received the weakest machinery" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="270" width="560" height="66" as="geometry"/></mxCell><mxCell id="10Dec23" value="Δ4" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="336" width="50" height="74" as="geometry"/></mxCell><mxCell id="10Dec24" value="event / time anchoring" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="336" width="250" height="74" as="geometry"/></mxCell><mxCell id="10Dec25" value="none; the agent had to guess dates" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="336" width="470" height="74" as="geometry"/></mxCell><mxCell id="10Dec26" value="&lt;font face='Courier New'&gt;find_decision&lt;/font&gt; takes &lt;font face='Courier New'&gt;around&lt;/font&gt; (free text or date) → event resolution → time window; ranking uses proximity-to-anchor instead of recency when anchored" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="336" width="570" height="74" as="geometry"/></mxCell><mxCell id="10Dec27" value="'when incident X happened' is unanswerable without it" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="336" width="560" height="74" as="geometry"/></mxCell><mxCell id="10Dec28" value="Δ5" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="50" height="74" as="geometry"/></mxCell><mxCell id="10Dec29" value="impact queries" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="410" width=