onnector (Cloud: new &lt;font face='Courier New'&gt;/search/jql&lt;/font&gt; endpoint, &lt;font face='Courier New'&gt;updated&lt;/font&gt; watermark, ADF→text)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="484" width="570" height="56" as="geometry"/></mxCell><mxCell id="10Dec37" value="the ask-only scenario names Jira explicitly; ticket-key linking is the classic provenance case" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="484" width="560" height="56" as="geometry"/></mxCell><mxCell id="10Dec38" value="Δ7" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="50" height="40" as="geometry"/></mxCell><mxCell id="10Dec39" value="&lt;font face='Courier New'&gt;Anchor&lt;/font&gt; shape" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="540" width="250" height="40" as="geometry"/></mxCell><mxCell id="10Dec40" value="code-only (repo, file, lines, SHAs)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="540" width="470" height="40" as="geometry"/></mxCell><mxCell id="10Dec41" value="union: query / code span / document / time window" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="540" width="570" height="40" as="geometry"/></mxCell><mxCell id="10Dec42" value="generalizing later would break the bundle contract on every surface" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="540" width="560" height="40" as="geometry"/></mxCell><mxCell id="10Dec43" value="Δ8" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="50" height="66" as="geometry"/></mxCell><mxCell id="10Dec44" value="&lt;font face='Courier New'&gt;Document.CreatedAt&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="580" width="250" height="66" as="geometry"/></mxCell><mxCell id="10Dec45" value="only &lt;font face='Courier New'&gt;UpdatedAt&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="580" width="470" height="66" as="geometry"/></mxCell><mxCell id="10Dec46" value="both timestamps" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="580" width="570" height="66" as="geometry"/></mxCell><mxCell id="10Dec47" value="event time ≠ last-edit time. A postmortem edited yesterday still belongs to last year's incident. Timelines, event resolution, impact filtering all key on CreatedAt" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="580" width="560" height="66" as="geometry"/></mxCell><mxCell id="10Dec48" value="Δ9" style="rounded=0;whiteSpace=wrap;html=1;al