ry"/></mxCell><mxCell id="10Dec54" value="&lt;font face='Courier New'&gt;Connector.Changes&lt;/font&gt; signature" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="712" width="250" height="74" as="geometry"/></mxCell><mxCell id="10Dec55" value="returned the final &lt;font face='Courier New'&gt;Cursor&lt;/font&gt; &lt;i&gt;before&lt;/i&gt; the stream was consumed — contradicted 'checkpoint every batch'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="712" width="470" height="74" as="geometry"/></mxCell><mxCell id="10Dec56" value="streams &lt;font face='Courier New'&gt;Batch{Docs, Cursor}&lt;/font&gt;; the orchestrator commits the batch, then persists its cursor" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="712" width="570" height="74" as="geometry"/></mxCell><mxCell id="10Dec57" value="the v1 signature made the documented crash-safe resume unimplementable" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="712" width="560" height="74" as="geometry"/></mxCell><mxCell id="10Dec58" value="Δ11" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="786" width="50" height="46" as="geometry"/></mxCell><mxCell id="10Dec59" value="&lt;font face='Courier New'&gt;authored_follow_up&lt;/font&gt; edge" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="786" width="250" height="46" as="geometry"/></mxCell><mxCell id="10Dec60" value="declared in &lt;font face='Courier New'&gt;EdgeKind&lt;/font&gt;, produced by nothing" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="786" width="470" height="46" as="geometry"/></mxCell><mxCell id="10Dec61" value="deleted; &lt;font face='Courier New'&gt;supersedes&lt;/font&gt; added (ADR 'supersedes' text pattern)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="786" width="570" height="46" as="geometry"/></mxCell><mxCell id="10Dec62" value="orphan removed; supersession is real signal for 'B instead of A' questions" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="786" width="560" height="46" as="geometry"/></mxCell><mxCell id="10Dec63" value="Δ12" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="832" width="50" height="46" as="geometry"/></mxCell><mxCell id="10Dec64" value="&lt;font face='Courier New'&gt;Neighbors&lt;/font&gt; direction" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="832" width="250" height="46" as="geometry"/></mxCell><mxCell id="10Dec65" value="unspecified (trace claimed 'both directions')" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="832" width="470" height="46" as="geometry"/></mxCell><mxCell id="10Dec66" value="explicit &lt;font face='Courier New'&gt;dir&lt;/font&gt; parameter (out / in / both) in the store contract" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="832" width="570" height="46" as="geometry"/></mxCell><mxCell id="10Dec67" value="impact walking requires incoming-edge traversal; contracts must say so" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="832" width="560" height="46" as="geometry"/></mxCell><mxCell id="10Dec68" value="Δ13" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="878" width="50" height="84" as="geometry"/></mxCell><mxCell id="10Dec69" value="SQLite build" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="878" width="250" height="84" as="geometry"/></mxCell><mxCell id="10Dec70" value="cgo (mattn) assumed; 'pure-Go fallback if pain appears'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="878" width="470" height="84" as="geometry"/></mxCell><mxCell id="10Dec71" value="default &lt;b&gt;ncruces/go-sqlite3 WASM&lt;/b&gt; bindings (pure Go, sqlite-vec embedded); cgo variant kept as a benchmark alternative behind the same interface" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="878" width="570" height="84" as="geometry"/></mxCell><mxCell id="10Dec72" value="official WASM bindings exist; removes the cross-compile risk instead of mitigating it" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="878" width="560" height="84" as="geometry"/></mxCell><mxCell id="10Dec73" value="Δ14" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="962" width="50" height="46" as="geometry"/></mxCell><mxCell id="10Dec74" value="milestone order" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="962" width="250" height="46" as="geometry"/></mxCell><mxCell id="10Dec75" value="blame-provenance at M2; Notion at M3; Jira absent" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="962" width="470" height="46" as="geometry"/></mxCell><mxCell id="10Dec76" value="ask-first: retrieval core → provenance engine → Notion + Jira → code anchoring" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="962" width="570" height="46" as="geometry"/></mxCell><mxCell id="10Dec77" value="ship the assistant before the code explorer; matches stated priority" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="962" width="560" height="46" as="geometry"/></mxCell><mxCell id="10Dec78" value="Δ15" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1008" width="50" height="84" as="geometry"/></mxCell><mxCell id="10Dec79" value="tool surface" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="1008" width="250" height="84" as="geometry"/></mxCell><mxCell id="10Dec80" value="&lt;font face='Courier New'&gt;find_decision&lt;/font&gt; returned flat clusters; no impact verb" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1008" width="470" height="84" as="geometry"/></mxCell><mxCell id="10Dec81" value="&lt;font face='Courier New'&gt;find_decision&lt;/font&gt; upgraded to the full engine; &lt;font face='Courier New'&gt;impact_of&lt;/font&gt; added as a narrow fifth verb; CLI &lt;font face='Courier New'&gt;lore ask&lt;/font&gt; still maps to &lt;font face='Courier New'&gt;find_decision&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="1008" width="570" height="84" as="geometry"/></mxCell><mxCell id="10Dec82" value="verb honesty: MCP returns evidence, not answers — a rename to &lt;font face='Courier New'&gt;ask&lt;/font&gt; was considered and rejected as overselling. Narrow verbs route better in LLM hosts than modal params" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="1008" width="560" height="84" as="geometry"/></mxCell><mxCell id="10Dec83" value="Δ16" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1092" width="50" height="56" as="geometry"/></mxCell><mxCell id="10Dec84" value="contract stability" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="1092" width="250" height="56" as="geometry"/></mxCell><mxCell id="10Dec85" value="implicit" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1092" width="470" height="56" as="geometry"/></mxCell><mxCell id="10Dec86" value="&lt;font face='Courier New'&gt;EvidenceBundle&lt;/font&gt; = the stable, additively-evolving contract; tools = disposable verbs with in-place MCP deprecation" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="1092" width="570" height="56" as="geometry"/></mxCell><mxCell id="10Dec87" value="changing param semantics silently breaks agent prompts; adding/retiring tools is cheap" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#fbfbfb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="1092" width="560" height="56" as="geometry"/></mxCell><mxCell id="10Dec88" value="Δ17" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="1148" width="50" height="66" as="geometry"/></mxCell><mxCell id="10Dec89" value="plugin readiness" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="110" y="1148" width="250" height="66" as="geometry"/></mxCell><mxCell id="10Dec90" value="not considered" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="360" y="1148" width="470" height="66" as="geometry"/></mxCell><mxCell id="10Dec91" value="connector seam kept plugin-viable by three disciplines (entities-only imports, additive schemas, conformance suite); plugin transport deferred" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="830" y="1148" width="570" height="66" as="geometry"/></mxCell><mxCell id="10Dec92" value="Δ10 is the cautionary tale: freezing a wire protocol before the contract stops moving turns fixes into ecosystem breaks" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;spacingLeft=6;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1400" y="1148" width="560" height="66" as="geometry"/></mxCell><mxCell id="10Dec93" value="&lt;b&gt;Unchanged deliberately&lt;/b&gt;&lt;br&gt;• layering, FX wiring, error-handling policy, testing-strategy shape&lt;br&gt;• D1: MCP returns evidence, not prose; zero LLM key server-side&lt;br&gt;• synthesis as an optional final step for non-AI surfaces&lt;br&gt;• single SQLite file per workspace; RRF fusion in Go; store portability rules&lt;br&gt;• lease-lock sync (heartbeat + TTL takeover); read-only connectors; env-only secrets&lt;br&gt;• the &lt;font face='Courier New'&gt;Gaps&lt;/font&gt; honesty invariant — &lt;b&gt;extended&lt;/b&gt; to every tool rather than weakened" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1960" y="120" width="340" height="240" as="geometry"/></mxCell><mxCell id="10Dec94" value="&lt;b&gt;How to read this page&lt;/b&gt;&lt;br&gt;Each delta is a design decision with a paper trail. If code and these documents disagree, one of them is wrong — fix it through the same branch → PR workflow, never let them drift silently." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1960" y="380" width="340" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
